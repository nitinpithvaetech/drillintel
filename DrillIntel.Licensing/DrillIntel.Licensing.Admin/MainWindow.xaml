<Window x:Class="DrillIntel.Licensing.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DrillIntel License Admin"
        Width="1420" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">
    <Window.Resources>
        <ContextMenu x:Key="LicenseRowContextMenu">
            <MenuItem Header="📋  Copy License ID" FontWeight="Bold" InputGestureText="Ctrl+C" Click="CopyLicenseIdFromContextMenu_Click" />
            <MenuItem Header="Copy Entire Row" Click="CopyFullRowFromContextMenu_Click" />
        </ContextMenu>
        <Style x:Key="SelectOnRightClickRowStyle" TargetType="DataGridRow">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown" />
        </Style>
        <Style x:Key="RequestHistoryRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SelectOnRightClickRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="rejected">
                    <Setter Property="Background" Value="#FEE2E2" />
                    <Setter Property="Foreground" Value="#991B1B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="duplicate">
                    <Setter Property="Background" Value="#FEF3C7" />
                    <Setter Property="Foreground" Value="#92400E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="issued">
                    <Setter Property="Background" Value="#DCFCE7" />
                    <Setter Property="Foreground" Value="#166534" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BFDBFE" />
                    <Setter Property="Foreground" Value="#1E3A8A" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridFilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="ToolTip" Value="Type to filter rows. Clear the text to show all rows." />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="DRILLINTEL · LICENSING" FontSize="12" FontWeight="Bold" Foreground="#1976D2" />
                    <TextBlock Text="Customer &amp; License Register" FontSize="25" FontWeight="SemiBold" Foreground="#172033" Margin="0,4,0,0" />
                    <TextBlock Text="Office administration · signed files remain separate from the register" Foreground="#64748B" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Help" Click="Help_Click" />
                    <Button Content="Open / Change Register" Click="ChangeRegister_Click" />
                    <Button Content="Refresh" Click="Refresh_Click" />
                    <Button Content="＋  Add Customer" Background="#1976D2" Foreground="White" FontWeight="SemiBold" Click="AddCustomer_Click" />
                    <Button Content="Import .jws Request" Click="ImportRequest_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E8F2FD" CornerRadius="8" Padding="12,10" Margin="0,0,10,0">
                <TextBlock Text="Register records are administrative. A license unlocks a PC only after signed entitlement and activation files are issued." TextWrapping="Wrap" Foreground="#1E4F82" />
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="＋  Add Rig" Click="AddRig_Click" />
                <Button Content="＋  Add License" Click="AddLicense_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Customers" FontSize="18" FontWeight="SemiBold" Foreground="#172033" />
                        <TextBlock x:Name="CustomerCountText" Text="Loading register…" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="CustomersGrid" TextChanged="GridFilter_TextChanged" ToolTip="Filter customers by name, contact, rig count, or license count" />
                    <DataGrid x:Name="CustomersGrid" SelectionChanged="CustomersGrid_SelectionChanged" SelectionMode="Single" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Rigs" Binding="{Binding RigCount}" Width="52" />
                            <DataGridTextColumn Header="Licenses" Binding="{Binding LicenseCount}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedCustomerName" Text="Select a customer" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
                                <TextBlock x:Name="SelectedCustomerContact" Text="Customer contact details appear here" Foreground="#64748B" Margin="0,3,0,0" />
                                <TextBlock x:Name="SelectedCustomerNotes" Foreground="#475569" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#EAF2FF" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="RIGS" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="RigCountValue" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1976D2" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F3E8FF" CornerRadius="8" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="LICENSES" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="LicenseCountValue" Text="0" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TabControl x:Name="DetailsTabs" Grid.Row="1">
                        <TabItem Header="Rigs">
                            <DockPanel LastChildFill="True">
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="RigsGrid" TextChanged="GridFilter_TextChanged" />
                                <DataGrid x:Name="RigsGrid" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Licenses">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6" Margin="0,0,0,6">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="License Records" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="4,0,12,0" />
                                            <Button x:Name="CopyLicenseIdButton" Content="📋  Copy License ID" Click="CopySelectedLicenseId_Click" IsEnabled="False"
                                                    ToolTip="Copy the selected row's License ID to the clipboard (Ctrl+C)" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Tip: Press Ctrl+C or right-click to copy License ID" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </DockPanel>
                                </Border>
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="LicensesGrid" TextChanged="GridFilter_TextChanged" />
                                <DataGrid x:Name="LicensesGrid" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                          SelectionChanged="LicensesGrid_SelectionChanged"
                                          PreviewKeyDown="LicensesGrid_PreviewKeyDown" MouseDoubleClick="LicensesGrid_MouseDoubleClick"
                                          ContextMenu="{StaticResource LicenseRowContextMenu}"
                                          RowStyle="{StaticResource SelectOnRightClickRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="License ID" Width="280">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DockPanel LastChildFill="True" Margin="4,2">
                                                        <Button DockPanel.Dock="Right" Content="Copy" Padding="8,2" MinHeight="22" FontSize="11"
                                                                Margin="6,0,2,0" Cursor="Hand" Background="#E2E8F0" Foreground="#334155"
                                                                ToolTip="Copy License ID to clipboard"
                                                                Click="RowCopyLicenseId_Click" Tag="{Binding LicenseId}" />
                                                        <TextBlock Text="{Binding LicenseId}" FontFamily="Consolas" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Rig" Binding="{Binding RigName}" Width="150" />
                                        <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="90" />
                                        <DataGridTemplateColumn Header="Status" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F1F5F9" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="active">
                                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="suspended">
                                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="expired">
                                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#475569" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="active">
                                                                            <Setter Property="Foreground" Value="#166534" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="suspended">
                                                                            <Setter Property="Foreground" Value="#92400E" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="expired">
                                                                            <Setter Property="Foreground" Value="#991B1B" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Max Devices" Binding="{Binding MaxDevices}" Width="90" />
                                        <DataGridTextColumn Header="Start (UTC)" Binding="{Binding StartUtc}" Width="160" />
                                        <DataGridTextColumn Header="Expiry (UTC)" Binding="{Binding ExpiryUtc}" Width="160" />
                                        <DataGridTextColumn Header="Revision" Binding="{Binding CurrentRevision}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Devices">
                            <DockPanel LastChildFill="True">
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="DevicesGrid" TextChanged="GridFilter_TextChanged" />
                                <DataGrid x:Name="DevicesGrid" PreviewKeyDown="GenericGrid_PreviewKeyDown" ContextMenu="{StaticResource LicenseRowContextMenu}" RowStyle="{StaticResource SelectOnRightClickRowStyle}" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Entitlement Revisions">
                            <DockPanel LastChildFill="True">
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="RevisionsGrid" TextChanged="GridFilter_TextChanged" />
                                <DataGrid x:Name="RevisionsGrid" PreviewKeyDown="GenericGrid_PreviewKeyDown" ContextMenu="{StaticResource LicenseRowContextMenu}" RowStyle="{StaticResource SelectOnRightClickRowStyle}" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Activation Files">
                            <DockPanel LastChildFill="True">
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="ActivationFilesGrid" TextChanged="GridFilter_TextChanged" />
                                <DataGrid x:Name="ActivationFilesGrid" PreviewKeyDown="GenericGrid_PreviewKeyDown" ContextMenu="{StaticResource LicenseRowContextMenu}" RowStyle="{StaticResource SelectOnRightClickRowStyle}" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Requests">
                            <DockPanel LastChildFill="True">
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="RequestsGrid" TextChanged="GridFilter_TextChanged" />
                                <DataGrid x:Name="RequestsGrid" PreviewKeyDown="GenericGrid_PreviewKeyDown" ContextMenu="{StaticResource LicenseRowContextMenu}" RowStyle="{StaticResource RequestHistoryRowStyle}" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Request Inbox">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="Select a pending request to issue a PC activation." VerticalAlignment="Center" Foreground="#64748B" Margin="4,0,12,0" />
                                    <Button Content="Set Up Production Key" Click="SetupProductionKey_Click" />
                                    <Button Content="Issue Activation Package" Click="IssueActivationPackage_Click" />
                                    <Button Content="Reject / Archive Request" Click="RejectActivationRequest_Click" />
                                    <Button x:Name="IssueDevTestBundleButton" Content="Issue Dev Test Bundle" Click="IssueDevelopmentBundle_Click" />
                                </StackPanel>
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="RequestInboxGrid" TextChanged="GridFilter_TextChanged" />
                                <DataGrid x:Name="RequestInboxGrid" PreviewKeyDown="GenericGrid_PreviewKeyDown" ContextMenu="{StaticResource LicenseRowContextMenu}" RowStyle="{StaticResource SelectOnRightClickRowStyle}" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Payments">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                    <Button Content="＋  Record Payment" Click="RecordPayment_Click" />
                                </StackPanel>
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="PaymentsGrid" TextChanged="GridFilter_TextChanged" />
                                <DataGrid x:Name="PaymentsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order / Transaction Ref" Binding="{Binding OrderRef}" Width="*" />
                                        <DataGridTextColumn Header="License ID" Binding="{Binding LicenseId}" Width="230" />
                                        <DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" Width="110" />
                                        <DataGridTextColumn Header="Processor / Method" Binding="{Binding Processor}" Width="150" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                        <DataGridTextColumn Header="Paid (UTC)" Binding="{Binding PaidAtUtc}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Audit Log">
                            <DockPanel LastChildFill="True">
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource GridFilterTextBoxStyle}" Tag="AuditGrid" TextChanged="GridFilter_TextChanged" />
                                <DataGrid x:Name="AuditGrid" PreviewKeyDown="GenericGrid_PreviewKeyDown" ContextMenu="{StaticResource LicenseRowContextMenu}" RowStyle="{StaticResource SelectOnRightClickRowStyle}" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="4,10,4,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Text="Ready" Foreground="#475569" />
            <TextBlock x:Name="RegisterPathText" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" Foreground="#64748B" />
        </DockPanel>
    </Grid>
</Window>
