<Window x:Class="DrillIntel.Views.Broomstick.BroomstickProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:DrillIntel.Views.Broomstick"
        mc:Ignorable="d"
        Title="{Binding Title, FallbackValue='Broomstick Profile Editor'}" 
        Height="840" Width="1120"
        MinHeight="650" MinWidth="900"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <local:BroomstickProfileEditorView />
    </Grid>
</Window>

