<Window x:Class="DrillIntel.Views.Broomstick.BroomstickPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Template"
        Width="440" Height="210"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Border Padding="20,16" Background="#FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dialog Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <materialDesign:PackIcon Kind="ChartScatterPlot" Width="18" Height="18" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="TitleText" Text="Template Name" FontSize="14" FontWeight="Bold" Foreground="#1E1B4B" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Instructions -->
            <TextBlock x:Name="MessageText" Grid.Row="1" Text="Enter template name:" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,10" />

            <!-- Input Box -->
            <TextBox x:Name="InputBox" Grid.Row="2" Height="32" FontSize="12" Foreground="#0F172A" Background="#F8FAFC" 
                     BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center" Margin="0,0,0,16" />

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="14,0" Margin="0,0,8,0" Click="OnCancelClick" />
                <Button Content="OK" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4F46E5" Foreground="White" Height="30" Padding="18,0" Click="OnOkClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

