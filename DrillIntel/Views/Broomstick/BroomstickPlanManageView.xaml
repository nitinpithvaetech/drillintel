<UserControl x:Class="DrillIntel.Views.Broomstick.BroomstickPlanManageView"
             x:Name="ManageViewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:BroomstickPlanManageViewModel}"
             d:DesignHeight="850" d:DesignWidth="1400"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:IntToBooleanConverter x:Key="IntToBooleanConverter" />

        <!-- Tab Header RadioButton Style (Clean Application Theme) -->
        <Style x:Key="PlanTabRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Search Box Style matching UnitMasterView -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" Margin="0" Padding="{TemplateBinding Padding}" />
                                <TextBlock x:Name="placeholder" Grid.Column="1" Text="Search plan..." Foreground="#94A3B8" FontSize="12.5" IsHitTestVisible="False" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Clean Column Header Style -->
        <Style x:Key="AppThemeDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="SeparatorBrush" Value="#E2E8F0" />
        </Style>

        <!-- DataGrid Clean Cell Style -->
        <Style x:Key="AppThemeDataGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE" />
                    <Setter Property="Foreground" Value="#0369A1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Context Strip (Well Name, Wellbore Name, Timelog Name, Primary status & Switcher) -->
            <RowDefinition Height="Auto" />
            <!-- 2: Status Alert Banner -->
            <RowDefinition Height="Auto" />
            <!-- 3: Main Workspace (Left Tree + Right Table) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- 0: TOP HEADER BANNER (Consistent with DrillIntel App Style)      -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="Hook" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="36" Height="36" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BroomStick Manage Plan" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Manage, analyze and import Torque &amp; Drag Additional Hookload Plans (CSV / Excel via SavePlanEx)" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="12" Opacity="0.9" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Import CSV/Excel Button -->
                    <Button Command="{Binding OpenImportDialogCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                            BorderBrush="{DynamicResource PrimaryHueMidForegroundBrush}"
                            Height="34" Padding="14,0" Margin="0,0,8,0"
                            ToolTip="Import Plan from CSV or Excel file via SavePlanEx">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileUploadOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Import CSV/Excel" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Sample Plans Button -->
                    <Button Command="{Binding LoadSampleDemoPlansCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                            BorderBrush="{DynamicResource PrimaryHueMidForegroundBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0"
                            ToolTip="Load sample engineering plans (9 pre-configured Torque &amp; Drag models)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Sample Plans" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                            BorderBrush="{DynamicResource PrimaryHueMidForegroundBrush}"
                            Height="34" Width="36" Padding="0" Margin="0,0,8,0"
                            ToolTip="Reload plans from SQLite database">
                        <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>

                    <!-- Save Plan Button -->
                    <Button Command="{Binding SavePlanCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#10B981" BorderBrush="#059669"
                            Height="34" Padding="16,0"
                            ToolTip="Save active plan modifications to SQLite database">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Save Plan" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 1: CONTEXT STRIP (Well, Wellbore, Timelog & Context Switcher)     -->
        <!-- ================================================================= -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" Padding="14,10" Margin="0,0,0,10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Badges (Well, Wellbore, Timelog, Status) -->
                    <ColumnDefinition Width="*" />
                    <!-- Switch Timelog ComboBox -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Well Badge -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Factory" Width="16" Height="16" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Well: " FontSize="11" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentWellName}" FontSize="12.5" Foreground="#0F172A" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Wellbore Badge -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="SourceBranch" Width="16" Height="16" Foreground="#6366F1" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Wellbore: " FontSize="11" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentWellboreName}" FontSize="12.5" Foreground="#0F172A" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Timelog Badge -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16" Foreground="#0D9488" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Timelog: " FontSize="11" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentLogName}" FontSize="12.5" Foreground="#0F172A" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Primary Timelog Badge -->
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,10,4"
                            Visibility="{Binding IsPrimaryTimelog, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="This timelog is designated as PrimaryLog in the database.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Foreground="#059669" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Primary Timelog" FontSize="11" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- No Primary Marked Warning Badge -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,10,4"
                            Visibility="{Binding HasNoPrimaryTimelog, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Multiple timelogs exist for this well, but NONE is marked as Primary. Plans are associated with the selected timelog below.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="#D97706" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="⚠ No Primary Marked (Auto-selected)" FontSize="11" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Switch Timelog Dropdown on Right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Switch Timelog:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding AvailableTimelogContexts}"
                              SelectedItem="{Binding SelectedTimelogContext}"
                              DisplayMemberPath="DisplayText"
                              MinWidth="320" MaxWidth="440" Height="32"
                              FontSize="12" VerticalContentAlignment="Center"
                              ToolTip="Switch active Timelog to view/import associated plans, or select '★ All Plans' to view across all timelogs." />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ================================================================= -->
        <!-- 2: STATUS MESSAGE BANNER (Exact Style from Broomstick Profile)   -->
        <!-- ================================================================= -->
        <Border Grid.Row="2" Margin="0,0,0,10" CornerRadius="6" Padding="12,8"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F5E9" />
                    <Setter Property="BorderBrush" Value="#81C784" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Setter Property="BorderBrush" Value="#E57373" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="CheckCircleOutline" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 3: MAIN WORKSPACE (LEFT TREEVIEW + RIGHT TABLE)                 -->
        <!-- ================================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Left Pane: Plan Navigator (340px) -->
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="500" />
                <!-- GridSplitter -->
                <ColumnDefinition Width="6" />
                <!-- Right Pane: Tabs & DataGrid Table -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- LEFT PANE: PLAN EXPLORER CARD                                 -->
            <!-- ============================================================= -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Card Header -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Search Input -->
                        <RowDefinition Height="Auto" />
                        <!-- 2: Action Buttons (Delete, Select All) -->
                        <RowDefinition Height="Auto" />
                        <!-- 3: Plan Group List / TreeView -->
                        <RowDefinition Height="*" />
                        <!-- 4: Bottom Quick Action Strip -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 0: Card Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Available Plans" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding PlanGroups.Count, StringFormat='{}{0} Groups'}" FontSize="11" FontWeight="Medium" Foreground="#475569" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 1: Search plan Input -->
                    <Border Grid.Row="1" Padding="12,10,12,6">
                        <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <!-- 2: Action Toolbar (Delete in Red, Select All in Green) -->
                    <Border Grid.Row="2" Padding="12,4,12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Delete Button -->
                            <Button Grid.Column="0" Command="{Binding DeleteSelectedPlansCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#DC2626" BorderBrush="#FCA5A5"
                                    Height="28" Padding="10,0"
                                    ToolTip="Delete selected plans">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Delete" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Select All Button -->
                            <Button Grid.Column="2" Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#16A34A" BorderBrush="#86EFAC"
                                    Height="28" Padding="10,0"
                                    ToolTip="Toggle select/deselect all plans">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckboxMarkedOutline" Width="15" Height="15" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Select All" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 3: Grouped TreeView / ItemsControl -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6,6,6">
                        <ItemsControl ItemsSource="{Binding PlanGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodels:PlanTreeGroupViewModel}">
                                    <Border Margin="0,0,0,4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  Foreground="#1E293B">
                                            <Expander.Header>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Command="{Binding ElementName=ManageViewRoot, Path=DataContext.SelectGroupCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Left"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            ToolTip="Click to select this plan group">
                                                        <TextBlock Text="{Binding GroupName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Select entire group" />
                                                </Grid>
                                            </Expander.Header>

                                            <!-- Group Children Plans -->
                                            <ItemsControl ItemsSource="{Binding Plans}" Margin="8,2,8,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewmodels:PlanTreeItemViewModel}">
                                                        <!-- Clickable Plan Row Button (100% Reliable Hit-Testing) -->
                                                        <Button Command="{Binding ElementName=ManageViewRoot, Path=DataContext.SelectPlanCommand}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0" Margin="0,1"
                                                                Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="ItemBorder" CornerRadius="6" Padding="8,6" Margin="0,1"
                                                                            Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Hook / Plan Icon -->
                                                                            <materialDesign:PackIcon x:Name="PlanIcon" Grid.Column="0" Kind="Hook" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                            <!-- Plan Name / Run Number -->
                                                                            <TextBlock x:Name="PlanNameText" Grid.Column="1" Text="{Binding DisplayName}" ToolTip="{Binding PlanName}" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                                            <!-- Active Badge Indicator -->
                                                                            <Border x:Name="ActiveBadge" Grid.Column="2" Background="#10B981" CornerRadius="3" Padding="5,1" Margin="6,0,4,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                                                <TextBlock Text="Active" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                            </Border>

                                                                            <!-- Checkbox for Multi-select -->
                                                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                        </Grid>
                                                                    </Border>

                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                                                        </Trigger>
                                                                        <!-- Active Selected Plan highlighted with Green Border & Background -->
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#ECFDF5" />
                                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#10B981" />
                                                                            <Setter TargetName="PlanNameText" Property="Foreground" Value="#065F46" />
                                                                            <Setter TargetName="PlanNameText" Property="FontWeight" Value="SemiBold" />
                                                                            <Setter TargetName="PlanIcon" Property="Foreground" Value="#059669" />
                                                                            <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 4: Bottom Quick Action Strip -->
                    <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding CreateNewPlanCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                    BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                    Height="28" Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="New Plan" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="#64748B" Height="28" Padding="8,0"
                                    ToolTip="Export active curve to CSV">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ExportVariant" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Export" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- GridSplitter between Tree and Data Table -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0" />

            <!-- ============================================================= -->
            <!-- RIGHT PANE: 8 TABS & DATAGRID TABLE (Light Theme)             -->
            <!-- ============================================================= -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: 8-Tab Header Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Active Curve Control Strip -->
                        <RowDefinition Height="Auto" />
                        <!-- 2: DataGrid Table -->
                        <RowDefinition Height="*" />
                        <!-- 3: Table Footer (Total Rows: 89) -->
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>

                    <!-- 0: 8-Tab Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                <RadioButton Content="Pickup" GroupName="PlanCurveTabs" Style="{StaticResource PlanTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=0}" />
                                <RadioButton Content="SlackOff" GroupName="PlanCurveTabs" Style="{StaticResource PlanTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=1}" />
                                <RadioButton Content="Rotate" GroupName="PlanCurveTabs" Style="{StaticResource PlanTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=2}" />
                                <RadioButton Content="Off Bottom Torque" GroupName="PlanCurveTabs" Style="{StaticResource PlanTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=3}" />
                                <RadioButton Content="On Bottom Torque" GroupName="PlanCurveTabs" Style="{StaticResource PlanTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=4}" />
                                <RadioButton Content="Make-Up Torque" GroupName="PlanCurveTabs" Style="{StaticResource PlanTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=5}" />
                                <RadioButton Content="Torque Limit" GroupName="PlanCurveTabs" Style="{StaticResource PlanTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=6}" />
                                <RadioButton Content="Sinusoidal While Rotating" GroupName="PlanCurveTabs" Style="{StaticResource PlanTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=7}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 1: Active Curve Control Strip -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Plan Breadcrumb -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ActivePlanItem.BreadcrumbTitle, FallbackValue='No Plan Selected'}" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                <TextBlock Text="›" FontSize="14" Foreground="#94A3B8" Margin="8,0" VerticalAlignment="Center" />
                                <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding SelectedTabTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#047857" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- Curve Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Add Point Row Button -->
                                <Button Command="{Binding AddRowCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="#16A34A" BorderBrush="#86EFAC"
                                        Height="28" Padding="10,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TableRowPlusAfter" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add Point" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Import File Button -->
                                <Button Command="{Binding OpenImportDialogCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                                        BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                        Height="28" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExcelOutline" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Import CSV/Excel" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2: DataGrid Table (Clean Light Application Theme) -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding CurrentTableRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E2E8F0"
                              VerticalGridLinesBrush="#E2E8F0"
                              Background="#FFFFFF"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              RowHeight="30"
                              FontSize="12.5"
                              FontFamily="Consolas, Segoe UI, monospace"
                              CellStyle="{StaticResource AppThemeDataGridCell}"
                              ColumnHeaderStyle="{StaticResource AppThemeDataGridColumnHeader}">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F8FAFC" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- Depth Column -->
                            <DataGridTextColumn Header="Depth" Binding="{Binding Depth, StringFormat={}{0:0.##}}" Width="1.2*" />

                            <!-- Weight Column -->
                            <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:0.##}}" Width="1.4*" />

                            <!-- Max Tension Column -->
                            <DataGridTextColumn Header="Max Tension" Binding="{Binding MaxTension, StringFormat={}{0:0.##}}" Width="1.2*" />

                            <!-- Min Tension Column -->
                            <DataGridTextColumn Header="Min Tension" Binding="{Binding MinTension, StringFormat={}{0:0.##}}" Width="1.2*" />

                            <!-- Max Compress Column -->
                            <DataGridTextColumn Header="Max Compress" Binding="{Binding MaxCompress, StringFormat={}{0:0.##}}" Width="1.2*" />

                            <!-- Min Compress Column -->
                            <DataGridTextColumn Header="Min Compress" Binding="{Binding MinCompress, StringFormat={}{0:0.##}}" Width="1.2*" />

                            <!-- Delete Row Action Column -->
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type viewmodels:HookloadPlanDataRowViewModel}">
                                        <Button Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignToolButton}"
                                                Width="24" Height="24" Padding="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTip="Delete this depth point">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" Foreground="#94A3B8">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 3: Bottom Status Footer matching screenshot: "Total Rows: 89" -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="15" Height="15" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Database synchronized • Ready" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Total Rows matching screenshot bottom-right -->
                            <TextBlock Grid.Column="1" Text="{Binding TotalRowsText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>

