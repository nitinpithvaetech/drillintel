<Window x:Class="DrillIntel.Views.Broomstick.ImportPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ImportPlanViewModel}"
        Title="Import Plan (CSV / Excel) — SavePlanEx"
        Height="680" Width="920"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Status Banner -->
            <RowDefinition Height="Auto" />
            <!-- 2: Main Content (Config + Preview) -->
            <RowDefinition Height="*" />
            <!-- 3: Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="DatabaseImport" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="28" Height="28" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Import Broomstick / Hookload Plan" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Quick 1-Click Import from Excel (.xlsx, .xls) and CSV files via SavePlanEx" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="11" Opacity="0.9" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: Status Banner -->
        <Border Grid.Row="1" Margin="0,0,0,10" CornerRadius="6" Padding="12,8"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F5E9" />
                    <Setter Property="BorderBrush" Value="#81C784" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Setter Property="BorderBrush" Value="#E57373" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="CheckCircleOutline" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1B5E20" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#B71C1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 2: Main Content -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Target Association Banner (Context Info) -->
            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Target" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Target Context:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />

                        <!-- Well -->
                        <materialDesign:PackIcon Kind="Factory" Width="15" Height="15" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding WellName}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <!-- Separator -->
                        <TextBlock Text="›" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <!-- Wellbore -->
                        <materialDesign:PackIcon Kind="SourceBranch" Width="15" Height="15" Foreground="#6366F1" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding WellboreName}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <!-- Separator -->
                        <TextBlock Text="›" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <!-- Timelog -->
                        <materialDesign:PackIcon Kind="ClockOutline" Width="15" Height="15" Foreground="#0D9488" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding LogName}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- Primary Pill -->
                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,3"
                            Visibility="{Binding IsPrimaryLog, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="13" Height="13" Foreground="#059669" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Primary Timelog" FontSize="11" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Configuration Card -->
            <materialDesign:Card Grid.Row="1" Padding="14" UniformCornerRadius="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- File Picker Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox materialDesign:HintAssist.Hint="Select CSV or Excel (.xlsx, .xls) File"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" />
                        <Button Grid.Column="1" Command="{Binding BrowseFileCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="36" Padding="14,0" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Browse File..." FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Metadata Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Plan Name -->
                        <TextBox Grid.Column="0" Margin="0,0,16,0"
                                 materialDesign:HintAssist.Hint="Plan Name (e.g. RotateOnBottom 0.2 OHFF)"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Plan Type -->
                        <ComboBox Grid.Column="1"
                                  materialDesign:HintAssist.Hint="Plan Type"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  SelectedValue="{Binding PlanType}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="Hookload Plan (HKLDP)" Tag="HKLDP" IsSelected="True" />
                            <ComboBoxItem Content="Torque Plan (TORP)" Tag="TORP" />
                        </ComboBox>


                    </Grid>

                    <!-- Depth Range Row -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Content="Filter by Depth Range (SavePlanEx Partial Range)"
                                  IsChecked="{Binding ImportByRange}" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="Medium" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding ImportByRange}" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="Gray" />
                            <TextBox Width="75" Text="{Binding FromDepth, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" IsEnabled="{Binding ImportByRange}" VerticalAlignment="Center">
                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="Gray" />
                            <TextBox Width="75" Text="{Binding ToDepth, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Detected curves summary badge -->
                        <Border Grid.Column="3" HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding DetectedCurvesSummary}" FontSize="11" Foreground="#475569" FontWeight="Medium" />
                        </Border>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Live Data Preview Table -->
            <materialDesign:Card Grid.Row="2" Padding="10" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="TableEye" Width="16" Height="16" Foreground="#1976D2" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Data Preview (First 10 Rows)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PreviewTable.DefaultView}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              GridLinesVisibility="All"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0"
                              FontSize="12"
                              RowHeight="26" />
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- 3: Action Buttons -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Files are parsed and saved directly into VMX_ADNL_HKLD_PLAN and VMX_ADNL_HKLD_PLAN_DATA." FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Cancel Button -->
                <Button Grid.Column="1" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="36" Padding="16,0" Margin="0,0,10,0">
                    <TextBlock Text="Cancel" FontWeight="SemiBold" />
                </Button>

                <!-- Execute Import Button -->
                <Button Grid.Column="2" Command="{Binding ExecuteImportCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#10B981" BorderBrush="#059669"
                        Height="36" Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckBold" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Import &amp; Save Plan" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

