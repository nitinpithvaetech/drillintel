<Window x:Class="DrillIntel.Views.Broomstick.BroomstickPlanManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:DrillIntel.Views.Broomstick"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:BroomstickPlanManageViewModel}"
        Title="{Binding WindowTitle, FallbackValue='BroomStick Manage Plan'}" 
        Height="880" Width="1380"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <local:BroomstickPlanManageView />
    </Grid>
</Window>

