<UserControl x:Class="DrillIntel.Views.Broomstick.BroomstickWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels.Broomstick"
             xmlns:views="clr-namespace:DrillIntel.Views.Broomstick"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:BroomstickWorkspaceViewModel}"
             d:DesignHeight="800" d:DesignWidth="1280"
             Background="#0B0E14"
             TextElement.Foreground="#E2E8F0"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!-- Tab Header Template -->
        <DataTemplate x:Key="BroomstickTabHeaderTemplate">
            <Border Background="Transparent" Padding="4,2" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="ChartScatterPlot" Width="14" Height="14" 
                                             Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBlock Grid.Column="1" Text="{Binding DocumentName}" FontSize="11.5" FontWeight="SemiBold" 
                               VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="2" Text="*" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" 
                               VerticalAlignment="Center" Margin="2,0,4,0"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="Unsaved changes" />

                    <Button Grid.Column="3" Style="{StaticResource MaterialDesignToolButton}" 
                            Command="{Binding DataContext.CloseDocumentTabCommand, RelativeSource={RelativeSource AncestorType=views:BroomstickWorkspaceView}}"
                            CommandParameter="{Binding}"
                            ToolTip="Close Document"
                            Width="18" Height="18" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="#94A3B8" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- TreeView Hierarchical Templates -->
        <HierarchicalDataTemplate DataType="{x:Type viewmodels:BroomstickDocumentTreeGroupNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,3" Visibility="{Binding IsVisibleInFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="FolderOutline" Width="15" Height="15" Foreground="#6366F1" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="11.5" Foreground="#F8FAFC" VerticalAlignment="Center" />
                <Border Background="#1E293B" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DocumentCount}" FontSize="9.5" FontWeight="Bold" Foreground="#818CF8" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:BroomstickDocumentTreeNode}">
            <Border Padding="4,2" Margin="0,1" CornerRadius="4"
                    Visibility="{Binding IsVisibleInFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="ChartScatterPlot" Width="14" Height="14" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBlock Grid.Column="1" Text="{Binding DocumentName}" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <Border Grid.Column="2" Background="#78350F" BorderBrush="#92400E" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="Star" Width="10" Height="10" Foreground="#FBBF24" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left TreeView Pane -->
            <ColumnDefinition Width="280" MinWidth="220" MaxWidth="450" />
            <!-- Splitter -->
            <ColumnDefinition Width="5" />
            <!-- Right Document Workspace -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Pane -->
        <Border Grid.Column="0" Background="#10141D" BorderBrush="#1F2838" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Toolbar -->
                    <RowDefinition Height="Auto" />
                    <!-- Search -->
                    <RowDefinition Height="Auto" />
                    <!-- TreeView -->
                    <RowDefinition Height="*" />
                    <!-- Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Background="#141924" BorderBrush="#1F2838" BorderThickness="0,0,0,1" Padding="6,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NewDocumentCommand}" 
                                Style="{StaticResource MaterialDesignToolButton}"
                                Height="26" Padding="6,0" Margin="0,0,2,0"
                                ToolTip="Create New Broomstick Document">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBlock Text="New" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding MakeDefaultCommand}" 
                                IsEnabled="{Binding CanMakeDefaultSelection}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                Height="26" Padding="6,0" Margin="0,0,2,0"
                                ToolTip="Set Selected Document as Default Template">
                            <materialDesign:PackIcon Kind="StarOutline" Width="14" Height="14" Foreground="#F59E0B" VerticalAlignment="Center" />
                        </Button>

                        <Button Command="{Binding DeleteDocumentCommand}" 
                                IsEnabled="{Binding CanDeleteSelection}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                Height="26" Padding="6,0"
                                ToolTip="Delete Selected Document">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="#EF4444" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border Grid.Row="1" Background="#10141D" BorderBrush="#1F2838" BorderThickness="0,0,0,1" Padding="8,4">
                    <Grid>
                        <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Filter templates..."
                                 FontSize="11" Foreground="#F8FAFC" BorderThickness="0" Padding="22,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- TreeView -->
                <TreeView Grid.Row="2" 
                          ItemsSource="{Binding TreeRoots}" 
                          BorderThickness="0" 
                          Padding="4"
                          Background="Transparent"
                          SelectedItemChanged="OnTreeViewSelectedItemChanged"
                          MouseDoubleClick="OnTreeViewMouseDoubleClick" />

                <!-- Footer Status -->
                <Border Grid.Row="3" Background="#0C0F17" BorderBrush="#1F2838" BorderThickness="0,1,0,0" Padding="8,4">
                    <TextBlock Text="{Binding TotalDocumentCount, StringFormat='{}{0} templates total'}" FontSize="10.5" Foreground="#64748B" />
                </Border>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#161C27" />

        <!-- Right: Multi-Document Workspace Tabs -->
        <Grid Grid.Column="2">
            <!-- No Document Open Placeholder -->
            <Border Background="#0B0E14" Visibility="{Binding HasOpenDocuments, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartScatterPlot" Width="48" Height="48" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="No Broomstick Document Open" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                    <TextBlock Text="Double-click a template on the left or click New to begin." FontSize="11.5" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,14" />
                    <Button Command="{Binding NewDocumentCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4F46E5" Foreground="White" Height="30" Padding="14,0" HorizontalAlignment="Center">
                        <TextBlock Text="Create New Document" FontSize="11" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Document Tabs -->
            <TabControl ItemsSource="{Binding OpenDocuments}" 
                        SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                        ItemTemplate="{StaticResource BroomstickTabHeaderTemplate}"
                        Visibility="{Binding HasOpenDocuments, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#000000" BorderThickness="0">
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <views:BroomstickDocumentView />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>

