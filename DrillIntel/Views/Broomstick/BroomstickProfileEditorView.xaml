<UserControl x:Class="DrillIntel.Views.Broomstick.BroomstickProfileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:BroomstickProfileEditorViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="800" d:DesignWidth="1100"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

        <Style x:Key="TabHeaderIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ParamCard" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="16" />
            <Setter Property="UniformCornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="UnitText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="#757575" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="OutlinedInput" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="6" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>

        <Style x:Key="OutlinedCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="6" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>

        <Style x:Key="OutlinedBox" TargetType="Border">
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0. Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1. Status Alert Message -->
            <RowDefinition Height="Auto" />
            <!-- 2. Main Content Tabs -->
            <RowDefinition Height="*" />
            <!-- 3. Bottom Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header Banner -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="TuneVariant" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="36" Height="36" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="12" Opacity="0.9" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Copy from App Master Button (Visible when editing project configuration) -->
                <Button Grid.Column="2" Command="{Binding CopyFromAppMasterCommand}"
                        Visibility="{Binding CanCopyFromAppMaster, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                        BorderBrush="{DynamicResource PrimaryHueMidForegroundBrush}"
                        Height="34" Padding="12,0" VerticalAlignment="Center"
                        ToolTip="Copy and apply values from the Application Master Template into this project">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Copy from App Master" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 1. Status Alert Message -->
        <Border Grid.Row="1" Margin="0,0,0,10" CornerRadius="6" Padding="12,8"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F5E9" />
                    <Setter Property="BorderBrush" Value="#81C784" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Setter Property="BorderBrush" Value="#E57373" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="CheckCircleOutline" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 2. Main Content Tabs -->
        <TabControl Grid.Row="2" materialDesign:ColorZoneAssist.Mode="Standard">

            <!-- TAB 1: General & Sampling (Filter Criteria) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tune" Style="{StaticResource TabHeaderIcon}" />
                        <TextBlock Text="General &amp; Sampling" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,6,8">
                    <StackPanel Margin="4">
                        <!-- TOP CARD: Profile Identity -->
                        <materialDesign:Card Style="{StaticResource ParamCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Profile Identity" Style="{StaticResource SectionTitle}" />

                                <!-- Is Default Checkbox -->
                                <CheckBox Content="Is Default" IsChecked="{Binding IsDefault}" FontWeight="SemiBold" Margin="0,0,0,14" />

                                <!-- 3-Column Identity Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="360" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" MaxWidth="360" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 1: Profile Name -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Profile Name" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutlinedInput}" />
                                    </StackPanel>

                                    <!-- Column 2: Profile Type (Two adjacent selection boxes matching React) -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Profile Type" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource OutlinedBox}" Cursor="Hand">
                                                <CheckBox Content="Hookload" IsChecked="{Binding IsHookloadType}"
                                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource OutlinedBox}" Cursor="Hand">
                                                <CheckBox Content="Torque" IsChecked="{Binding IsTorqueType}"
                                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Column 3: Notes -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutlinedInput}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- MAIN CARD: Filter Criteria & Sampling (Directly matching React BroomstickHkldMgr.tsx) -->
                        <materialDesign:Card Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="Filter Criteria" Style="{StaticResource SectionTitle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="360" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" MaxWidth="360" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" MaxWidth="360" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <!-- Row 0: Down Sample Data On & Data Points per (and Minutes if By Time) -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Row 1: Filter Headers -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Row 2: Filter Inputs (Min, Max, Depth Interval) -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Row 3: Group Function, Track Width, Interval Window -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Row 4: Show Depth Track & Points To Plot -->
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- ROW 0: Down Sample Data On & Data Points -->
                                    <!-- Col 0: Down Sample Data On -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                                        <TextBlock Text="Down Sample Data On" Style="{StaticResource FieldLabel}" />
                                        <ComboBox SelectedIndex="{Binding DownSampleOn}" Style="{StaticResource OutlinedCombo}">
                                            <ComboBoxItem Content="By Depth" />
                                            <ComboBoxItem Content="By Time" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Col 2: Data Points per -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                                        <TextBlock Text="{Binding DataPointsDepthLabel}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding DataPoints, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutlinedInput}" />
                                    </StackPanel>

                                    <!-- Col 4: Minutes (visible only when DownSampleOn == 1 / By Time) -->
                                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,20"
                                                Visibility="{Binding IsDownSampleByTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Minutes" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TimePeriod, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutlinedInput}" />
                                    </StackPanel>

                                    <!-- ROW 1: Filter Headers -->
                                    <!-- Col 0: Filter By Data Range Header Checkbox -->
                                    <CheckBox Grid.Row="1" Grid.Column="0"
                                              Content="Filter By Data Range"
                                              IsChecked="{Binding FilterByRange}"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,10" />

                                    <!-- Col 4: Filter By Depth Intervals Header Checkbox (aligned above Depth Interval) -->
                                    <CheckBox Grid.Row="1" Grid.Column="4"
                                              Content="Filter By Depth Intervals"
                                              IsChecked="{Binding FilterByInterval}"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,10" />

                                    <!-- ROW 2: Filter Inputs -->
                                    <!-- Col 0: Min (under Filter By Data Range) -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20" IsEnabled="{Binding FilterByRange}">
                                        <TextBlock Text="{Binding HookloadMinLabel}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding MinHookload, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutlinedInput}" />
                                    </StackPanel>

                                    <!-- Col 2: Max (under Filter By Data Range) -->
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20" IsEnabled="{Binding FilterByRange}">
                                        <TextBlock Text="{Binding HookloadMaxLabel}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding MaxHookload, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutlinedInput}" />
                                    </StackPanel>

                                    <!-- Col 4: Depth Interval (under Filter By Depth Intervals) -->
                                    <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,0,0,20" IsEnabled="{Binding FilterByInterval}">
                                        <TextBlock Text="{Binding DepthIntervalLabel}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding DepthInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutlinedInput}" />
                                    </StackPanel>

                                    <!-- ROW 3: Group Function, Track Width, Interval Window -->
                                    <!-- Col 0: Group function -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20">
                                        <TextBlock Text="Group function" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource OutlinedBox}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Content="Min" IsChecked="{Binding GroupFuncMin}"
                                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                <CheckBox Grid.Column="1" Content="Max" IsChecked="{Binding GroupFuncMax}"
                                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                <CheckBox Grid.Column="2" Content="Avg" IsChecked="{Binding GroupFuncAvg}"
                                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Col 2: Depth Track Width Pixels -->
                                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,20">
                                        <TextBlock Text="Depth Track Width Pixels" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TrackWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutlinedInput}" />
                                    </StackPanel>

                                    <!-- Col 4: Filter Data Points Outside -->
                                    <StackPanel Grid.Row="3" Grid.Column="4" Margin="0,0,0,20">
                                        <TextBlock Text="Filter Data Points Outside" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding IntervalWindow, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutlinedInput}"
                                                 ToolTip="Filter data points outside this interval window (% mean)" />
                                    </StackPanel>

                                    <!-- ROW 4: Show Depth Track & Points To Plot -->
                                    <!-- Col 0: Show Depth Track Checkbox -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,6">
                                        <CheckBox Content="Show Depth Track"
                                                  IsChecked="{Binding ShowDepthTrack}"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"
                                                  Margin="0,26,0,0" />
                                    </StackPanel>

                                    <!-- Col 2: Points To Plot ComboBox -->
                                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,6">
                                        <TextBlock Text="Points To Plot" Style="{StaticResource FieldLabel}" />
                                        <ComboBox SelectedIndex="{Binding PointsToPlot}" Style="{StaticResource OutlinedCombo}">
                                            <ComboBoxItem Content="Dynamic" />
                                            <ComboBoxItem Content="Static" />
                                            <ComboBoxItem Content="Both" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Pick-Up (PU) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowUpBoldCircleOutline" Style="{StaticResource TabHeaderIcon}" Foreground="#2E7D32" />
                        <TextBlock Text="Pick-Up (PU)" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,6,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Cutoffs and Methods -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <materialDesign:Card Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="Pick-Up Identification Cutoffs" Style="{StaticResource SectionTitle}" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox materialDesign:HintAssist.Hint="Pump Channel" SelectedValue="{Binding PkupPumpChannel}" SelectedValuePath="Tag" Margin="0,0,6,0">
                                            <ComboBoxItem Content="Pump Pressure (SPPA)" Tag="SPPA" />
                                            <ComboBoxItem Content="Circulation (CIRC)" Tag="CIRC" />
                                        </ComboBox>
                                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Pump Cutoff" Text="{Binding PkupPumpCutOff}" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding PressureUnit}" Style="{StaticResource UnitText}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="RPM Cutoff" Text="{Binding PkupRPMCutOff}" />
                                        <TextBlock Grid.Column="1" Text="{Binding RpmUnit}" Style="{StaticResource UnitText}" Margin="4,0,12,0" />
                                        <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Pump Status" SelectedIndex="{Binding PkupPlotPoints}">
                                            <ComboBoxItem Content="All Points" />
                                            <ComboBoxItem Content="Pump On Only" />
                                            <ComboBoxItem Content="Pump Off Only" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Min Movement" Text="{Binding PkupMinMovement}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DepthUnit}" Style="{StaticResource UnitText}" Margin="4,0,12,0" />
                                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Max Movement" Text="{Binding PkupMaxMovement}" />
                                        <TextBlock Grid.Column="3" Text="{Binding DepthUnit}" Style="{StaticResource UnitText}" />
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="Pick-Up Calculation Methods" Style="{StaticResource SectionTitle}" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox materialDesign:HintAssist.Hint="Static Method" SelectedIndex="{Binding PkupStaticMethod}" Margin="0,0,6,0">
                                            <ComboBoxItem Content="Minimum" />
                                            <ComboBoxItem Content="Maximum" />
                                            <ComboBoxItem Content="Average" />
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="Dynamic Method" SelectedIndex="{Binding PkupDynamicMethod}" Margin="6,0,0,0">
                                            <ComboBoxItem Content="Break Over" />
                                            <ComboBoxItem Content="Average" />
                                            <ComboBoxItem Content="Avg after Break Over" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox materialDesign:HintAssist.Hint="Multi-Method Mode" SelectedIndex="{Binding PkupMultiMethod}" Margin="0,0,6,0">
                                            <ComboBoxItem Content="Minimum" />
                                            <ComboBoxItem Content="Maximum" />
                                        </ComboBox>
                                        <CheckBox Grid.Column="1" Content="PU Local Maximum" IsChecked="{Binding PkupLocalMax}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>

                                    <CheckBox Content="Show Multiple" IsChecked="{Binding ShowMultiple}" Margin="0,4,0,4" />
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <!-- Right: Allowed Rig States -->
                        <materialDesign:Card Grid.Column="1" Style="{StaticResource ParamCard}" Margin="8,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Allowed Rig States for Pick-Up" Style="{StaticResource SectionTitle}" />
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Command="{Binding SelectAllRigStatesCommand}" CommandParameter="PU" Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28" Padding="6,0" Content="Select All" Margin="0,0,6,0" />
                                    <Button Command="{Binding ClearAllRigStatesCommand}" CommandParameter="PU" Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28" Padding="6,0" Content="Clear All" />
                                </StackPanel>

                                <ListBox Grid.Row="2" ItemsSource="{Binding PkupRigStates}" MaxHeight="380" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" Width="26" Foreground="#757575" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Slack-Off (SO) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowDownBoldCircleOutline" Style="{StaticResource TabHeaderIcon}" Foreground="#C62828" />
                        <TextBlock Text="Slack-Off (SO)" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,6,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Cutoffs and Methods -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <materialDesign:Card Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="Slack-Off Identification Cutoffs" Style="{StaticResource SectionTitle}" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox materialDesign:HintAssist.Hint="Pump Channel" SelectedValue="{Binding SlkPumpChannel}" SelectedValuePath="Tag" Margin="0,0,6,0">
                                            <ComboBoxItem Content="Pump Pressure (SPPA)" Tag="SPPA" />
                                            <ComboBoxItem Content="Circulation (CIRC)" Tag="CIRC" />
                                        </ComboBox>
                                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Pump Cutoff" Text="{Binding SlkPumpCutOff}" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding PressureUnit}" Style="{StaticResource UnitText}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="RPM Cutoff" Text="{Binding SlkRPMCutOff}" />
                                        <TextBlock Grid.Column="1" Text="{Binding RpmUnit}" Style="{StaticResource UnitText}" Margin="4,0,12,0" />
                                        <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Pump Status" SelectedIndex="{Binding SlkPlotPoints}">
                                            <ComboBoxItem Content="All Points" />
                                            <ComboBoxItem Content="Pump On Only" />
                                            <ComboBoxItem Content="Pump Off Only" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Min Movement" Text="{Binding SlkMinMovement}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DepthUnit}" Style="{StaticResource UnitText}" Margin="4,0,12,0" />
                                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Max Movement" Text="{Binding SlkMaxMovement}" />
                                        <TextBlock Grid.Column="3" Text="{Binding DepthUnit}" Style="{StaticResource UnitText}" />
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="Slack-Off Calculation Methods" Style="{StaticResource SectionTitle}" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox materialDesign:HintAssist.Hint="Static Method" SelectedIndex="{Binding SlkStaticMethod}" Margin="0,0,6,0">
                                            <ComboBoxItem Content="Minimum" />
                                            <ComboBoxItem Content="Maximum" />
                                            <ComboBoxItem Content="Average" />
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="Dynamic Method" SelectedIndex="{Binding SlkDynamicMethod}" Margin="6,0,0,0">
                                            <ComboBoxItem Content="Break Over" />
                                            <ComboBoxItem Content="Average" />
                                            <ComboBoxItem Content="Avg after Break Over" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox materialDesign:HintAssist.Hint="Multi-Method Mode" SelectedIndex="{Binding SlkMultiMethod}" Margin="0,0,6,0">
                                            <ComboBoxItem Content="Minimum" />
                                            <ComboBoxItem Content="Maximum" />
                                        </ComboBox>
                                        <CheckBox Grid.Column="1" Content="SO Local Minimum" IsChecked="{Binding SlkLocalMax}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>

                                    <CheckBox Content="Show Multiple" IsChecked="{Binding ShowMultiple}" Margin="0,4,0,4" />
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <!-- Right: Allowed Rig States -->
                        <materialDesign:Card Grid.Column="1" Style="{StaticResource ParamCard}" Margin="8,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Allowed Rig States for Slack-Off" Style="{StaticResource SectionTitle}" />
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Command="{Binding SelectAllRigStatesCommand}" CommandParameter="SO" Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28" Padding="6,0" Content="Select All" Margin="0,0,6,0" />
                                    <Button Command="{Binding ClearAllRigStatesCommand}" CommandParameter="SO" Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28" Padding="6,0" Content="Clear All" />
                                </StackPanel>

                                <ListBox Grid.Row="2" ItemsSource="{Binding SlkRigStates}" MaxHeight="380" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" Width="26" Foreground="#757575" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: Rotary (ROT) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Sync" Style="{StaticResource TabHeaderIcon}" Foreground="#1565C0" />
                        <TextBlock Text="Rotary (ROT)" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,6,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Cutoffs and Stability -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <materialDesign:Card Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="Rotary Identification Cutoffs" Style="{StaticResource SectionTitle}" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox materialDesign:HintAssist.Hint="Pump Channel" SelectedValue="{Binding RotPumpChannel}" SelectedValuePath="Tag" Margin="0,0,6,0">
                                            <ComboBoxItem Content="Pump Pressure (SPPA)" Tag="SPPA" />
                                            <ComboBoxItem Content="Circulation (CIRC)" Tag="CIRC" />
                                        </ComboBox>
                                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Pump Cutoff" Text="{Binding RotPumpCutOff}" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding PressureUnit}" Style="{StaticResource UnitText}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Min RPM" Text="{Binding RotMinRPM}" />
                                        <TextBlock Grid.Column="1" Text="{Binding RpmUnit}" Style="{StaticResource UnitText}" Margin="4,0,12,0" />
                                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Max RPM" Text="{Binding RotMaxRPM}" />
                                        <TextBlock Grid.Column="3" Text="{Binding RpmUnit}" Style="{StaticResource UnitText}" />
                                    </Grid>

                                    <ComboBox materialDesign:HintAssist.Hint="Pump Status Filter" SelectedIndex="{Binding RotPlotPoints}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="All Points" />
                                        <ComboBoxItem Content="Pump On Only" />
                                        <ComboBoxItem Content="Pump Off Only" />
                                    </ComboBox>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="Stability &amp; PUSO Validation" Style="{StaticResource SectionTitle}" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Hookload Tolerance" Text="{Binding RotChange}" />
                                        <TextBlock Grid.Column="1" Text="{Binding HookloadUnit}" Style="{StaticResource UnitText}" Margin="4,0,12,0" />
                                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Required Points" Text="{Binding RotPoints}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Time Threshold" Text="{Binding TimeThreshold}" />
                                        <TextBlock Grid.Column="1" Text="s" Style="{StaticResource UnitText}" Margin="4,0,12,0" />
                                        <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Multi-Method" SelectedIndex="{Binding RotMultiMethod}">
                                            <ComboBoxItem Content="Minimum" />
                                            <ComboBoxItem Content="Maximum" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Check PUSO Stability" IsChecked="{Binding RotCheckPUSO}" Margin="0,0,6,6" />
                                        <CheckBox Grid.Column="1" Content="Enforce PUSO" IsChecked="{Binding EnforcePUSO}" Margin="6,0,0,6" />
                                    </Grid>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Enforce Rule" IsChecked="{Binding EnforceRule}" Margin="0,0,6,6" />
                                        <CheckBox Grid.Column="1" Content="Plot On Bottom" IsChecked="{Binding PlotOnBottomTorque}" Margin="6,0,0,6" />
                                    </Grid>

                                    <CheckBox Content="Show Multiple" IsChecked="{Binding ShowMultiple}" Margin="0,0,0,4" />
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <!-- Right: Allowed Rig States -->
                        <materialDesign:Card Grid.Column="1" Style="{StaticResource ParamCard}" Margin="8,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Allowed Rig States for Rotary" Style="{StaticResource SectionTitle}" />
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Command="{Binding SelectAllRigStatesCommand}" CommandParameter="ROT" Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28" Padding="6,0" Content="Select All" Margin="0,0,6,0" />
                                    <Button Command="{Binding ClearAllRigStatesCommand}" CommandParameter="ROT" Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28" Padding="6,0" Content="Clear All" />
                                </StackPanel>

                                <ListBox Grid.Row="2" ItemsSource="{Binding RotRigStates}" MaxHeight="380" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" Width="26" Foreground="#757575" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: Casing Settings -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FormatListBulletedSquare" Style="{StaticResource TabHeaderIcon}" Foreground="#6A1B9A" />
                        <TextBlock Text="Casing" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,6,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Casing Movement Settings -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <materialDesign:Card Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="Casing Pick-Up Movement" Style="{StaticResource SectionTitle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Min Casing PU Movement" Text="{Binding CasingPkupMinMovement}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DepthUnit}" Style="{StaticResource UnitText}" Margin="4,0,12,0" />
                                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Max Casing PU Movement" Text="{Binding CasingPkupMaxMovement}" />
                                        <TextBlock Grid.Column="3" Text="{Binding DepthUnit}" Style="{StaticResource UnitText}" />
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="Casing Slack-Off Movement" Style="{StaticResource SectionTitle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Min Casing SO Movement" Text="{Binding CasingSlkMinMovement}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DepthUnit}" Style="{StaticResource UnitText}" Margin="4,0,12,0" />
                                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Max Casing SO Movement" Text="{Binding CasingSlkMaxMovement}" />
                                        <TextBlock Grid.Column="3" Text="{Binding DepthUnit}" Style="{StaticResource UnitText}" />
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <!-- Right: Casing Rig States -->
                        <materialDesign:Card Grid.Column="1" Style="{StaticResource ParamCard}" Margin="8,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Allowed Rig States for Casing Pick-Up" Style="{StaticResource SectionTitle}" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Command="{Binding SelectAllRigStatesCommand}" CommandParameter="CasingPU" Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28" Padding="6,0" Content="Select All" Margin="0,0,6,0" />
                                    <Button Command="{Binding ClearAllRigStatesCommand}" CommandParameter="CasingPU" Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28" Padding="6,0" Content="Clear All" />
                                </StackPanel>

                                <ListBox Grid.Row="2" ItemsSource="{Binding CasingPkupRigStates}" MaxHeight="380" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" Width="26" Foreground="#757575" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 3. Bottom Action Bar -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,6,0,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Changes made apply to Broomstick calculations and plot generations." Foreground="#757575" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CopyFromAppMasterCommand}"
                            Visibility="{Binding CanCopyFromAppMaster, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,10,0" Height="36" Padding="12,0"
                            ToolTip="Reload parameter values from Application Master Template">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Restore from App Master" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ResetDefaultsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,10,0" Width="130" Height="36" Content="Reset Defaults" />

                    <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,10,0" Width="130" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Save Profile" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CloseCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                            Width="90" Height="36" Content="Close" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

