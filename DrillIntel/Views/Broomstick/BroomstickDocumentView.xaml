<UserControl x:Class="DrillIntel.Views.Broomstick.BroomstickDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:teechart="clr-namespace:Steema.TeeChart.WPF;assembly=TeeChart.Business.WPF"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels.Broomstick"
             xmlns:controls="clr-namespace:DrillIntel.Controls"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:BroomstickDocumentViewModel}"
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#0B0E14"
             TextElement.Foreground="#E2E8F0"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!-- Dark Theme Popup Brushes for MaterialDesign Popups & Cards -->
        <SolidColorBrush x:Key="MaterialDesignPaper" Color="#181E2B" />
        <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#181E2B" />
        <SolidColorBrush x:Key="MaterialDesignBody" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MaterialDesignToolTipBackground" Color="#1E293B" />

        <!-- High-Contrast Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#181E2B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A3447" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4F46E5" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4338CA" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- 0: Control Header (Select Plan, V / % / U, Actions) -->
            <RowDefinition Height="Auto" />
            <!-- 1: TeeChart Plot Canvas with Floating Legend & Hover Tooltip -->
            <RowDefinition Height="*" />
            <!-- 2: Sub-chart Bar (Formation Top, Section, View Casing) -->
            <RowDefinition Height="Auto" />
            <!-- 3: Navigation & Range Filter Control Bar (Above dataSelector TrackBar) -->
            <RowDefinition Height="Auto" />
            <!-- 4: Data Selector Range TrackBar Scroller -->
            <RowDefinition Height="Auto" />
            <!-- 5: Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Control Header Bar (Matching Image 1) -->
        <Border Grid.Row="0" Background="#121620" BorderBrush="#232B3A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Title, Plan Selector, V/%/U buttons -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Actions & Tools -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Group -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Combined Broomstick Plot" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Select Plan Dropdown -->
                    <TextBlock Text="Select Plan:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AvailablePlans}" 
                              SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Width="220" Height="28" FontSize="11" 
                              Background="#181E2B" Foreground="#FFFFFF" BorderBrush="#333F54"
                              VerticalContentAlignment="Center" Margin="0,0,12,0" />

                    <!-- Quick Toggles [ ] [V] [%] [U] from reference screen -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Width="28" Height="28" Padding="0" Margin="0,0,2,0" ToolTip="Overview Extents">
                            <materialDesign:PackIcon Kind="CropSquare" Width="14" Height="14" Foreground="#94A3B8" />
                        </Button>
                        <ToggleButton IsChecked="{Binding InvertDepthAxis, Mode=TwoWay}" 
                                      Style="{StaticResource MaterialDesignActionToggleButton}"
                                      Width="28" Height="28" Padding="0" Margin="0,0,2,0" 
                                      ToolTip="Invert Depth Axis (0 at Top / Bottom)">
                            <TextBlock Text="V" FontSize="11" FontWeight="Bold" />
                        </ToggleButton>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Width="28" Height="28" Padding="0" Margin="0,0,2,0" ToolTip="Percentage Drag">
                            <TextBlock Text="%" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Width="28" Height="28" Padding="0" ToolTip="Toggle Unit (klbs / Tonnes)">
                            <TextBlock Text="U" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Right Action Tools -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Reset Zoom -->
                    <Button Command="{Binding ResetZoomCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="28" Padding="8,0" Margin="0,0,6,0"
                            ToolTip="Reset Zoom to Extents">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FitToScreenOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Reset Zoom" FontSize="10.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Data Selector Window (Matching RigStateDocument) -->
                    <Button Command="{Binding OpenDataSelectorCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="28" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Open Data Selector &amp; Field Mapping Window">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TableCog" Width="14" Height="14" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Data Selector" FontSize="10.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Setup & Filter Dialog -->
                    <Button Command="{Binding OpenSetupCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#4F46E5" Foreground="White"
                            Height="28" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Open Broomstick Setup &amp; Filter Criteria">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Broomstick Setup" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Template Manager -->
                    <Button Command="{Binding OpenTemplateManagerCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="28" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Open Broomstick Template Manager">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileTree" Width="14" Height="14" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Templates" FontSize="10.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Save Document Layout -->
                    <Button Command="{Binding SaveDocumentCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#10B981" Foreground="White"
                            Height="28" Padding="10,0" Margin="0,0,4,0"
                            ToolTip="Save Broomstick Setup (Ctrl+S)">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding SaveAsDocumentCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="28" Padding="8,0"
                            ToolTip="Save As New Template...">
                        <materialDesign:PackIcon Kind="ContentSavePlusOutline" Width="14" Height="14" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: TeeChart Plot Canvas & Legend -->
        <Border Grid.Row="1" Background="#000000" BorderBrush="#1E2430" BorderThickness="1" CornerRadius="6,6,0,0" ClipToBounds="True">
            <Grid x:Name="ChartContainer">
                <teechart:TChart x:Name="ChartControl" />

                <!-- Floating Legend Panel on Top-Right (Matching Image 1) -->
                <Border Background="#161C28" BorderBrush="#2E384D" BorderThickness="1" 
                        CornerRadius="4" Padding="10,8" Margin="0,16,16,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Opacity="0.94" MaxHeight="450">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MinWidth="190">
                            <!-- Theoretical Pick up Curves -->
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.2 OHFF" Foreground="#00E5FF" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.25 OHFF" Foreground="#00E5FF" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.3 OHFF" Foreground="#00E5FF" FontSize="10" FontWeight="SemiBold" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.35 OHFF" Foreground="#00E5FF" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.4 OHFF" Foreground="#00E5FF" FontSize="10" Margin="0,1" />

                            <!-- Casing Pick up -->
                            <CheckBox IsChecked="True" Content="Casing - Pick up" Foreground="#B3B8FF" FontSize="10" Margin="0,1" />

                            <!-- Theoretical Rotate (White) -->
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.3 OHFF" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" Margin="0,1" />

                            <!-- Casing Slack off -->
                            <CheckBox IsChecked="True" Content="Casing - Slack off" Foreground="#4DD0E1" FontSize="10" Margin="0,1" />

                            <!-- Theoretical Slack Off Curves -->
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.2 OHFF" Foreground="#00E676" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.25 OHFF" Foreground="#00E676" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.3 OHFF" Foreground="#00E676" FontSize="10" FontWeight="SemiBold" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.35 OHFF" Foreground="#00E676" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="8.5&quot; Hookload Drilling 0.4 OHFF" Foreground="#00E676" FontSize="10" Margin="0,1" />

                            <!-- Actual Calculated Scatter Points -->
                            <Border Height="1" Background="#263042" Margin="0,4,0,4" />
                            <CheckBox IsChecked="True" Content="Pick up" Foreground="#E91E63" FontWeight="Bold" FontSize="10.5" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="Slack Off" Foreground="#2979FF" FontWeight="Bold" FontSize="10.5" Margin="0,1" />
                            <CheckBox IsChecked="True" Content="Rotate" Foreground="#FF9800" FontWeight="Bold" FontSize="10.5" Margin="0,1" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Floating Tooltip Card -->
                <Canvas x:Name="TooltipCanvas" IsHitTestVisible="False">
                    <Border x:Name="SeriesTooltipCard" 
                            Visibility="{Binding IsHoverVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#161C28" BorderBrush="#3B455C" BorderThickness="1" 
                            CornerRadius="4" Padding="10,8" MinWidth="180">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="8" Height="8" Background="{Binding HoverColorHex}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding HoverTypeText}" FontWeight="Bold" FontSize="11.5" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Height="1" Background="#2B354A" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding HoverDepthText, StringFormat='{}Depth: {0}'}" FontSize="10.5" Foreground="#CBD5E1" />
                            <TextBlock Text="{Binding HoverWeightText, StringFormat='{}Weight: {0}'}" FontSize="10.5" Foreground="#E2E8F0" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HoverRigStateText, StringFormat='{}Rig State: {0}'}" FontSize="10.5" Foreground="#10B981" />
                            <TextBlock Text="{Binding HoverDateTimeText, StringFormat='{}Time: {0}'}" FontSize="9.5" Foreground="#94A3B8" />
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- 2: Sub-chart Bar (Highlight Formation Top, Section, View Casing) -->
        <Border Grid.Row="2" Background="#121620" BorderBrush="#1E2430" BorderThickness="1,0,1,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding HighlightFormationTop, Mode=TwoWay}" 
                              Content="Highlight Formation Top" 
                              Foreground="#E2E8F0" FontSize="11" Margin="0,0,24,0" />

                    <TextBlock Text="Section" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ToggleButton IsChecked="{Binding Section, Mode=TwoWay}" 
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                  Margin="0,0,24,0" />

                    <TextBlock Text="View Casing" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ToggleButton IsChecked="{Binding ViewCasing, Mode=TwoWay}" 
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                  Margin="0,0,8,0" />
                    <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14" Foreground="#94A3B8" VerticalAlignment="Center" ToolTip="Casing and liner intervals" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Plotted Points: " FontSize="11" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding LoadedPointsCount, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontSize="11" Foreground="#10B981" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3: Navigation & Range Filter Control Bar (Above dataSelector TrackBar) -->
        <Border Grid.Row="3" Background="#161C28" BorderBrush="#263042" BorderThickness="1,0,1,1" Padding="12,6" Margin="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Preset Dropdown -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Preset Range:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding RangePresets}" 
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              Width="130" Height="26" VerticalContentAlignment="Center" FontSize="11"
                              Background="#1E2430" Foreground="#F1F5F9" BorderBrush="#3B455C" />
                </StackPanel>

                <!-- Center/Right: From - To Single Text DateTime Boxes & Apply Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- TimeLog Controls: Single Text DateTime Boxes -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTimeLog, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="From:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <Border Background="#1E2430" BorderBrush="#3B455C" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBox Text="{Binding FromDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="#F8FAFC"
                                     Width="135" Height="22" FontSize="11" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     ToolTip="Enter Start Date &amp; Time (dd-MM-yyyy HH:mm)" />
                        </Border>

                        <TextBlock Text="To:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <Border Background="#1E2430" BorderBrush="#3B455C" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBox Text="{Binding ToDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="#F8FAFC"
                                     Width="135" Height="22" FontSize="11" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     ToolTip="Enter End Date &amp; Time (dd-MM-yyyy HH:mm)" />
                        </Border>
                    </StackPanel>

                    <!-- DepthLog Controls -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTimeLog, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="From Depth:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <TextBox Text="{Binding FromDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="75" Height="26" FontSize="11" VerticalContentAlignment="Center" 
                                 Background="#1E2430" Foreground="#F1F5F9" BorderBrush="#3B455C" />
                        <TextBlock Text="To Depth:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <TextBox Text="{Binding ToDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="75" Height="26" FontSize="11" VerticalContentAlignment="Center" 
                                 Background="#1E2430" Foreground="#F1F5F9" BorderBrush="#3B455C" />
                    </StackPanel>

                    <Button Command="{Binding ApplyRangeFilterCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#1976D2" Foreground="White"
                            Height="26" Padding="12,0" Margin="10,0,0,0"
                            ToolTip="Query and filter Broomstick plot for this window">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Apply" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4: Data Selector Range TrackBar Scroller -->
        <controls:RangeTrackBarControl Grid.Row="4" Margin="0,4,0,4"
                                       Minimum="{Binding TrackBarMin}"
                                       Maximum="{Binding TrackBarMax}"
                                       SelectionStart="{Binding TrackBarSelectionStart, Mode=TwoWay}"
                                       SelectionEnd="{Binding TrackBarSelectionEnd, Mode=TwoWay}"
                                       IsTimeLog="{Binding IsTimeLog}"
                                       OverviewPoints="{Binding TrackBarOverviewPoints}"
                                       OverviewChannelName="{Binding TrackBarOverviewChannelName}"
                                       OverviewStroke="{Binding TrackBarOverviewBrush}"
                                       RangeChanged="OnRangeTrackBarChanged" />

        <!-- 5: Bottom Status Bar -->
        <Border Grid.Row="5" Background="#0C0F17" BorderBrush="#1C2433" BorderThickness="1" CornerRadius="0,0,4,4" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Plan: " FontSize="10.5" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding SelectedPlan.Name, FallbackValue='(None)'}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,16,0" />

                    <TextBlock Text="Well: " FontSize="10.5" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding WellId, FallbackValue='(None)'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,16,0" />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" FontStyle="Italic" Foreground="#94A3B8" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="TeeChart WPF • Broomstick Engine" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

