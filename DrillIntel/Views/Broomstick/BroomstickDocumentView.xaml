<UserControl x:Class="DrillIntel.Views.Broomstick.BroomstickDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:teechart="clr-namespace:Steema.TeeChart.WPF;assembly=TeeChart.Business.WPF"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels.Broomstick"
             xmlns:controls="clr-namespace:DrillIntel.Controls"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:BroomstickDocumentViewModel}"
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesignPaper}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <Style x:Key="BarLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Clean Modern Light ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3"
                                Margin="2,1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                                <Setter Property="Foreground" Value="#1976D2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1976D2" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1565C0" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Prominent Wide Boxed ComboBox Style matching Red Box Reference -->
        <Style x:Key="BroomstickPlanComboBoxStyle" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- ToggleButton covering entire box width with distinct border and arrow affordance -->
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Right Arrow Section with separator -->
                                                <Border x:Name="ArrowBox" 
                                                        Grid.Column="1" 
                                                        BorderBrush="#CBD5E1" 
                                                        BorderThickness="1,0,0,0" 
                                                        Background="#F8FAFC" 
                                                        CornerRadius="0,3,3,0">
                                                    <Path x:Name="Arrow" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center" 
                                                          Data="M 0 0 L 4.5 4.5 L 9 0 Z" 
                                                          Fill="#475569" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#1976D2" />
                                                <Setter TargetName="ArrowBox" Property="Background" Value="#EFF6FF" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="#1976D2" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#1565C0" />
                                                <Setter TargetName="ArrowBox" Property="Background" Value="#DBEAFE" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="#1565C0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Selected item content displayed inside box with safe padding -->
                            <Border Margin="10,0,32,0" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <ContentPresenter x:Name="ContentSite" 
                                                  IsHitTestVisible="False" 
                                                  Content="{TemplateBinding SelectionBoxItem}" 
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                  TextElement.Foreground="#0F172A"
                                                  TextElement.FontWeight="SemiBold"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />
                            </Border>

                            <!-- Dropdown Popup matching exact box width with subtle shadow -->
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#FFFFFF" 
                                            BorderBrush="#94A3B8" 
                                            BorderThickness="1.5" 
                                            CornerRadius="4" 
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            Margin="0,3,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.18" Color="#000000" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True" MaxHeight="300">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="50" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default ComboBox Style based on BroomstickPlanComboBoxStyle -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource BroomstickPlanComboBoxStyle}" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- 0: Control Header (Title, Right Actions, and Plan Selector Bar) -->
            <RowDefinition Height="Auto" />
            <!-- 1: TeeChart Plot Canvas with Floating Legend & Hover Tooltip -->
            <RowDefinition Height="*" />
            <!-- 2: Navigation & Range Filter Control Bar (Above dataSelector TrackBar) -->
            <RowDefinition Height="Auto" />
            <!-- 3: Data Selector Range TrackBar Scroller -->
            <RowDefinition Height="Auto" />
            <!-- 4: Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Control Header Bar (Clean 2-line layout preventing crowding on any screen size) -->
        <Border Grid.Row="0" Background="#F4F3F8" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Line 1: Title and Right Action Tools -->
                    <RowDefinition Height="Auto" />
                    <!-- Line 2: Plan Selector Bar -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Title on Left, Action Tools on Right -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Title -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: Actions & Tools -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ChartScatterPlot" Width="22" Height="22" Foreground="#512DA8" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Combined Broomstick Plot" FontSize="14" FontWeight="Bold" Foreground="#311B92" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right Action Tools -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Reset Zoom -->
                        <Button Command="{Binding ResetZoomCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="28" Padding="8,0" Margin="0,0,6,0"
                                ToolTip="Reset Zoom to Extents">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FitToScreenOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Reset Zoom" FontSize="10.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Data Selector Window (Matching RigStateDocument) -->
                        <Button Command="{Binding OpenDataSelectorCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="28" Padding="10,0" Margin="0,0,6,0"
                                ToolTip="Open Data Selector &amp; Field Mapping Window">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableCog" Width="14" Height="14" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Data Selector" FontSize="10.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Calculate Points Button -->
                        <Button Command="{Binding RecalculatePointsCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#059669" Foreground="White"
                                Height="28" Padding="10,0" Margin="0,0,6,0"
                                ToolTip="Recalculate Broomstick Points from Well Log">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Calculator" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Calculate Points" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Setup & Filter Dialog -->
                        <Button Command="{Binding OpenSetupCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#512DA8" Foreground="White"
                                Height="28" Padding="10,0" Margin="0,0,6,0"
                                ToolTip="Open Data Filter Criteria">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterVariant" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Data Filter" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Broomstick Setup Dialog (Project Configuration Profile Settings) -->
                        <Button Command="{Binding OpenBroomstickSetupCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#1976D2" Foreground="White"
                                Height="28" Padding="10,0" Margin="0,0,6,0"
                                ToolTip="Open Broomstick Setup (Project Configuration Profile Settings)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TuneVariant" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Broomstick Setup" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Template Manager -->
                        <Button Command="{Binding OpenTemplateManagerCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="28" Padding="10,0" Margin="0,0,6,0"
                                ToolTip="Open Broomstick Template Manager">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileTree" Width="14" Height="14" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Templates" FontSize="10.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Save Document Layout -->
                        <Button Command="{Binding SaveDocumentCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#10B981" Foreground="White"
                                Height="28" Padding="10,0" Margin="0,0,4,0"
                                ToolTip="Save Broomstick Setup (Ctrl+S)">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center" />
                        </Button>

                        <Button Command="{Binding SaveAsDocumentCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="28" Padding="8,0"
                                ToolTip="Save As New Template...">
                            <materialDesign:PackIcon Kind="ContentSavePlusOutline" Width="14" Height="14" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Plan Selector Bar (Dedicated line with generous width, zero crowding) -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Plan Dropdown -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <!-- Well & Plotted telemetry -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Select Plan:" FontSize="11.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Style="{x:Null}"
                                      ItemsSource="{Binding AvailablePlans}" 
                                      SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                                      Width="320" MinWidth="320" MaxWidth="900" Height="30" FontSize="11.5" 
                                      VerticalContentAlignment="Center" Margin="0,0,14,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Well: " FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                            <TextBlock Text="{Binding WellName, FallbackValue='(None)'}" FontSize="11" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,14,0" />
                            <TextBlock Text="Plotted Points: " FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                            <TextBlock Text="{Binding LoadedPointsCount, StringFormat='{}{0:N0}'}" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 1: TeeChart Plot Canvas & Legend -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" ClipToBounds="True">
            <Grid x:Name="ChartContainer">
                <teechart:TChart x:Name="ChartControl" />

                <!-- Floating Legend Panel on Top-Right -->
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                        CornerRadius="6" Padding="10,8" Margin="0,16,16,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Opacity="0.96" MaxHeight="450">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.18" Color="#000000" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MinWidth="190">
                            <!-- Theoretical Pick up Curves -->
                            <CheckBox IsChecked="{Binding IsPlan02Visible, Mode=TwoWay}" Content="{Binding Plan02LegendText}" Foreground="#0097A7" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsPlan025Visible, Mode=TwoWay}" Content="{Binding Plan025LegendText}" Foreground="#0288D1" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsPlan03Visible, Mode=TwoWay}" Content="{Binding Plan03LegendText}" Foreground="#1976D2" FontSize="10" FontWeight="SemiBold" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsPlan035Visible, Mode=TwoWay}" Content="{Binding Plan035LegendText}" Foreground="#1565C0" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsPlan04Visible, Mode=TwoWay}" Content="{Binding Plan04LegendText}" Foreground="#0D47A1" FontSize="10" Margin="0,1" />

                            <!-- Casing Pick up -->
                            <CheckBox IsChecked="{Binding IsCasingPuVisible, Mode=TwoWay}" Content="Casing - Pick up" Foreground="#7B1FA2" FontSize="10" Margin="0,1" />

                            <!-- Theoretical Rotate (Charcoal on White) -->
                            <CheckBox IsChecked="{Binding IsRotTheoryVisible, Mode=TwoWay}" Content="{Binding RotTheoryLegendText}" Foreground="#212121" FontSize="10" FontWeight="SemiBold" Margin="0,1" />

                            <!-- Casing Slack off -->
                            <CheckBox IsChecked="{Binding IsCasingSoVisible, Mode=TwoWay}" Content="Casing - Slack off" Foreground="#D84315" FontSize="10" Margin="0,1" />

                            <!-- Theoretical Slack Off Curves -->
                            <CheckBox IsChecked="{Binding IsSo02Visible, Mode=TwoWay}" Content="{Binding So02LegendText}" Foreground="#4CAF50" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsSo025Visible, Mode=TwoWay}" Content="{Binding So025LegendText}" Foreground="#43A047" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsSo03Visible, Mode=TwoWay}" Content="{Binding So03LegendText}" Foreground="#388E3C" FontSize="10" FontWeight="SemiBold" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsSo035Visible, Mode=TwoWay}" Content="{Binding So035LegendText}" Foreground="#2E7D32" FontSize="10" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsSo04Visible, Mode=TwoWay}" Content="{Binding So04LegendText}" Foreground="#1B5E20" FontSize="10" Margin="0,1" />

                            <!-- Actual Calculated Scatter Points -->
                            <Border Height="1" Background="#E2E8F0" Margin="0,4,0,4" />
                            <CheckBox IsChecked="{Binding IsActualPuVisible, Mode=TwoWay}" Content="Pick up" Foreground="#E11D48" FontWeight="Bold" FontSize="10.5" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsActualSoVisible, Mode=TwoWay}" Content="Slack Off" Foreground="#2563EB" FontWeight="Bold" FontSize="10.5" Margin="0,1" />
                            <CheckBox IsChecked="{Binding IsActualRotVisible, Mode=TwoWay}" Content="Rotate" Foreground="#D97706" FontWeight="Bold" FontSize="10.5" Margin="0,1" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Floating Tooltip Card -->
                <Canvas x:Name="TooltipCanvas" IsHitTestVisible="False">
                    <Border x:Name="SeriesTooltipCard" 
                            Visibility="{Binding IsHoverVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                            CornerRadius="6" Padding="10,8" MinWidth="180">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.18" Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="8" Height="8" Background="{Binding HoverColorHex}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding HoverTypeText}" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Height="1" Background="#E2E8F0" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding HoverDepthText, StringFormat='{}Depth: {0}'}" FontSize="10.5" Foreground="#475569" />
                            <TextBlock Text="{Binding HoverWeightText, StringFormat='{}Weight: {0}'}" FontSize="10.5" Foreground="#0F172A" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HoverRigStateText, StringFormat='{}Rig State: {0}'}" FontSize="10.5" Foreground="#15803D" />
                            <TextBlock Text="{Binding HoverDateTimeText, StringFormat='{}Time: {0}'}" FontSize="9.5" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- 2: Navigation & Date Range Control Bar (Above dataSelector TrackBar) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Preset Dropdown -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Preset Range:" Style="{StaticResource BarLabel}" />
                    <ComboBox Style="{x:Null}" ItemsSource="{Binding RangePresets}" 
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              Width="160" Height="28" VerticalContentAlignment="Center" FontSize="11" />
                </StackPanel>

                <!-- Center/Right: From - To Single Text DateTime Boxes & Apply Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- TimeLog Controls: Single Text DateTime Boxes -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTimeLog, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="From:" Style="{StaticResource BarLabel}" Margin="12,0,4,0" />
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBox Text="{Binding FromDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="#1E293B"
                                     Width="135" Height="24" FontSize="11" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     ToolTip="Enter Start Date &amp; Time (dd-MM-yyyy HH:mm)" />
                        </Border>

                        <TextBlock Text="To:" Style="{StaticResource BarLabel}" Margin="12,0,4,0" />
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBox Text="{Binding ToDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="#1E293B"
                                     Width="135" Height="24" FontSize="11" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     ToolTip="Enter End Date &amp; Time (dd-MM-yyyy HH:mm)" />
                        </Border>
                    </StackPanel>

                    <!-- DepthLog Controls -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTimeLog, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="From Depth:" Style="{StaticResource BarLabel}" Margin="12,0,4,0" />
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBox Text="{Binding FromDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="#1E293B"
                                     Width="75" Height="24" FontSize="11" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                        </Border>

                        <TextBlock Text="To Depth:" Style="{StaticResource BarLabel}" Margin="12,0,4,0" />
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBox Text="{Binding ToDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="#1E293B"
                                     Width="75" Height="24" FontSize="11" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <Button Command="{Binding ApplyRangeFilterCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#1976D2" Foreground="White"
                            Height="28" Padding="14,0" Margin="10,0,0,0"
                            ToolTip="Query and filter Broomstick plot for this window">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Apply" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3: Data Selector Range TrackBar Scroller -->
        <controls:RangeTrackBarControl Grid.Row="3" Margin="0,0,0,4"
                                       Minimum="{Binding TrackBarMin}"
                                       Maximum="{Binding TrackBarMax}"
                                       SelectionStart="{Binding TrackBarSelectionStart, Mode=TwoWay}"
                                       SelectionEnd="{Binding TrackBarSelectionEnd, Mode=TwoWay}"
                                       IsTimeLog="{Binding IsTimeLog}"
                                       OverviewPoints="{Binding TrackBarOverviewPoints}"
                                       OverviewChannelName="{Binding TrackBarOverviewChannelName}"
                                       OverviewStroke="{Binding TrackBarOverviewBrush}"
                                       RangeChanged="OnRangeTrackBarChanged" />

        <!-- 4: Bottom Status Bar -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Plan: " FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock Text="{Binding SelectedPlan.Name, FallbackValue='(None)'}" FontSize="11" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,16,0" />

                    <TextBlock Text="Well: " FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock Text="{Binding WellId, FallbackValue='(None)'}" FontSize="11" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,16,0" />

                    <TextBlock Text="Plotted Points: " FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock Text="{Binding LoadedPointsCount, StringFormat='{}{0:N0}'}" FontSize="11" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,16,0" />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontStyle="Italic" Foreground="#64748B" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="TeeChart WPF • Broomstick Engine" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>


