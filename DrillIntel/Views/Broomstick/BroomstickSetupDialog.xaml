                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Hookload Rig States" Style="{StaticResource PanelHeaderStyle}" />

                                <!-- Search Box -->
                                <TextBox Grid.Row="1" Text="{Binding RigStateSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource LightInputBox}" Margin="0,0,0,8"
                                         materialDesign:HintAssist.Hint="Search rig states..." />

                                <!-- Checklist Table -->
                                <Border Grid.Row="2" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RigStates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,5" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <Border Grid.Column="1" Width="10" Height="10" Background="{Binding ColorHex}" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: BroomStick Plot Settings -->
            <TabItem Header="BroomStick Plot Settings" FontSize="12" FontWeight="SemiBold">
                <Border Style="{StaticResource ParamCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Theoretical Friction Factor Curves (OHFF)" Style="{StaticResource PanelHeaderStyle}" />
                        <TextBlock Text="Calculates open-hole drag and torque based on selected plan." FontSize="11.5" Foreground="#616161" Margin="0,0,0,12" />
                        <TextBlock Text="Standard OHFF Curves: 0.20, 0.25, 0.30, 0.35, 0.40" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 2: Action Footer Strip -->
        <Border Grid.Row="2" Padding="0,12,0,0" Margin="0,10,0,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding SaveAndApplyCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="34" Padding="20,0" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="OK" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding CancelCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="34" Padding="18,0">
                    <TextBlock Text="Cancel" FontSize="12" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
