<Window x:Class="DrillIntel.Views.Broomstick.BroomstickSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels.Broomstick"
        xmlns:conv="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:BroomstickSetupViewModel}"
        Title="Broomstick Setup"
        Width="1050" Height="680"
        MinWidth="950" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#616161" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="LightInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LightComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ParamCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Tabs & Content -->
            <RowDefinition Height="*" />
            <!-- 2: Action Buttons Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Top Header Strip -->
        <Border Grid.Row="0" Background="#F4F3F8" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="TuneVariant" Width="26" Height="26" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Broomstick Setup" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Border Background="#EDE7F6" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 1: Tab Control for Setup -->
        <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="Standard">
            <!-- TAB 1: Filter Criteria -->
            <TabItem Header="Filter Criteria" FontSize="12" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Col 0: Downsampling & Casing Formatting -->
                            <ColumnDefinition Width="1*" />
                            <!-- Col 1: Points Style & Broomstick Formatting -->
                            <ColumnDefinition Width="1*" />
                            <!-- Col 2: Hookload Rig States List -->
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0 -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Data Down Sampling -->
                            <Border Style="{StaticResource ParamCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Data Down Sampling" Style="{StaticResource PanelHeaderStyle}" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Down Sample Data On" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox SelectedIndex="{Binding DownSampleOn}" Style="{StaticResource LightComboBox}">
                                                <ComboBoxItem Content="By Depth" />
                                                <ComboBoxItem Content="By Time" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Data points per" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding DataPointsPer}" Style="{StaticResource LightInputBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Grouping Function -->
                                    <TextBlock Text="Grouping Function" Style="{StaticResource FieldLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox IsChecked="{Binding GroupMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Min" FontSize="11.5" Margin="0,0,12,0" />
                                        <CheckBox IsChecked="{Binding GroupMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Max" FontSize="11.5" Margin="0,0,12,0" />
                                        <CheckBox IsChecked="{Binding GroupAvg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Avg" FontSize="11.5" />
                                    </StackPanel>

                                    <!-- Hookload Range Filter -->
                                    <CheckBox IsChecked="{Binding FilterByHookloadRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Filter By Hookload Range" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4" />
                                    <Grid Margin="16,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Min" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding MinHookload}" Style="{StaticResource LightInputBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Max" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding MaxHookload}" Style="{StaticResource LightInputBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Depth Intervals -->
                                    <CheckBox IsChecked="{Binding FilterByDepthIntervals, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Filter By Depth Intervals" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4" />
                                    <StackPanel Margin="16,0,0,10">
                                        <TextBlock Text="Depth Interval (ft)" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding DepthInterval}" Style="{StaticResource LightInputBox}" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Filter data points outside (% mean)" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding OutlierPercentMean}" Style="{StaticResource LightInputBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Filter Method" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding AvailableFilterMethods}" SelectedItem="{Binding FilterMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LightComboBox}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Casing Points Formatting -->
                            <Border Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="Casing Points Formatting" Style="{StaticResource PanelHeaderStyle}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox IsChecked="{Binding ShowCasingPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Show Casing Points" FontSize="11.5" Margin="0,0,12,0" />
                                        <CheckBox IsChecked="{Binding ShowCasingMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Show Max Value" FontSize="11.5" Margin="0,0,12,0" />
                                        <CheckBox IsChecked="{Binding ShowCasingMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Show Min Value" FontSize="11.5" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Casing Point Style" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding AvailableCasingPointStyles}" SelectedItem="{Binding CasingPointStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LightComboBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                            <TextBlock Text="Point Size" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding CasingPointSize}" Style="{StaticResource LightInputBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="Transparency" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding CasingPointTransparency}" Style="{StaticResource LightInputBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <TextBlock Text="Pickup Color:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Border Width="24" Height="16" Background="#B3B8FF" CornerRadius="2" BorderBrush="#BDBDBD" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Slackoff Color:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Border Width="24" Height="16" Background="#4DD0E1" CornerRadius="2" BorderBrush="#BDBDBD" BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Column 1 -->
                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <!-- Points Style -->
                            <Border Style="{StaticResource ParamCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Points Style" Style="{StaticResource PanelHeaderStyle}" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Style" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding AvailablePointStyles}" SelectedItem="{Binding PointsStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LightComboBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Size" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding PointSize}" Style="{StaticResource LightInputBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Points Transparency" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding PointTransparency}" Style="{StaticResource LightInputBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Line Thickness" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding LineThickness}" Style="{StaticResource LightInputBox}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Plot Time Data -->
                            <Border Style="{StaticResource ParamCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Plot Time Data" Style="{StaticResource PanelHeaderStyle}" />
                                    <CheckBox IsChecked="{Binding PlotTimeData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Plot Time Data" FontSize="11.5" Margin="0,0,0,6" />
                                    <CheckBox IsChecked="{Binding ShowLegend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Show Legend" FontSize="11.5" Margin="0,0,0,6" />
                                    <CheckBox IsChecked="{Binding PlotMakeupTorque, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Plot Makeup Torque" FontSize="11.5" Margin="0,0,0,6" />
                                    <CheckBox IsChecked="{Binding PlotTorqueLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Plot Torque Limit" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <!-- BroomStick Points Formatting -->
                            <Border Style="{StaticResource ParamCard}">
                                <StackPanel>
                                    <TextBlock Text="BroomStick Points Formatting" Style="{StaticResource PanelHeaderStyle}" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Pickup Colors" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="30" Height="18" Background="#E91E63" CornerRadius="2" BorderBrush="#BDBDBD" BorderThickness="1" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Pickup Static Colors" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="30" Height="18" Background="#00E676" CornerRadius="2" BorderBrush="#BDBDBD" BorderThickness="1" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Slackoff Color" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="30" Height="18" Background="#2979FF" CornerRadius="2" BorderBrush="#BDBDBD" BorderThickness="1" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Slackoff Static Color" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="30" Height="18" Background="#FFEA00" CornerRadius="2" BorderBrush="#BDBDBD" BorderThickness="1" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ROB Color (Rotate on Bottom)" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="30" Height="18" Background="#FF9800" CornerRadius="2" BorderBrush="#BDBDBD" BorderThickness="1" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="On Bottom Torque Color" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="30" Height="18" Background="#FF80AB" CornerRadius="2" BorderBrush="#BDBDBD" BorderThickness="1" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Off Bottom Torque Color" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="30" Height="18" Background="#80D8FF" CornerRadius="2" BorderBrush="#BDBDBD" BorderThickness="1" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Column 2: Hookload Rig States Checklist -->
                        <Border Grid.Column="2" Style="{StaticResource ParamCard}" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Hookload Rig States" Style="{StaticResource PanelHeaderStyle}" />

                                <!-- Search Box -->
                                <TextBox Grid.Row="1" Text="{Binding RigStateSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource LightInputBox}" Margin="0,0,0,8"
                                         materialDesign:HintAssist.Hint="Search rig states..." />

                                <!-- Checklist Table -->
                                <Border Grid.Row="2" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RigStates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,5" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <Border Grid.Column="1" Width="10" Height="10" Background="{Binding ColorHex}" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>


        </TabControl>

        <!-- 2: Action Footer Strip -->
        <Border Grid.Row="2" Padding="0,12,0,0" Margin="0,10,0,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding SaveAndApplyCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="34" Padding="20,0" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="OK" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding CancelCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="34" Padding="18,0">
                    <TextBlock Text="Cancel" FontSize="12" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
