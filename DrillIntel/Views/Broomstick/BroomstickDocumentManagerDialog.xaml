<Window x:Class="DrillIntel.Views.Broomstick.BroomstickDocumentManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels.Broomstick"
        xmlns:conv="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:BroomstickDocumentManagerViewModel}"
        Title="Broomstick Document Manager"
        Width="920" Height="600"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <!-- TreeView Node Styles -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="30,2,8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                SnapsToDevicePixels="True">
                            <Grid>
                                <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Left" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="28,0,8,0" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeView Hierarchical Templates -->
        <HierarchicalDataTemplate DataType="{x:Type viewmodels:BroomstickDocumentTreeGroupNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,3" Visibility="{Binding IsVisibleInFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center" />
                <Border Background="#E0E7FF" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DocumentCount}" FontSize="10" FontWeight="Bold" Foreground="#4338CA" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:BroomstickDocumentTreeNode}">
            <Border Padding="4,2" Margin="0,1" CornerRadius="4" x:Name="DocLeafBorder"
                    Visibility="{Binding IsVisibleInFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="ChartScatterPlot" Width="15" Height="15" Foreground="#0EA5E9" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBlock Grid.Column="1" Text="{Binding DocumentName}" FontSize="11.5" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <Border Grid.Column="2" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Star" Width="11" Height="11" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock Text="DEFAULT" FontSize="9" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header & Action Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Master-Detail Body -->
            <RowDefinition Height="*" />
            <!-- 2: Footer Strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header Strip -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#EEF2FF" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ChartScatterPlot" Width="22" Height="22" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Broomstick Document Manager" FontSize="15" FontWeight="Bold" Foreground="#1E1B4B" />
                            <Border Background="#E0E7FF" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AllDocumentNodes.Count, StringFormat='{}{0} templates'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#4338CA" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Manage, organize, and inspect saved Broomstick plot templates." FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Search Box -->
                <TextBox Grid.Column="2" 
                         Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource SearchTextBoxStyle}"
                         Width="240" VerticalAlignment="Center"
                         materialDesign:HintAssist.Hint="Search templates, plans, wells..." />
            </Grid>
        </Border>

        <!-- 1: Master-Detail Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Master TreeView Pane -->
                <ColumnDefinition Width="3*" MinWidth="360" />
                <!-- Grid Splitter -->
                <ColumnDefinition Width="10" />
                <!-- Detail Inspector Pane -->
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Master TreeView Card -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Action Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- TreeView -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Action Toolbar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding NewTemplateCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="28" Padding="8,0" Margin="0,0,4,0"
                                    ToolTip="Create New Template">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,3,0" />
                                    <TextBlock Text="New" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding RenameTemplateCommand}" 
                                    IsEnabled="{Binding HasSelection}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="28" Padding="8,0" Margin="0,0,4,0"
                                    ToolTip="Rename Selected Template">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,3,0" />
                                    <TextBlock Text="Rename" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SetDefaultCommand}" 
                                    IsEnabled="{Binding CanSetDefaultSelection}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="28" Padding="8,0" Margin="0,0,4,0"
                                    ToolTip="Set as Default Template for Well">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StarOutline" Width="14" Height="14" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,3,0" />
                                    <TextBlock Text="Set Default" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding DuplicateTemplateCommand}" 
                                    IsEnabled="{Binding HasSelection}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="28" Padding="8,0" Margin="0,0,4,0"
                                    ToolTip="Duplicate Selected Template">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,3,0" />
                                    <TextBlock Text="Duplicate" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding DeleteTemplateCommand}" 
                                    IsEnabled="{Binding CanDeleteSelection}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="28" Padding="8,0" Margin="0,0,4,0"
                                    ToolTip="Delete Selected Template">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,3,0" />
                                    <TextBlock Text="Delete" FontSize="11" FontWeight="Medium" Foreground="#DC2626" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- TreeView -->
                    <TreeView Grid.Row="1" 
                              x:Name="TemplatesTreeView"
                              ItemsSource="{Binding TreeRoots}" 
                              BorderThickness="0" 
                              Padding="6"
                              SelectedItemChanged="OnTreeViewSelectedItemChanged"
                              MouseDoubleClick="OnTreeViewMouseDoubleClick" />
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- Right: Detail Inspector Card -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Details Content -->
                        <RowDefinition Height="*" />
                        <!-- Action Buttons -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Inspector Fields -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="TEMPLATE DETAILS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />

                            <TextBlock Text="{Binding SelectedDocumentNode.DocumentName}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap" />

                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,6,0,8" HorizontalAlignment="Left"
                                    Visibility="{Binding SelectedDocumentNode.IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Star" Width="12" Height="12" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,3,0" />
                                    <TextBlock Text="Default Project Template" FontSize="10" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding SelectedDocumentNode.Description, FallbackValue='(No description provided)'}" 
                                       FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <Border Height="1" Background="#E2E8F0" Margin="0,0,0,12" />

                            <!-- Relational Metadata -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bound Plan ID:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocumentNode.PlanDisplay, FallbackValue='(None)'}" FontSize="11" FontWeight="Bold" Foreground="#0284C7" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Well ID:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocumentNode.WellDisplay, FallbackValue='(None)'}" FontSize="11" Foreground="#1E293B" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Log ID:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocumentNode.LogDisplay, FallbackValue='(None)'}" FontSize="11" Foreground="#1E293B" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bound Profile:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocumentNode.ProfileDisplay, FallbackValue='(Default)'}" FontSize="11" Foreground="#4F46E5" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Created By:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocumentNode.CreatedBy}" FontSize="11" Foreground="#1E293B" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Modified:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocumentNode.ModifiedDate, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" FontSize="11" Foreground="#1E293B" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Storage Table:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="VMX_BROOMSTICK_TEMPLATES" FontSize="10.5" FontFamily="Consolas" Foreground="#475569" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Open in Workspace Action -->
                    <Border Grid.Row="1" Padding="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Button Command="{Binding OpenSelectedCommand}" 
                                IsEnabled="{Binding HasSelection}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#4F46E5" Foreground="White"
                                Height="36" Width="Auto">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Open Template in Workspace" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 2: Footer Strip -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
            <Button Content="Close" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="14,0" HorizontalAlignment="Right" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>

