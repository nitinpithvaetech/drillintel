<Window x:Class="DrillIntel.Views.AddTrackChannelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:AddTrackChannelViewModel}"
        Title="{Binding Title, FallbackValue='Add Channel to Chart'}"
        Width="740" Height="780"
        MinWidth="680" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <!-- Field Label Style -->
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Form TextBox Style -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#512DA8" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Form Body ScrollViewer -->
            <RowDefinition Height="*" />
            <!-- 2: Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Matching RecalculateRigStateWindow & Other Dialogs -->
        <Border Grid.Row="0" Background="#F4F3F8" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0" Kind="ChartTimelineVariant" Width="36" Height="36" Foreground="#512DA8" VerticalAlignment="Center" Margin="0,0,14,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#311B92" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#616161" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <!-- Group 1: Channel & Target Track -->
                <GroupBox Header="1. Channel Identification &amp; Target Track" Margin="0,0,0,12" materialDesign:ElevationAssist.Elevation="Dp1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="130" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search Filter -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" 
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormTextBox}"
                                     materialDesign:HintAssist.Hint="Type to search available curves..." />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Target Track:" Style="{StaticResource InputLabel}" />
                                <ComboBox ItemsSource="{Binding AvailableTracks}" 
                                          SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                          Height="32" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Available Channels Grid -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding FilteredChannels}"
                                  SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="1"
                                  Background="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mnemonic" Binding="{Binding Mnemonic}" FontWeight="Bold" Width="120" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" />
                                <DataGridTextColumn Header="Min" Binding="{Binding MinValue, StringFormat='{}{0:F2}'}" Width="80" />
                                <DataGridTextColumn Header="Max" Binding="{Binding MaxValue, StringFormat='{}{0:F2}'}" Width="80" />
                                <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Channel Display Customization -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mnemonic:" Style="{StaticResource InputLabel}" />
                                <TextBox Text="{Binding Mnemonic, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Curve Title / Legend:" Style="{StaticResource InputLabel}" />
                                <TextBox Text="{Binding ChannelTitle, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Unit:" Style="{StaticResource InputLabel}" />
                                <TextBox Text="{Binding Unit, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- Group 2: Series Type, Colors & Markers -->
                <GroupBox Header="2. Chart Type &amp; Visual Styling" Margin="0,0,0,12" materialDesign:ElevationAssist.Elevation="Dp1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Series Type & Line Settings -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Chart Series Type:" Style="{StaticResource InputLabel}" />
                                <ComboBox ItemsSource="{Binding AvailableSeriesTypes}" 
                                          SelectedItem="{Binding SelectedSeriesType, Mode=TwoWay}"
                                          Height="32" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Line Width:" Style="{StaticResource InputLabel}" />
                                <TextBox Text="{Binding LineWidth, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Line Style:" Style="{StaticResource InputLabel}" />
                                <ComboBox ItemsSource="{Binding AvailableLineStyles}" 
                                          SelectedItem="{Binding SelectedLineStyle, Mode=TwoWay}"
                                          Height="32" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Line Color:" Style="{StaticResource InputLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding LineColorHex, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                    <Button Grid.Column="2" Command="{Binding PickLineColorCommand}" Height="30" Width="36" Padding="0" ToolTip="Pick Color">
                                        <Border Width="24" Height="20" Background="{Binding LineColorHex}" CornerRadius="3" BorderBrush="#757575" BorderThickness="1" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Point Marker Settings -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Point Style:" Style="{StaticResource InputLabel}" />
                                <ComboBox ItemsSource="{Binding AvailablePointStyles}" 
                                          SelectedItem="{Binding SelectedPointStyle, Mode=TwoWay}"
                                          Height="32" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Point Size:" Style="{StaticResource InputLabel}" />
                                <TextBox Text="{Binding PointSize, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Point Fill:" Style="{StaticResource InputLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding PointFillColorHex, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                    <Button Grid.Column="2" Command="{Binding PickPointFillColorCommand}" Height="30" Width="36" Padding="0">
                                        <Border Width="24" Height="20" Background="{Binding PointFillColorHex}" CornerRadius="3" BorderBrush="#757575" BorderThickness="1" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Point Border:" Style="{StaticResource InputLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding PointBorderColorHex, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                    <Button Grid.Column="2" Command="{Binding PickPointBorderColorCommand}" Height="30" Width="36" Padding="0">
                                        <Border Width="24" Height="20" Background="{Binding PointBorderColorHex}" CornerRadius="3" BorderBrush="#757575" BorderThickness="1" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Rig State Shading Toggle -->
                        <Border Grid.Row="2" Margin="0,12,0,0" Background="#EDE7F6" CornerRadius="6" Padding="10">
                            <CheckBox IsChecked="{Binding ColorCodeAsRigState, Mode=TwoWay}" 
                                      VerticalContentAlignment="Center"
                                      Foreground="#311B92" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="#512DA8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Color-code curve points by Rig State (Drilling, Sliding, Connection, etc.)" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </Grid>
                </GroupBox>

                <!-- Group 3: Font & Axis Properties (RTAxis) -->
                <GroupBox Header="3. Font &amp; Axis Scale Properties" Margin="0,0,0,8" materialDesign:ElevationAssist.Elevation="Dp1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Font Settings -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Font Name:" Style="{StaticResource InputLabel}" />
                                <ComboBox ItemsSource="{Binding AvailableFonts}" 
                                          SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                          Height="32" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Font Size:" Style="{StaticResource InputLabel}" />
                                <TextBox Text="{Binding FontSize, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Font Color:" Style="{StaticResource InputLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FontColorHex, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                    <Button Grid.Column="2" Command="{Binding PickFontColorCommand}" Height="30" Width="36" Padding="0">
                                        <Border Width="24" Height="20" Background="{Binding FontColorHex}" CornerRadius="3" BorderBrush="#757575" BorderThickness="1" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox Content="Bold" IsChecked="{Binding FontBold, Mode=TwoWay}" Margin="0,0,10,0" FontWeight="SemiBold" />
                                <CheckBox Content="Italic" IsChecked="{Binding FontItalic, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <!-- Axis Limits & Grids -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Content="Auto Scale" IsChecked="{Binding AutoScale, Mode=TwoWay}" VerticalAlignment="Center" FontWeight="SemiBold" />

                            <StackPanel Grid.Column="2" IsEnabled="{Binding AutoScale, Converter={StaticResource InverseBooleanConverter}}">
                                <TextBlock Text="Min Scale:" Style="{StaticResource InputLabel}" />
                                <TextBox Text="{Binding AxisMin, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" IsEnabled="{Binding AutoScale, Converter={StaticResource InverseBooleanConverter}}">
                                <TextBlock Text="Max Scale:" Style="{StaticResource InputLabel}" />
                                <TextBox Text="{Binding AxisMax, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                <CheckBox Content="Inverted Scale" IsChecked="{Binding Inverted, Mode=TwoWay}" Margin="0,0,0,4" />
                                <CheckBox Content="Logarithmic" IsChecked="{Binding Logarithmic, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="8" VerticalAlignment="Center">
                                <CheckBox Content="Major Grids" IsChecked="{Binding ShowMajorGrids, Mode=TwoWay}" Margin="0,0,0,4" />
                                <CheckBox Content="Minor Grids" IsChecked="{Binding ShowMinorGrids, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons: Cancel and Add Channel -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" 
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Width="100" Margin="0,0,10,0" />
                <Button Content="Add Channel" 
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#512DA8" Foreground="White"
                        Width="130" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
