<UserControl x:Class="DrillIntel.Views.WellInformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:WellInformationViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#F1F5F9"
             FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif, Arial">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <!-- Card Section Header Title -->
        <Style x:Key="CardHeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1565C0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>

        <!-- Sub-section Header inside Card -->
        <Style x:Key="SubSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="2,3,0,2" />
        </Style>

        <!-- Mock Card Outer Border Style (Compact) -->
        <Style x:Key="MockCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Boxed Input TextBox Style (Compact 25px) -->
        <Style x:Key="BoxedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1565C0" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boxed ComboBox Style (Compact 25px) -->
        <Style x:Key="BoxedComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <!-- 0. Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1. Status Alert Message -->
            <RowDefinition Height="Auto" />
            <!-- 2. Main Content Cards (2-Column Grid, Auto-height to eliminate gap) -->
            <RowDefinition Height="Auto" />
            <!-- 3. Bottom Actions Toolbar (Pinned directly below cards) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Banner (Compact Deep Blue Banner) -->
        <Border Grid.Row="0" Background="#1565C0" CornerRadius="5" Padding="12,6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Background="#26FFFFFF" CornerRadius="5" Width="28" Height="28" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Factory" Foreground="White" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, FallbackValue='Well Information Editor'}" 
                               Foreground="White" 
                               FontSize="14.5" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle, FallbackValue='Compact card-based overview of well identification, location coordinates, elevations, and operational parameters.'}" 
                               Foreground="#D0E2FF" 
                               FontSize="10.5" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Status Alert Message (Matching RigStateSetup) -->
        <Border Grid.Row="1" Margin="0,0,0,6" CornerRadius="5" Padding="10,5"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="CheckCircleOutline" />
                            <Setter Property="Foreground" Value="#059669" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                    <Setter Property="Foreground" Value="#DC2626" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#065F46" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#991B1B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 3. Main Content: 2-Column Balanced Card Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN ================= -->
            <StackPanel Grid.Column="0">

                <!-- CARD 1: General Identification (3 Columns x 2 Rows) -->
                <Border Style="{StaticResource MockCardBorder}">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Foreground="#1565C0" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="GENERAL IDENTIFICATION" Style="{StaticResource CardHeaderTitle}" />
                        </StackPanel>
                        <Border Height="1" Background="#F1F5F9" Margin="0,0,0,4" />

                        <UniformGrid Columns="3">
                            <!-- Well Name -->
                            <StackPanel Margin="2,1,2,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Well Name " Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="*" Foreground="#EF4444" FontWeight="Bold" FontSize="10.5" />
                                </StackPanel>
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding WellName, UpdateSourceTrigger=PropertyChanged}" 
                                         FontWeight="Bold" Foreground="#1565C0" BorderBrush="#93C5FD" />
                            </StackPanel>

                            <!-- Legal Name -->
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Legal Name" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Field Name -->
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Field Name" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- UWI / API No. -->
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="UWI / API No." Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Uwi, UpdateSourceTrigger=PropertyChanged}" 
                                         FontFamily="Consolas" />
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Well Status" Style="{StaticResource FieldLabel}" />
                                <ComboBox Style="{StaticResource BoxedComboBox}" 
                                          Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEditable="True">
                                    <ComboBoxItem Content="Active" />
                                    <ComboBoxItem Content="Drilling" />
                                    <ComboBoxItem Content="Completed" />
                                    <ComboBoxItem Content="Suspended" />
                                    <ComboBoxItem Content="Plugged &amp; Abandoned" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Purpose -->
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Well Purpose" Style="{StaticResource FieldLabel}" />
                                <ComboBox Style="{StaticResource BoxedComboBox}" 
                                          Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEditable="True">
                                    <ComboBoxItem Content="Development" />
                                    <ComboBoxItem Content="Exploration" />
                                    <ComboBoxItem Content="Appraisal" />
                                    <ComboBoxItem Content="Injection" />
                                    <ComboBoxItem Content="Observation" />
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Operators & Personnel (Optimized 4-Col + 3-Col) -->
                <Border Style="{StaticResource MockCardBorder}">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <materialDesign:PackIcon Kind="AccountTieOutline" Foreground="#1565C0" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="OPERATORS &amp; KEY PERSONNEL" Style="{StaticResource CardHeaderTitle}" />
                        </StackPanel>
                        <Border Height="1" Background="#F1F5F9" Margin="0,0,0,4" />

                        <!-- Row 1: Company / Operator Info (4 Columns) -->
                        <UniformGrid Columns="4">
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Operator Name" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Operator Division" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding OperatorDiv, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Contractor" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Contractor, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="% Interest" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding PcInterest, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="FIELD SUPERVISORY PERSONNEL" Style="{StaticResource SubSectionTitle}" />

                        <!-- Personnel: 3 Columns x 2 Rows -->
                        <UniformGrid Columns="3">
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Drilling Supervisor" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding DrillingSupr, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Drilling Engineer" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding DrillingEng, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Operator Rep" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Rep, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Tool Pusher" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding ToolPusher, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Drilling Eng Dept" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding DrlgEngDept, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Drilling Op Dept" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding DrlgOpDept, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- CARD 3: Rig Profile & Performance Benchmarks -->
                <Border Style="{StaticResource MockCardBorder}">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <materialDesign:PackIcon Kind="Engine" Foreground="#1565C0" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="RIG PROFILE &amp; BENCHMARKS" Style="{StaticResource CardHeaderTitle}" />
                        </StackPanel>
                        <Border Height="1" Background="#F1F5F9" Margin="0,0,0,4" />

                        <UniformGrid Columns="3">
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Rig Name" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding RigName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Rig Type" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding RigType, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Daily Cost ($/day)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding RigCost, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Contract Type" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding ContType, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="EDR Provider" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding EdrProvider, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Data Source" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding DataSource, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <CheckBox Content="Historical Well (Dataset represents an archived well)" 
                                  IsChecked="{Binding Historical}" 
                                  FontSize="10.5" FontWeight="Medium" 
                                  Margin="2,2,0,2" />

                        <TextBlock Text="DRILLSTRING &amp; BENCHMARK TIMERS (SECONDS)" Style="{StaticResource SubSectionTitle}" />

                        <UniformGrid Columns="4">
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Pipe Jt (ft)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding PipeLength, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Stand Lg (ft)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding StandLength, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Drlg Conn (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding DrlgConnTime, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Trip Conn (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding TripConnTime, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="BTS Time (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding BtsTime, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="STS Time (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding StsTime, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="STB Time (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding StbTime, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Trip Speed (std/h)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding TripInSpeed, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= RIGHT COLUMN ================= -->
            <StackPanel Grid.Column="2">

                <!-- CARD 4: Geographic Coordinates & Location -->
                <Border Style="{StaticResource MockCardBorder}">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <materialDesign:PackIcon Kind="Earth" Foreground="#1565C0" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="GEOGRAPHIC &amp; LOCATION COORDINATES" Style="{StaticResource CardHeaderTitle}" />
                        </StackPanel>
                        <Border Height="1" Background="#F1F5F9" Margin="0,0,0,4" />

                        <UniformGrid Columns="4">
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Country" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="State / Prov" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="County" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding County, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Block" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Block, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="District" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding District, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Region" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Time Zone" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Location" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding WellLocation, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="SURFACE COORDINATES &amp; REFERENCE" Style="{StaticResource SubSectionTitle}" />

                        <UniformGrid Columns="3">
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Latitude (deg)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                         FontFamily="Consolas" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Longitude (deg)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                         FontFamily="Consolas" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Permanent Datum" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding PermDatum, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Grid Easting (X)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding XCoOrd, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                         FontFamily="Consolas" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Grid Northing (Y)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding YCoOrd, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                         FontFamily="Consolas" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="PLSS SEC / TWP / RGE" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Sec, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Margin="2,1,2,1">
                            <TextBlock Text="Legal Land Description" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource BoxedTextBox}" 
                                     Text="{Binding LegalDesc, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 5: Elevations & Planned Targets -->
                <Border Style="{StaticResource MockCardBorder}">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <materialDesign:PackIcon Kind="ElevationRise" Foreground="#1565C0" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="ELEVATIONS, DEPTHS &amp; MILESTONES" Style="{StaticResource CardHeaderTitle}" />
                        </StackPanel>
                        <Border Height="1" Background="#F1F5F9" Margin="0,0,0,4" />

                        <UniformGrid Columns="3">
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Wellhead Elev (ft/m)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding WellheadElevation, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Ground Elev (ft/m)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding GroundElevation, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Water Depth (ft/m)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding WaterDepth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Planned Depth (ft/m)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding PlannedDepth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                         FontWeight="Bold" Foreground="#1565C0" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Planned Days" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding PlannedDays, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Target Formation" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding TdFormation, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="PERMITS &amp; KEY DATES" Style="{StaticResource SubSectionTitle}" />

                        <UniformGrid Columns="3">
                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Spud Date" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding SpudDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="License Number" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding LicenseNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="License Date" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding LicenseDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="P&amp;A / TD Date" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding PaDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Tight Hole No." Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding TightHoleNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="2,1,2,2">
                                <TextBlock Text="Well Objective" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}" 
                                         Text="{Binding Objective, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- CARD 6: Mud Pumps & Comments -->
                <Border Style="{StaticResource MockCardBorder}">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <materialDesign:PackIcon Kind="CommentTextMultipleOutline" Foreground="#1565C0" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="MUD PUMPS &amp; OPERATIONAL COMMENTS" Style="{StaticResource CardHeaderTitle}" />
                        </StackPanel>
                        <Border Height="1" Background="#F1F5F9" Margin="0,0,0,4" />

                        <!-- Mud Pumps Compact Table -->
                        <TextBlock Text="TRIPLEX MUD PUMP SPECIFICATIONS" Style="{StaticResource SubSectionTitle}" />
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,1,0,2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Table Header -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pump" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Model" Style="{StaticResource FieldLabel}" Margin="2,0" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Stroke (in)" Style="{StaticResource FieldLabel}" Margin="2,0" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Liner (in)" Style="{StaticResource FieldLabel}" Margin="2,0" />

                                <!-- Pump 1 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pump 1" FontWeight="SemiBold" FontSize="10.5" Foreground="#374151" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource BoxedTextBox}" Text="{Binding Pump1Model, UpdateSourceTrigger=PropertyChanged}" Margin="2,1" Height="22" />
                                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource BoxedTextBox}" Text="{Binding Pump1Stroke, UpdateSourceTrigger=PropertyChanged}" Margin="2,1" Height="22" />
                                <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource BoxedTextBox}" Text="{Binding Pump1Liner, UpdateSourceTrigger=PropertyChanged}" Margin="2,1" Height="22" />

                                <!-- Pump 2 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Pump 2" FontWeight="SemiBold" FontSize="10.5" Foreground="#374151" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource BoxedTextBox}" Text="{Binding Pump2Model, UpdateSourceTrigger=PropertyChanged}" Margin="2,1" Height="22" />
                                <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource BoxedTextBox}" Text="{Binding Pump2Stroke, UpdateSourceTrigger=PropertyChanged}" Margin="2,1" Height="22" />
                                <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource BoxedTextBox}" Text="{Binding Pump2Liner, UpdateSourceTrigger=PropertyChanged}" Margin="2,1" Height="22" />
                            </Grid>
                        </Border>

                        <!-- Comments -->
                        <TextBlock Text="OPERATIONAL COMMENTS &amp; HANDOVER NOTES" Style="{StaticResource SubSectionTitle}" />
                        <TextBox Style="{StaticResource BoxedTextBox}" 
                                 Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="32" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" 
                                 VerticalContentAlignment="Top" 
                                 Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>

        <!-- 4. Bottom Actions Toolbar (Pinned directly below cards, NO huge gap) -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,8" Margin="-12,6,-12,-8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Reset Button -->
                <Button Grid.Column="0" 
                        Command="{Binding ResetCommand}" 
                        Height="28" Padding="10,0" 
                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                        Foreground="#374151" FontWeight="SemiBold" FontSize="11"
                        ToolTip="Reset form to saved well parameters">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="RESET TO SAVED" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Right: Cancel & Save Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding CancelCommand}" 
                            Height="28" Width="90" Margin="0,0,8,0" 
                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                            Foreground="#374151" FontWeight="SemiBold" FontSize="11"
                            Content="CANCEL" IsCancel="True" />

                    <Button Command="{Binding SaveCommand}" 
                            Height="28" Width="120" 
                            Background="#1565C0" BorderBrush="#1565C0" BorderThickness="1" 
                            Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                            IsEnabled="{Binding CanSave}" 
                            IsDefault="True"
                            ToolTip="Save all well attributes and configurations">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="SAVE WELL" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

