<Window x:Class="DrillIntel.Views.RecalculateBroomstickPointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:RecalculateBroomstickPointsViewModel}"
        Title="Recalculate Broomstick Points" 
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Info Box -->
            <RowDefinition Height="Auto" />
            <!-- 2: Recalculation Scope & Options -->
            <RowDefinition Height="Auto" />
            <!-- 3: Progress & Status -->
            <RowDefinition Height="*" />
            <!-- 4: Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header Banner -->
        <Border Grid.Row="0" Background="#FFF8F0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <materialDesign:PackIcon Grid.Column="0" Kind="Broom" Width="36" Height="36" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,14,0" />
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Recalculate Broomstick Points" FontSize="18" FontWeight="Bold" Foreground="#BF360C" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Well: " FontWeight="SemiBold" Foreground="#616161" FontSize="12" />
                        <TextBlock Text="{Binding WellName}" FontWeight="Bold" Foreground="#212121" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Text="Log: " FontWeight="SemiBold" Foreground="#616161" FontSize="12" />
                        <TextBlock Text="{Binding LogName}" Foreground="#212121" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Text="Existing Points: " FontWeight="SemiBold" Foreground="#616161" FontSize="12" />
                        <TextBlock Text="{Binding ExistingPointsCount, StringFormat='{}{0:N0} points'}" FontWeight="Bold" Foreground="#E65100" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: Info Box -->
        <Border Grid.Row="1" Background="#E8F4FD" BorderBrush="#B6E0FE" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" 
                           Text="Recalculates Broomstick points (pickup, slackoff, and rotating off bottom) from well log data and saves them to the project database." 
                           Foreground="#0369A1" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 2: Recalculation Scope & Options GroupBox -->
        <GroupBox Grid.Row="2" Header="Recalculation Options" materialDesign:ElevationAssist.Elevation="Dp1" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <RadioButton Content="Recalculate Entire Well / Timelog" 
                             IsChecked="{Binding IsEntireWell, Mode=TwoWay}" 
                             IsEnabled="{Binding CanStart}"
                             GroupName="RecalcScopeGroup"
                             FontWeight="Medium" 
                             Margin="0,0,0,6" />
                <RadioButton Content="Custom Date &amp; Time Range" 
                             IsChecked="{Binding IsCustomRange, Mode=TwoWay}" 
                             IsEnabled="{Binding CanStart}"
                             GroupName="RecalcScopeGroup"
                             FontWeight="Medium" 
                             Margin="0,0,0,8" />

                <!-- Date & Time Range Pickers -->
                <Grid IsEnabled="{Binding CanSelectDates}" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="From (Date &amp; Time):" FontSize="11.5" FontWeight="SemiBold" Foreground="#616161" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" 
                                        SelectedDate="{Binding FromDate, Mode=TwoWay}" 
                                        DisplayDateStart="{Binding MinAvailableDate}"
                                        DisplayDateEnd="{Binding MaxAvailableDate}" />
                            <materialDesign:TimePicker Grid.Column="2" 
                                                       SelectedTime="{Binding FromTime, Mode=TwoWay}" 
                                                       Is24Hours="True" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To (Date &amp; Time):" FontSize="11.5" FontWeight="SemiBold" Foreground="#616161" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" 
                                        SelectedDate="{Binding ToDate, Mode=TwoWay}" 
                                        DisplayDateStart="{Binding MinAvailableDate}"
                                        DisplayDateEnd="{Binding MaxAvailableDate}" />
                            <materialDesign:TimePicker Grid.Column="2" 
                                                       SelectedTime="{Binding ToTime, Mode=TwoWay}" 
                                                       Is24Hours="True" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,8" Background="#E0E0E0" />

                <!-- CheckBox: Clear existing points -->
                <CheckBox Content="Clear existing Broomstick points before recalculating" 
                          IsChecked="{Binding ClearExistingPoints, Mode=TwoWay}" 
                          IsEnabled="{Binding CanStart}"
                          FontWeight="Normal" />
            </StackPanel>
        </GroupBox>

        <!-- 3: Progress & Status -->
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center">
                <!-- Status Message & Percentage -->
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressStatus}" FontSize="12.5" FontWeight="Medium" Foreground="#424242" TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat='{}{0:F1}%'}" FontSize="13" FontWeight="Bold" Foreground="#E65100" />
                </DockPanel>

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ProgressPercent}" 
                             Maximum="100" 
                             Height="12" 
                             materialDesign:TransitionAssist.DisableTransitions="True"
                             Margin="0,0,0,6" />

                <!-- Error message if any -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#D32F2F" 
                           FontSize="12" 
                           TextWrapping="Wrap" 
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- 4: Bottom Action Buttons Bar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Buttons: Start, Stop, Clear DB Entries -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Start Button -->
                <Button Command="{Binding StartCommand}" 
                        IsEnabled="{Binding CanStart}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#E65100" BorderBrush="#E65100" Foreground="White"
                        Height="36" Padding="16,0"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Start" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Stop Button -->
                <Button Command="{Binding StopCommand}" 
                        IsEnabled="{Binding CanStop}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Foreground="#C62828" BorderBrush="#EF9A9A"
                        Height="36" Padding="14,0"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Stop" Width="18" Height="18" Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Stop" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Clear DB Entries Button -->
                <Button Command="{Binding ClearDbEntriesCommand}" 
                        IsEnabled="{Binding CanStart}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#757575" BorderBrush="#BDBDBD"
                        Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Clear DB Entries" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right Button: Close -->
            <Button Grid.Column="1" Command="{Binding CloseCommand}" 
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="36" Padding="16,0" MinWidth="90">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CancelButtonText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>

