<Window x:Class="DrillIntel.Views.DQI.DQISetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DQI Setup" Width="720" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#F8FAFC"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Background="#0D1117">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header: Icon, Title, Subtitle, Close X -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#132E22" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="TuneVertical" Foreground="#34D399" Width="20" Height="20"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DQI Setup" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Changes are only applied after clicking Save" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Command="{Binding CancelCommand}"
                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Width="32" Height="32" Cursor="Hand">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>

            <!-- 2. Tabs Selector -->
            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}"
                        Background="Transparent" BorderThickness="0" Margin="0,0,0,16">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="14,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,12,0" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#10B981"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: Channel List -->
                <TabItem Header="Channel List">
                    <Grid Margin="0,12,0,0" DataContext="{Binding ChannelListTab}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Info Note -->
                        <Border Grid.Row="0" Background="#102336" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="#38BDF8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Select channels from the catalogue. The DQI service will only process channels listed here." Foreground="#BAE6FD" FontSize="11" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Add Channels Row -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding AvailableCatalogueMnemonics}"
                                      SelectedItem="{Binding SelectedCatalogueMnemonic, Mode=TwoWay}"
                                      materialDesign:HintAssist.Hint="Add Channels from catalogue..."
                                      Background="#161F30" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                      Padding="10,6" FontSize="12"/>
                            <Button Grid.Column="1" Command="{Binding AddChannelCommand}"
                                    Background="#064E3B" BorderBrush="#059669" BorderThickness="1" Foreground="#34D399"
                                    Margin="8,0,0,0" Padding="14,6" Height="36" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Add" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Channels Grid -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Channels}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  Background="#101522" Foreground="#F8FAFC" RowBackground="#101522"
                                  BorderBrush="#1E293B" BorderThickness="1" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1E293B" VerticalGridLinesBrush="Transparent">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#161F30"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#1E293B"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Mnemonic" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#132E22" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="6,2">
                                                <TextBlock Text="{Binding Mnemonic}" Foreground="#34D399" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Channel Name" Binding="{Binding Name}" Width="*"/>

                                <DataGridTemplateColumn Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveChannelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="#EF4444" Width="28" Height="28" Cursor="Hand">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Min / Max (Channel Bounds) -->
                <TabItem Header="Min / Max">
                    <Grid Margin="0,12,0,0" DataContext="{Binding ChannelBoundsTab}">
                        <DataGrid ItemsSource="{Binding Boundaries}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  Background="#101522" Foreground="#F8FAFC" RowBackground="#101522"
                                  BorderBrush="#1E293B" BorderThickness="1" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1E293B" VerticalGridLinesBrush="Transparent">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#161F30"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#1E293B"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mnemonic" Binding="{Binding Mnemonic}" IsReadOnly="True" Width="100"/>
                                <DataGridTextColumn Header="Channel Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=TwoWay}" Width="80"/>
                                <DataGridTextColumn Header="Min" Binding="{Binding Min, Mode=TwoWay, StringFormat={}{0:F2}}" Width="90"/>
                                <DataGridTextColumn Header="Max" Binding="{Binding Max, Mode=TwoWay, StringFormat={}{0:F2}}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 3: Null Values -->
                <TabItem Header="Null Values">
                    <Grid Margin="0,12,0,0" DataContext="{Binding NullValuesTab}">
                        <StackPanel>
                            <Border Background="#102336" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="#38BDF8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Readings matching these comma-separated values will be treated as Null in Consistency calculations." Foreground="#BAE6FD" FontSize="11" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="NULL VALUES" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NullValues, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#161F30" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                     Padding="10,8" FontSize="12" CaretBrush="#F8FAFC"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 3. Footer Bar: Cancel & Save Changes -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="11" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Command="{Binding CancelCommand}"
                        Background="#161F30" BorderBrush="#334155" BorderThickness="1" Foreground="#94A3B8"
                        Padding="16,8" Height="36" Margin="0,0,10,0" Cursor="Hand">
                    <TextBlock Text="Cancel" FontSize="12" FontWeight="SemiBold"/>
                </Button>

                <Button Grid.Column="2" Command="{Binding SaveChangesCommand}"
                        Background="#059669" BorderBrush="#10B981" BorderThickness="1" Foreground="#FFFFFF"
                        Padding="18,8" Height="36" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Save Changes" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

