<Window x:Class="DrillIntel.Views.DQI.DQISetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DQI Setup" Width="760" Height="680"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Primary Action Raised Button Style (Solid Deep Purple with Crisp White Text) -->
        <Style x:Key="PrimaryActionRaisedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#673AB7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#512DA8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="1" Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5E35B1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4527A0"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#5E35B1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4527A0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#311B92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="border" Property="Background" Value="#9E9E9E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#9E9E9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outlined Button Style -->
        <Style x:Key="SecondaryOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Tabs Content -->
            <RowDefinition Height="*"/>
            <!-- 2: Action Footer Strip -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Banner matching BroomstickSetupDialog & TrackPropertiesDialog -->
        <Border Grid.Row="0" Background="#F4F3F8" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0" Kind="TuneVertical" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DQI Setup" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="Changes are only applied after clicking Save" FontSize="11" Foreground="#616161" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Tabs Selector -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    materialDesign:ColorZoneAssist.Mode="Standard">

            <!-- TAB 1: Channel List -->
            <TabItem Header="Channel List" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0" DataContext="{Binding ChannelListTab}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Info Note -->
                    <Border Grid.Row="0" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="InformationOutline" Foreground="#0284C7" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Select channels from the catalogue. The DQI service will only process channels listed here." Foreground="#0369A1" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Add Channels Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding AvailableCatalogueMnemonics}"
                                  SelectedItem="{Binding SelectedCatalogueMnemonic, Mode=TwoWay}"
                                  materialDesign:HintAssist.Hint="Add Channels from catalogue..."
                                  Background="#FFFFFF" Foreground="#111827" BorderBrush="#CBD5E1" BorderThickness="1"
                                  Padding="10,6" Height="34" FontSize="12"/>
                        <Button Grid.Column="1" Command="{Binding AddChannelCommand}"
                                Style="{StaticResource PrimaryActionRaisedButtonStyle}"
                                Margin="8,0,0,0" Padding="18,0" Height="34">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Add" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Channels Grid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Channels}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              Background="#FFFFFF" Foreground="#111827" RowBackground="#FFFFFF"
                              BorderBrush="#E2E8F0" BorderThickness="1" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="Transparent">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Mnemonic" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EDE7F6" BorderBrush="#B39DDB" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="6,2">
                                            <TextBlock Text="{Binding Mnemonic}" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Channel Name" Binding="{Binding Name}" Width="*"/>

                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveChannelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Foreground="#DC2626" Width="28" Height="28" Cursor="Hand" ToolTip="Remove Channel">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="#DC2626" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Min / Max (Channel Bounds) -->
            <TabItem Header="Min / Max" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0" DataContext="{Binding ChannelBoundsTab}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Info Note -->
                    <Border Grid.Row="0" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="InformationOutline" Foreground="#0284C7" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Define the expected operating range for each channel. Values outside this range reduce the Data Accuracy Index." Foreground="#0369A1" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Boundaries}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              Background="#FFFFFF" Foreground="#111827" RowBackground="#FFFFFF"
                              BorderBrush="#E2E8F0" BorderThickness="1" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="Transparent">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Mnemonic" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EDE7F6" BorderBrush="#B39DDB" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="6,2">
                                            <TextBlock Text="{Binding Mnemonic}" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Channel Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=TwoWay}" Width="100"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding Min, Mode=TwoWay, StringFormat={}{0:F2}}" Width="110"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding Max, Mode=TwoWay, StringFormat={}{0:F2}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: Null Values -->
            <TabItem Header="Null Values" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0" DataContext="{Binding NullValuesTab}">
                    <StackPanel>
                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="#0284C7" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Readings matching these comma-separated values will be treated as Null in Consistency calculations." Foreground="#0369A1" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="NULL VALUES (COMMA-SEPARATED)" Foreground="#374151" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NullValues, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#FFFFFF" Foreground="#111827" BorderBrush="#CBD5E1" BorderThickness="1"
                                 Padding="10,8" Height="36" FontSize="12.5" CaretBrush="#111827"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 2. Action Footer Strip matching BroomstickSetupDialog & TrackPropertiesDialog -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="11.5" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryOutlinedButtonStyle}"
                        Height="34" Width="100" Margin="0,0,10,0">
                    <TextBlock Text="Cancel" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Button>

                <Button Grid.Column="2" Command="{Binding SaveChangesCommand}"
                        Style="{StaticResource PrimaryActionRaisedButtonStyle}"
                        Height="34" Padding="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Save Changes" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
