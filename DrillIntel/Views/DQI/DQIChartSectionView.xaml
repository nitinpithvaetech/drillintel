<UserControl x:Class="DrillIntel.Views.DQI.DQIChartSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:teechart="clr-namespace:Steema.TeeChart.WPF;assembly=TeeChart.Business.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#0D1117" Foreground="#F8FAFC"
             d:DesignWidth="1000" d:DesignHeight="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- 1. EMPTY STATE (When no well or channel is selected) -->
        <Border Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}"
                Background="#0D1117" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <materialDesign:PackIcon Kind="ChartTimelineVariant" Foreground="#475569" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="No Channel Selected" Foreground="#94A3B8" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding EmptyStateMessage}" Foreground="#64748B" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
        </Border>

        <!-- 2. MAIN ACTIVE CHART CONTENT -->
        <Grid x:Name="ChartContentGrid" Visibility="{Binding IsChartVisible, Converter={StaticResource BoolToVis}}"
              Margin="12,8,12,12" IsVisibleChanged="ChartContentGrid_IsVisibleChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BANNER -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Channel Name & Mnemonic -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="{Binding ChannelName}" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Mnemonic}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- 4 KPI Badges: OVERALL, CONS, FREQ, ACCR -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- OVERALL -->
                    <Border Background="#211E3B" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="LightningBolt" Foreground="#A78BFA" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="OVERALL" Foreground="#C4B5FD" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="{Binding OverallChannelDQI, StringFormat={}{0:F2}%}" Foreground="#A78BFA" FontSize="12" FontWeight="Black"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CONS -->
                    <Border Background="#102A3C" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartBox" Foreground="#38BDF8" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="CONS" Foreground="#7DD3FC" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ConsAvg, StringFormat={}{0:F2}%}" Foreground="#38BDF8" FontSize="12" FontWeight="Black"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- FREQ -->
                    <Border Background="#132E22" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="HeartPulse" Foreground="#4ADE80" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="FREQ" Foreground="#86EFAC" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="{Binding FreqAvg, StringFormat={}{0:F2}%}" Foreground="#4ADE80" FontSize="12" FontWeight="Black"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ACCR -->
                    <Border Background="#2E2312" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="SignalCellular3" Foreground="#FBBF24" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="ACCR" Foreground="#FDE68A" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AccrAvg, StringFormat={}{0:F2}%}" Foreground="#FBBF24" FontSize="12" FontWeight="Black"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Controls: Line/Area Toggle & Refresh/Process -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Line toggle -->
                    <Border Background="#161F30" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetLineChartCommand}" ToolTip="Line Chart"
                                    Background="Transparent" BorderThickness="0" Padding="8,4" Height="30" Cursor="Hand">
                                <materialDesign:PackIcon Kind="ChartLine" Foreground="#34D399" Width="16" Height="16"/>
                            </Button>
                            <Separator Background="#334155" Width="1" Margin="0,3"/>
                            <Button Command="{Binding SetAreaChartCommand}" ToolTip="Area Chart"
                                    Background="Transparent" BorderThickness="0" Padding="8,4" Height="30" Cursor="Hand">
                                <materialDesign:PackIcon Kind="ChartAreaspline" Foreground="#94A3B8" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Process DQI Button -->
                    <Button Command="{Binding ProcessDQICommand}" ToolTip="Calculate DQI for Well"
                            Background="#064E3B" BorderBrush="#059669" BorderThickness="1" Foreground="#34D399"
                            Padding="12,5" Height="32" Margin="0,0,6,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Process" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshCommand}" ToolTip="Refresh Data"
                            Background="#161F30" BorderBrush="#334155" BorderThickness="1" Foreground="#94A3B8"
                            Padding="8,5" Height="32" Width="34" Cursor="Hand">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- PROGRESS / STATUS / ERROR BANNER -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <!-- Loading & Progress Bar -->
                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                        Background="#102A3C" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                                     Foreground="#38BDF8" Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#7DD3FC" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Error Notice Bar -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        Background="#271C19" BorderBrush="#B45309" BorderThickness="1" CornerRadius="6"
                        Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="InformationOutline" Foreground="#F59E0B" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#FDE68A" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" Command="{Binding ProcessDQICommand}" Content="Process"
                                Background="#B45309" Foreground="#FFFBEB" BorderThickness="0" Padding="8,2" Height="24" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" Cursor="Hand"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3 STACKED TRACKS -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TRACK 1: Consistency Index -->
                <Border Grid.Row="0" Background="#101522" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="6,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,4,0,2">
                            <materialDesign:PackIcon Kind="ChartBox" Foreground="#38BDF8" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Consistency Index" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <teechart:TChart Grid.Row="1" x:Name="ConsistencyChart"/>
                    </Grid>
                </Border>

                <!-- TRACK 2: Data Frequency Index -->
                <Border Grid.Row="1" Background="#101522" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="6,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,4,0,2">
                            <materialDesign:PackIcon Kind="HeartPulse" Foreground="#4ADE80" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Data Frequency Index" Foreground="#4ADE80" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <teechart:TChart Grid.Row="1" x:Name="FrequencyChart"/>
                    </Grid>
                </Border>

                <!-- TRACK 3: Data Accuracy Index -->
                <Border Grid.Row="2" Background="#101522" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="6,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,4,0,2">
                            <materialDesign:PackIcon Kind="SignalCellular3" Foreground="#FBBF24" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Data Accuracy Index" Foreground="#FBBF24" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <teechart:TChart Grid.Row="1" x:Name="AccuracyChart"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

