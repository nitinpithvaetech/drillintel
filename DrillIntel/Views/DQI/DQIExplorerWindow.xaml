<Window x:Class="DrillIntel.Views.DQI.DQIExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DrillIntel.Views.DQI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Data Quality Index (DQI) Explorer"
        Width="1440" Height="880" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="240" MaxWidth="360"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <views:DQILeftPanelView Grid.Column="0" DataContext="{Binding LeftPanel}"/>

        <!-- Splitter Line -->
        <Border Grid.Column="1" Background="#E2E8F0"/>

        <!-- Right Chart Section -->
        <views:DQIChartSectionView Grid.Column="2" DataContext="{Binding ChartSection}"/>
    </Grid>
</Window>

