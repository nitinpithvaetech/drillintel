<UserControl x:Class="DrillIntel.Views.DQI.DQILeftPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#101522" Foreground="#F8FAFC"
             d:DesignWidth="280" d:DesignHeight="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Settings Cog Button Style with Hover, Pressed, and Focus states -->
        <Style x:Key="DQISettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#142021"/>
            <Setter Property="BorderBrush" Value="#1E3A32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover State -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1C3830"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#34D399"/>
                                <Setter Property="Foreground" Value="#34D399"/>
                            </Trigger>
                            <!-- Pressed State -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0E1F1B"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#059669"/>
                                <Setter Property="Foreground" Value="#059669"/>
                            </Trigger>
                            <!-- Keyboard Focused State -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#34D399"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#34D399"/>
                            </Trigger>
                            <!-- Disabled State -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header with Title & Settings Cog -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Icon + Title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Background="#16382B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6"
                        Width="28" Height="28" Margin="0,0,8,0">
                    <materialDesign:PackIcon Kind="ChartBoxOutline" Foreground="#34D399" Width="16" Height="16"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="DQI Explorer" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Settings (Gear) Icon Button -->
            <Button Grid.Column="1"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="DQI Setup"
                    Style="{StaticResource DQISettingsButtonStyle}">
                <materialDesign:PackIcon Kind="Cog" Width="18" Height="18"
                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
            </Button>
        </Grid>

        <!-- 2. Well Selector -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="WELL" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Wells}" SelectedItem="{Binding SelectedWell, Mode=TwoWay}"
                      DisplayMemberPath="WellName"
                      Background="#161F30" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                      Padding="8,6" FontSize="12">
            </ComboBox>
        </StackPanel>

        <!-- 3. Channel Search Box -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="CHANNEL" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
            <Border Background="#161F30" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                             CaretBrush="#F8FAFC" FontSize="12" VerticalAlignment="Center"/>
                    <materialDesign:PackIcon Grid.Column="1" Kind="Magnify" Foreground="#64748B" Width="16" Height="16" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 4. Channel List -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Channels}"
                     SelectedItem="{Binding SelectedChannelItem, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="#161F30" BorderBrush="#334155" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#475569"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#132A26"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#10B981"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Mnemonic}" Foreground="#10B981" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1" Kind="SignalCellular3" Foreground="#10B981" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Channel count footer -->
            <TextBlock Grid.Row="1" Text="{Binding ChannelCountText}" Foreground="#64748B" FontSize="11" Margin="2,4,0,0"/>
        </Grid>

        <!-- 5. WELL AVG INDICES Card -->
        <Border Grid.Row="4" Background="#161F30" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="WELL AVG INDICES" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Consistency -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="ChartBox" Foreground="#38BDF8" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Consistency" Foreground="#CBD5E1" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding ConsistencyScore, StringFormat={}{0:F0}%}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar Value="{Binding ConsistencyScore}" Maximum="100" Height="4" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0" Margin="0,0,0,10"/>

                <!-- Frequency -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="HeartPulse" Foreground="#4ADE80" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Frequency" Foreground="#CBD5E1" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding FrequencyScore, StringFormat={}{0:F0}%}" Foreground="#4ADE80" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar Value="{Binding FrequencyScore}" Maximum="100" Height="4" Foreground="#4ADE80" Background="#1E293B" BorderThickness="0" Margin="0,0,0,10"/>

                <!-- Accuracy -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="SignalCellular3" Foreground="#FBBF24" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Accuracy" Foreground="#CBD5E1" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding AccuracyScore, StringFormat={}{0:F0}%}" Foreground="#FBBF24" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar Value="{Binding AccuracyScore}" Maximum="100" Height="4" Foreground="#FBBF24" Background="#1E293B" BorderThickness="0" Margin="0,0,0,12"/>

                <!-- OVERALL WELL AVG Card -->
                <Border Background="#211E3B" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="LightningBolt" Foreground="#A78BFA" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="OVERALL WELL AVG" Foreground="#C4B5FD" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="{Binding OverallWellAvg, StringFormat={}{0:F2}%}" Foreground="#A78BFA" FontSize="16" FontWeight="Black"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

