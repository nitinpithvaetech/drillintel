<UserControl x:Class="DrillIntel.Views.ImportDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:DrillIntel.Models"
             xmlns:local="clr-namespace:DrillIntel.Views"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="LeftAlignedCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / Step Indicator -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="DatabaseImport" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="32" Height="32" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding WizardTitle}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                <!-- Help Icon -->
                <Button Grid.Column="2" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Workflow: 1. Select a File, 2. Map Columns to VuMax channels, 3. Execute Import. Hover over fields for specific guidance.">
                    <materialDesign:PackIcon Kind="HelpCircleOutline" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="28" Height="28" />
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl x:Name="MainTabControl" Grid.Row="2" SelectedValue="{Binding CurrentTab}" SelectedValuePath="Tag" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="MainTabControl_SelectionChanged">
            
            <!-- STEP 1: File Selection -->
            <TabItem Tag="{x:Static models:WizardTab.FileSelection}">
                <materialDesign:Card Padding="32" UniformCornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Step 1 of 3: Select File" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,24" HorizontalAlignment="Center" />
                        
                        <Grid Width="400" Height="250" AllowDrop="True" Drop="DropZone_Drop" MouseLeftButtonDown="DropZone_Click" Cursor="Hand" Background="Transparent" ToolTip="Drag and drop your data file here">
                            <Rectangle Stroke="{DynamicResource PrimaryHueMidBrush}" StrokeThickness="2" StrokeDashArray="4 4" RadiusX="8" RadiusY="8" Fill="#0A000000" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloudUploadOutline" Width="64" Height="64" Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <TextBlock Text="Drag and drop your CSV/Excel file here" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="or click to browse" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="{Binding IsFileUploaded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="CheckCircle" Foreground="Green" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontWeight="Medium" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </TabItem>

            <!-- STEP 2: Channel Mapping -->
            <TabItem Tag="{x:Static models:WizardTab.Mapping}">
                <materialDesign:Card Padding="24" UniformCornerRadius="8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="Step 2 of 3: Map Columns" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="We have auto-mapped standard VuMax channels. Unmapped columns will be created as dynamic custom fields." Foreground="Gray" Margin="0,4,0,0" />
                        </StackPanel>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <!-- Left side: VuMax Channel & Source -->
                                <ColumnDefinition Width="2*" />
                                <!-- Right side: Parameter Settings -->
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Channel & Source DataGrid -->
                            <DataGrid Grid.Column="0"
                                      ItemsSource="{Binding ColumnMappings}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      Height="250"
                                      Margin="0,0,16,0"
                                      materialDesign:DataGridAssist.CellPadding="8 4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="VuMax Channel"
                                                        Binding="{Binding VuMaxColumnID}"
                                                        Width="120"
                                                        IsReadOnly="True"
                                                        CellStyle="{StaticResource LeftAlignedCellStyle}" />
                                    <DataGridTemplateColumn Header="Source Column" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding AvailableSourceColumns}" 
                                                          SelectedItem="{Binding SourceColumnName, UpdateSourceTrigger=PropertyChanged}" 
                                                          materialDesign:HintAssist.Hint="Select column"
                                                          HorizontalAlignment="Stretch" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Right: Parameter Settings Panel -->
                            <Border Grid.Column="1"
                                    Padding="16"
                                    Background="#F9F9F9"
                                    CornerRadius="6"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Import Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                                    <!-- Import Settings -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Import from Row:" VerticalAlignment="Center" Width="120" />
                                        <TextBox Width="60" Text="{Binding ImportFromRow, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        
                                        <TextBlock Text="Heading Row:" VerticalAlignment="Center" Margin="24,0,8,0" />
                                        <TextBox Width="60" Text="{Binding ColumnHeadingRow, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- DateTime Settings -->
                                    <TextBlock Text="DateTime Settings" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <CheckBox Content="Date Time in separate columns" IsChecked="{Binding IsDatetimeInSeperatorColumn}" Margin="0,0,0,12" />
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Separator:" VerticalAlignment="Center" Width="80" />
                                        <TextBox Width="50" Text="{Binding DatetimeSeparator}" VerticalAlignment="Center" />
                                        
                                        <TextBlock Text="Date Col No:" VerticalAlignment="Center" Margin="16,0,8,0" />
                                        <TextBox Width="50" Text="{Binding DateColNo}" VerticalAlignment="Center" />
                                        
                                        <TextBlock Text="Time Col No:" VerticalAlignment="Center" Margin="16,0,8,0" />
                                        <TextBox Width="50" Text="{Binding TimeColNo}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Note -->
                                    <TextBlock Text="(Note: Column nos. start from 0)" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,16" />

                                    <!-- Date Format -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Date Format:" VerticalAlignment="Center" Width="80" />
                                        <ComboBox Width="180" SelectedValue="{Binding DateFormat}" SelectedValuePath="Tag" VerticalAlignment="Center">
                                            <ComboBoxItem Content="ISO Format" Tag="{x:Static models:DateFormatType.ISOFormat}" />
                                            <ComboBoxItem Content="dd-MM-yyyy format" Tag="{x:Static models:DateFormatType.DDMMYYYYFormat}" />
                                            <ComboBoxItem Content="MM-dd-yyyy format" Tag="{x:Static models:DateFormatType.MMDDYYYYFormat}" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Data preview grid -->
                        <Expander Header="Preview Data" DockPanel.Dock="Bottom" IsExpanded="True">
                            <DataGrid x:Name="MapColumnsPreviewGrid" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="True" CanUserAddRows="False" Height="350" IsReadOnly="True" materialDesign:DataGridAssist.CellPadding="8 4" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" />
                        </Expander>
                    </DockPanel>
                </materialDesign:Card>
            </TabItem>

            <!-- STEP 3: Finalize & QC -->
            <TabItem Tag="{x:Static models:WizardTab.Finalize}">
                <materialDesign:Card Padding="32" UniformCornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
                    <StackPanel>
                        <TextBlock Text="Step 3 of 3: Finalize Import" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,24" HorizontalAlignment="Center" />
                        
                        <!-- Target Well Display (Read-Only) -->
                        <Border Background="#F4F6F9" Padding="14,10" CornerRadius="8" Margin="0,0,0,24" BorderBrush="#E0E6ED" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Factory" Foreground="#1976D2" Width="24" Height="24" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Target Well" FontSize="11" Foreground="Gray" FontWeight="Medium" />
                                    <TextBlock Text="{Binding ProjectWellName}" FontSize="16" FontWeight="Bold" Foreground="#1976D2" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBox materialDesign:HintAssist.Hint="{Binding LogNameHint}" Text="{Binding LogName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,32" FontSize="16" ToolTip="{Binding LogNameToolTip}" />

                        <Button Content="START IMPORT" Command="{Binding SaveCommand}" IsEnabled="{Binding CanStartImport}" Style="{StaticResource MaterialDesignRaisedButton}" Height="48" FontSize="16" />

                        <!-- Progress Display -->
                        <StackPanel Margin="0,20,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar Value="{Binding ImportProgressPercent}" Maximum="100" IsIndeterminate="{Binding IsIndeterminateProgress}" Height="6" />
                            <TextBlock Text="{Binding ImportProgressStatus}" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="13" Foreground="Gray" FontWeight="Medium" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </TabItem>
            
        </TabControl>

        <!-- Navigation Buttons -->
        <Border Grid.Row="4" Background="{DynamicResource MaterialDesignPaper}" Padding="0,16,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="BACK" Command="{Binding PreviousStepCommand}" Visibility="{Binding IsBackVisible, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{Binding CanNavigateBack}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,16,0" Width="100" />
                <Button Content="NEXT" Command="{Binding NextStepCommand}" Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}" Width="100" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
