<Window x:Class="DrillIntel.Views.AdvertisementFullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:AdvertisementFullscreenViewModel}"
        Title="VuMaxPro® Real-Time Drilling Intelligence Platform"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E17"
        TextElement.Foreground="White"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Full-Screen Image Showcase -->
            <RowDefinition Height="*" />
            <!-- 2: Title and Description -->
            <RowDefinition Height="Auto" />
            <!-- 3: Dots Indicator -->
            <RowDefinition Height="Auto" />
            <!-- 4: Action Buttons Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Platform Tagline -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/DrillIntel;component/Assets/VuMaxPro/banner_vumaxpro.png"
                       Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" />
                <Border Background="#1E293B" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="Next-Gen Real-Time AI Drilling Intelligence Platform" 
                               FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Right Controls: Badge, Counter, Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#312E81" BorderBrush="#4F46E5" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentAdSlide.Badge, FallbackValue='Featured'}"
                               FontSize="11" FontWeight="Bold" Foreground="#818CF8" />
                </Border>

                <!-- Slide Counter / Auto-Scroll Toggle -->
                <Button Command="{Binding ToggleAutoScrollCommand}" 
                        Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                        Height="32" Padding="12,0" Margin="0,0,12,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#E2E8F0"
                        ToolTip="Pause or resume auto-play (Space)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="PlayPause" Width="14" Height="14" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SlideCountDisplay}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Prominent Close Button -->
                <Button Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#475569" Foreground="#F8FAFC"
                        Background="#1E293B"
                        Height="32" Padding="12,0"
                        ToolTip="Close full screen (Esc)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Close" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1: Full-Screen Image Showcase -->
        <Border Grid.Row="1" Background="#05080F" CornerRadius="12" BorderBrush="#1E293B"
                BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- Large High-Res Image -->
                <Image Source="{Binding CurrentAdSlide.ImageSource}"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="12" />

                <!-- Left Navigation Chevron -->
                <Button Command="{Binding PreviousAdSlideCommand}" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="18,0,0,0" Width="48" Height="48" Padding="0" Background="#B3000000"
                        Foreground="White" BorderThickness="1" BorderBrush="#475569"
                        Style="{StaticResource MaterialDesignFloatingActionButton}"
                        ToolTip="Previous Image (Left Arrow)">
                    <materialDesign:PackIcon Kind="ChevronLeft" Width="32" Height="32" />
                </Button>

                <!-- Right Navigation Chevron -->
                <Button Command="{Binding NextAdSlideCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,18,0" Width="48" Height="48" Padding="0" Background="#B3000000"
                        Foreground="White" BorderThickness="1" BorderBrush="#475569"
                        Style="{StaticResource MaterialDesignFloatingActionButton}"
                        ToolTip="Next Image (Right Arrow)">
                    <materialDesign:PackIcon Kind="ChevronRight" Width="32" Height="32" />
                </Button>
            </Grid>
        </Border>

        <!-- 2: Title and Description -->
        <Grid Grid.Row="2" Margin="4,12,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentAdSlide.Title}" FontSize="20" FontWeight="Bold"
                           Foreground="#F8FAFC" Margin="0,0,0,4" />
                <TextBlock Text="{Binding CurrentAdSlide.Description}" FontSize="13.5"
                           Foreground="#94A3B8" TextWrapping="Wrap" />
            </StackPanel>

            <Image Grid.Column="1" Source="pack://application:,,,/DrillIntel;component/Assets/VuMaxPro/logo_etech.png"
                   Height="36" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.8" Margin="16,0,0,0" />
        </Grid>

        <!-- 3: Dots Indicator -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding AdSlides}" Margin="0,10,0,14" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{x:Null}" Background="Transparent" BorderThickness="0" Padding="4,2"
                            Click="OnSlideDotClick" Cursor="Hand" ToolTip="{Binding Title}">
                        <Border Height="6" CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="10" />
                                    <Setter Property="Background" Value="#334155" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Width" Value="28" />
                                            <Setter Property="Background" Value="#38BDF8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 4: Action Buttons Bar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Primary Explore Button -->
            <Button Grid.Column="0" Command="{Binding OpenEtechWebsiteCommand}"
                    CommandParameter="{Binding CurrentAdSlide.TargetUrl}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#1976D2"
                    BorderBrush="#1976D2" Foreground="White" Height="42" Padding="20,0"
                    materialDesign:ButtonAssist.CornerRadius="6"
                    ToolTip="Open VuMaxPro product page in browser">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Sparkles" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Explore VuMax® Pro on etechinter.com" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Button>

            <!-- Secondary Website Button -->
            <Button Grid.Column="1" Command="{Binding OpenEtechWebsiteCommand}"
                    CommandParameter="https://etechinter.com"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="42"
                    Padding="16,0" BorderBrush="#334155" Foreground="#E2E8F0"
                    Background="#1E293B"
                    materialDesign:ButtonAssist.CornerRadius="6"
                    ToolTip="Visit official eTech International website">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Web" Width="16" Height="16" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="etechinter.com" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Close Fullscreen Button -->
            <Button Grid.Column="3" Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="42"
                    Padding="18,0" BorderBrush="#334155" Foreground="#94A3B8"
                    materialDesign:ButtonAssist.CornerRadius="6"
                    ToolTip="Close full screen view (Esc)">
                <TextBlock Text="Close" FontSize="12" VerticalAlignment="Center" />
            </Button>
        </Grid>
    </Grid>
</Window>

