<Window x:Class="DrillIntel.Views.UnitConversionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:UnitConversionEditViewModel}"
        Title="{Binding Title}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Clean Form Input TextBox Style with proper height and padding -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" Margin="0" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00897B" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Form ComboBox Style with proper height and padding -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Error Message -->
            <RowDefinition Height="Auto" />
            <!-- 2: Form Fields -->
            <RowDefinition Height="Auto" />
            <!-- 3: Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E0F2F1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="SwapHorizontalCircleOutline" Foreground="#00796B" Width="32" Height="32" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#004D40" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#00796B" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error Message Banner -->
        <Border Grid.Row="1" Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#C62828" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#B71C1C" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Form Fields Card -->
        <materialDesign:Card Grid.Row="2" Padding="20" UniformCornerRadius="8" Margin="0,0,0,18">
            <StackPanel>
                <!-- Category Input -->
                <TextBlock Text="Category *" Style="{StaticResource InputLabel}" />
                <ComboBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Categories}"
                          IsEditable="True"
                          Style="{StaticResource FormComboBox}"
                          Margin="0,0,0,14" />

                <!-- From Unit & To Unit Row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- From Unit Input -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="From Unit *" Style="{StaticResource InputLabel}" />
                        <ComboBox Text="{Binding FromUnit, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding AvailableUnits}"
                                  IsEditable="True"
                                  Style="{StaticResource FormComboBox}" />
                    </StackPanel>

                    <!-- Arrow Icon -->
                    <materialDesign:PackIcon Grid.Column="1" Kind="ArrowRightBold" Width="22" Height="22" Foreground="#00796B"
                                            VerticalAlignment="Center" Margin="10,20,10,0" />

                    <!-- To Unit Input -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To Unit *" Style="{StaticResource InputLabel}" />
                        <ComboBox Text="{Binding ToUnit, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding AvailableUnits}"
                                  IsEditable="True"
                                  Style="{StaticResource FormComboBox}" />
                    </StackPanel>
                </Grid>

                <!-- Multiplier Input -->
                <TextBlock Text="Multiplier * (To = From × Multiplier + Offset)" Style="{StaticResource InputLabel}" />
                <TextBox Text="{Binding MultiplierText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"
                         Margin="0,0,0,14" />

                <!-- Offset Input -->
                <TextBlock Text="Offset (Defaults to 0.0)" Style="{StaticResource InputLabel}" />
                <TextBox Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}" />
            </StackPanel>
        </materialDesign:Card>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    MinWidth="95" Height="36" Margin="0,0,10,0" />
            <Button Content="Save Conversion"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    MinWidth="140" Height="36" />
        </StackPanel>
    </Grid>
</Window>

