<UserControl x:Class="DrillIntel.Views.EditTimeLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             xmlns:models="clr-namespace:DrillIntel.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:EditTimeLogViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="650" d:DesignWidth="920"
             Background="#F1F5F9"
             FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif, Arial">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- Card Section Header Title -->
        <Style x:Key="CardHeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#E65100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- Card Outer Border -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Boxed Input TextBox Style -->
        <Style x:Key="BoxedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9800" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boxed ComboBox Style -->
        <Style x:Key="BoxedComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
            <RowDefinition Height="*" />    <!-- Content Tabs -->
            <RowDefinition Height="Auto" /> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="30" Height="30" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Table Name Badge -->
                <Border Grid.Column="2" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Table" Width="14" Height="14" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding DataTableName, FallbackValue='timeLog'}" FontSize="11" FontWeight="SemiBold" Foreground="#E65100" VerticalAlignment="Center" ToolTip="Underlying SQLite Data Table" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Status / Feedback Message -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,6" CornerRadius="4" 
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F5E9" />
                    <Setter Property="BorderBrush" Value="#C8E6C9" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Setter Property="BorderBrush" Value="#FFCDD2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="CheckCircle" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircle" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 3. TabControl for 3 Main Sections -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <!-- (1) Log Information Tab -->
            <TabItem Header="Log Information">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,2">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Log Information" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Log Information Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="FormatListBulletedType" Width="18" Height="18" Foreground="#E65100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="LOG METADATA &amp; IDENTIFICATION" Style="{StaticResource CardHeaderTitle}" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Log Name -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Log Name *" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource BoxedTextBox}" Text="{Binding LogName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Enter unique name for this timelog (pre-filled from vmx_time_log.log_name)" />
                                    </StackPanel>

                                    <!-- Run No -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Run No." Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource BoxedTextBox}" Text="{Binding RunNo, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Numeric run number (pre-filled from vmx_time_log.run_no)" />
                                    </StackPanel>

                                    <!-- Service Company -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Service Company" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource BoxedComboBox}" IsEditable="True" 
                                                  ItemsSource="{Binding AvailableServiceCompanies}"
                                                  Text="{Binding ServiceCompany, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Select or type the logging service company (pre-filled from vmx_time_log.service_company)" />
                                    </StackPanel>

                                    <!-- EDR Provider -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="EDR Provider" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource BoxedComboBox}" IsEditable="True"
                                                  ItemsSource="{Binding AvailableEdrProviders}"
                                                  Text="{Binding EdrProvider, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Select or type the Electronic Drilling Recorder provider (pre-filled from vmx_time_log.edr_provider)" />
                                    </StackPanel>

                                    <!-- Description -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource BoxedTextBox}" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Top"
                                                 ToolTip="Multi-line operational description or notes (pre-filled from vmx_time_log.description)" />
                                    </StackPanel>

                                    <!-- Checkboxes: Primary Log & Remarks Log -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox Content="Primary Log" IsChecked="{Binding PrimaryLog}" FontWeight="SemiBold" FontSize="12" Margin="0,0,24,0"
                                                  ToolTip="Mark this timelog as the primary log for this wellbore (pre-filled from vmx_time_log.primary_log)" />
                                        <CheckBox Content="Remarks Log" IsChecked="{Binding RemarksLog}" FontWeight="SemiBold" FontSize="12"
                                                  ToolTip="Mark this timelog as containing drilling remarks (pre-filled from vmx_time_log.remarks_log)" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hole Depth Section Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ArrowCollapseDown" Width="18" Height="18" Foreground="#E65100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="HOLE DEPTH CONFIGURATION" Style="{StaticResource CardHeaderTitle}" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Do not auto-calculate hole depth -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <CheckBox Content="Do not auto-calculate hole depth" 
                                                  IsChecked="{Binding NoAutoCalc}" 
                                                  FontWeight="SemiBold" FontSize="12"
                                                  ToolTip="Disable automatic hole depth calculation during imports and processing (from vmx_time_log.no_auto_calc)" />
                                    </StackPanel>

                                    <!-- Starting Hole Depth -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Starting Hole Depth" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource BoxedTextBox}" Text="{Binding StartingHoleDepth, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Numeric starting hole depth (from vmx_time_log.starting_hole_depth)" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- (2) Channels Tab -->
            <TabItem Header="Channels">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,2">
                            <materialDesign:PackIcon Kind="TableLarge" Width="16" Height="16" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Channels" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>

                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Action Buttons Toolbar -->
                        <RowDefinition Height="*" />    <!-- Channels DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Channels Action Buttons Toolbar -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Command="{Binding AddChannelCommand}" Height="28" Padding="10,0" Margin="0,0,6,0"
                                        Background="#E65100" BorderBrush="#E65100" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"
                                        ToolTip="Add a new channel row to this timelog">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Add Channel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding EditChannelCommand}" CommandParameter="{Binding SelectedChannel}" Height="28" Padding="10,0" Margin="0,0,6,0"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#374151" FontWeight="SemiBold" FontSize="11"
                                        ToolTip="Focus and edit the selected channel row">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Edit Channel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RemoveChannelCommand}" CommandParameter="{Binding SelectedChannel}" Height="28" Padding="10,0" Margin="0,0,6,0"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#D32F2F" FontWeight="SemiBold" FontSize="11"
                                        ToolTip="Remove the selected channel row">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Remove Channel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Command="{Binding ApplyUnitConversionProfileCommand}" Height="28" Padding="10,0"
                                        Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1565C0" FontWeight="SemiBold" FontSize="11"
                                        ToolTip="Apply standard unit conversion profile (Metric / Imperial) to channels">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="14" Height="14" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Apply Unit Conversion Profile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Channels Grid -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="1">
                        <DataGrid ItemsSource="{Binding Channels}" 
                                  SelectedItem="{Binding SelectedChannel}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeaderWidth="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="12"
                                  RowHeight="36"
                                  MinRowHeight="36"
                                  ColumnHeaderHeight="34"
                                  materialDesign:DataGridAssist.CellPadding="10 6"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="10 6"
                                  AlternatingRowBackground="#F8FAFC"
                                  RowBackground="#FFFFFF">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Setter Property="MinHeight" Value="36" />
                                    <Setter Property="Height" Value="36" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="Height" Value="34" />
                                    <Setter Property="Padding" Value="10,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <!-- Upload Checkbox -->
                                <DataGridCheckBoxColumn Header="Upload" Binding="{Binding Upload, UpdateSourceTrigger=PropertyChanged}" Width="65">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>

                                <!-- Mnemonic -->
                                <DataGridTextColumn Header="Mnemonic" Binding="{Binding Mnemonic, UpdateSourceTrigger=PropertyChanged}" Width="110" FontWeight="SemiBold">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Unit -->
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- VuMax Unit ID -->
                                <DataGridTextColumn Header="VuMax Unit ID" Binding="{Binding VuMaxUnitId, UpdateSourceTrigger=PropertyChanged}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Description -->
                                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="6,0" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Upload Mnemonic -->
                                <DataGridTextColumn Header="Upload Mnemonic" Binding="{Binding UploadMnemonic, UpdateSourceTrigger=PropertyChanged}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Value Type -->
                                <DataGridTextColumn Header="Value Type" Binding="{Binding ValueType, UpdateSourceTrigger=PropertyChanged}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Expression -->
                                <DataGridTextColumn Header="Expression" Binding="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Do Not Interpol -->
                                <DataGridCheckBoxColumn Header="Do Not Interpol" Binding="{Binding DoNotInterpol, UpdateSourceTrigger=PropertyChanged}" Width="110">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- (3) Link Time Log Tab -->
            <TabItem Header="Link Time Log">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,2">
                            <materialDesign:PackIcon Kind="LinkVariant" Width="16" Height="16" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Link Time Log" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Link Options Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="LinkBoxOutline" Width="18" Height="18" Foreground="#E65100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="PARENT TIMELOG LINKING" Style="{StaticResource CardHeaderTitle}" />
                                </Grid>

                                <!-- Master Checkbox: Link this time log to other time log -->
                                <CheckBox Content="Link this time log to other time log" 
                                          IsChecked="{Binding LinkToParent}"
                                          FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,14"
                                          ToolTip="Enable linking this child timelog to a parent timelog for continuous real-time processing" />

                                <!-- Sub-fields: Enabled only when LinkToParent is checked -->
                                <StackPanel IsEnabled="{Binding LinkToParent}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Well Dropdown -->
                                        <StackPanel Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="Well" Style="{StaticResource FieldLabel}" />
                                            <ComboBox Style="{StaticResource BoxedComboBox}"
                                                      ItemsSource="{Binding AvailableWells}"
                                                      SelectedItem="{Binding SelectedWellOption}"
                                                      DisplayMemberPath="WellName"
                                                      ToolTip="Select the parent well" />
                                        </StackPanel>

                                        <!-- Wellbore Dropdown -->
                                        <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock Text="Wellbore" Style="{StaticResource FieldLabel}" />
                                            <ComboBox Style="{StaticResource BoxedComboBox}"
                                                      ItemsSource="{Binding AvailableWellbores}"
                                                      SelectedItem="{Binding SelectedWellboreOption}"
                                                      DisplayMemberPath="WellboreName"
                                                      ToolTip="Select the parent wellbore" />
                                        </StackPanel>

                                        <!-- Time Log Dropdown -->
                                        <StackPanel Grid.Column="4" Margin="0,0,0,10">
                                            <TextBlock Text="Time Log" Style="{StaticResource FieldLabel}" />
                                            <ComboBox Style="{StaticResource BoxedComboBox}"
                                                      ItemsSource="{Binding AvailableTimeLogs}"
                                                      SelectedItem="{Binding SelectedTimeLogOption}"
                                                      DisplayMemberPath="LogName"
                                                      ToolTip="Select the available parent time log" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Checkbox: Do not move ahead than parent -->
                                    <CheckBox Content="Do not move ahead than parent" 
                                              IsChecked="{Binding DontMoveAhead}" 
                                              FontWeight="SemiBold" FontSize="12" Margin="0,4,0,12"
                                              ToolTip="Prevent this child timelog from advancing ahead of the parent log index" />

                                    <!-- Duplicate Action Dropdown -->
                                    <StackPanel Margin="0,0,0,12" MaxWidth="300" HorizontalAlignment="Left">
                                        <TextBlock Text="Duplicate Action" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource BoxedComboBox}"
                                                  ItemsSource="{Binding DuplicateActionOptions}"
                                                  SelectedItem="{Binding SelectedDuplicateAction}"
                                                  ToolTip="Resolution strategy when child log data overlaps parent log data (Merge Columns, Replace, Ignore)" />
                                    </StackPanel>

                                    <!-- Explanatory Note -->
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Select what to do when there is overlap in the data of parent and child time log." 
                                                       FontSize="11.5" Foreground="#1E40AF" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 4. General Controls (OK and Cancel at bottom right) -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,10" Margin="-16,8,-16,-12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Navigation hint -->
                <TextBlock Grid.Column="0" Text="All fields include instant tooltips. Click OK to save modifications." 
                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />

                <!-- Buttons: OK and Cancel -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding CancelCommand}" 
                            Height="30" Width="85" Margin="0,0,8,0"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                            Foreground="#475569" FontWeight="SemiBold" FontSize="11.5"
                            Content="Cancel" IsCancel="True" ToolTip="Cancel without saving changes" />

                    <Button Command="{Binding SaveCommand}" 
                            Height="30" Width="95" 
                            Background="#E65100" BorderBrush="#E65100" BorderThickness="1" 
                            Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5"
                            Content="OK" IsDefault="True" ToolTip="Save changes to this timelog" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
