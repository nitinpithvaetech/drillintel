<Window x:Class="DrillIntel.Views.ProcessTagCreationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        Title="Auto Tag Creation" 
        Height="500" Width="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Process Information -->
        <Border Grid.Row="0" Background="#E0F2F1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <materialDesign:PackIcon Grid.Column="0" Kind="TagMultipleOutline" Width="36" Height="36" Foreground="#00796B" VerticalAlignment="Center" Margin="0,0,12,0" />
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Automated Phase &amp; Activity Tag Detection" FontSize="18" FontWeight="Bold" Foreground="#004D40" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Well: " FontWeight="SemiBold" Foreground="#616161" />
                        <TextBlock Text="{Binding WellName}" FontWeight="Bold" Foreground="#212121" Margin="0,0,16,0" />
                        <TextBlock Text="Primary Log: " FontWeight="SemiBold" Foreground="#616161" />
                        <TextBlock Text="{Binding LogName}" Foreground="#212121" Margin="0,0,16,0" />
                        <TextBlock Text="Existing Tags: " FontWeight="SemiBold" Foreground="#616161" />
                        <TextBlock Text="{Binding ExistingTagsCount}" FontWeight="Bold" Foreground="#00796B" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Detection Parameters Summary -->
        <GroupBox Grid.Row="1" Header="Detection Configuration" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1" Padding="12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="4,0">
                        <TextBlock Text="Stand Height" FontSize="11" Foreground="#757575" />
                        <TextBlock Text="{Binding StandHeight, StringFormat='{}{0:F1} ft'}" FontSize="14" FontWeight="SemiBold" Foreground="#212121" Margin="0,2,0,0" />
                        <TextBlock Text="Height threshold for pipe stands" FontSize="10" Foreground="#9E9E9E" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0">
                        <TextBlock Text="Drilling Time Limit" FontSize="11" Foreground="#757575" />
                        <TextBlock Text="{Binding DrillingTimeLimit, StringFormat='{}{0} seconds'}" FontSize="14" FontWeight="SemiBold" Foreground="#212121" Margin="0,2,0,0" />
                        <TextBlock Text="Minimum duration (15 min)" FontSize="10" Foreground="#9E9E9E" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4,0">
                        <TextBlock Text="Depth Threshold" FontSize="11" Foreground="#757575" />
                        <TextBlock Text="{Binding DepthThreshold, StringFormat='{}{0:F1} ft'}" FontSize="14" FontWeight="SemiBold" Foreground="#212121" Margin="0,2,0,0" />
                        <TextBlock Text="Min distance for casing run" FontSize="10" Foreground="#9E9E9E" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Separator Background="#EEEEEE" Margin="0,0,0,8" />

                <CheckBox Content="Clear existing tags for this well before detection (recommended)"
                          IsChecked="{Binding ClearExistingTags}"
                          IsEnabled="{Binding CanStart}"
                          FontSize="12"
                          Foreground="#424242"
                          ToolTip="When checked, deletes obsolete/overlapping tags for this well before creating fresh tags." />
            </StackPanel>
        </GroupBox>

        <!-- Progress and Status -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <!-- Status Message -->
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressStatus}" FontSize="13" FontWeight="Medium" Foreground="#424242" TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat='{}{0:F1}%'}" FontSize="13" FontWeight="Bold" Foreground="#00796B" />
                </DockPanel>

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ProgressPercent}" 
                             Maximum="100" 
                             Height="12" 
                             materialDesign:TransitionAssist.DisableTransitions="True"
                             Foreground="#00897B"
                             Margin="0,0,0,8" />

                <!-- Error message if any -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#D32F2F" 
                           FontSize="12" 
                           TextWrapping="Wrap" 
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button DockPanel.Dock="Left" 
                    Command="{Binding OpenTagVisualizerCommand}" 
                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Foreground="#3949AB"
                    BorderBrush="#3949AB">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartTimelineVariantShimmer" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="View in Tag Graph" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" 
                    Content="{Binding CancelButtonText}" 
                    Command="{Binding CancelCommand}" 
                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                    MinWidth="100" 
                    Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" 
                    Content="Start Detection" 
                    Command="{Binding StartCommand}" 
                    IsEnabled="{Binding CanStart}"
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Background="#00897B"
                    BorderBrush="#00897B"
                    MinWidth="160" />
        </DockPanel>
    </Grid>
</Window>

