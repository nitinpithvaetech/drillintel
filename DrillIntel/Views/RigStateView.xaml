<UserControl x:Class="DrillIntel.Views.RigStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:RigStateViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="750" d:DesignWidth="1050"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

        <Style x:Key="TabHeaderIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="ParamCard" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="18" />
            <Setter Property="UniformCornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Status Alert -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Tabs -->
            <RowDefinition Height="*" />
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="CogSyncOutline" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="36" Height="36" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, FallbackValue='Rig State Master Configuration'}" 
                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" 
                               FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle, FallbackValue='Configure rig state classifications, identification cutoff thresholds, and auto-slide settings.'}" 
                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" 
                               FontSize="12" Opacity="0.9" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Status Alert Message -->
        <Border Grid.Row="1" Margin="0,0,0,12" CornerRadius="6" Padding="12,8"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F5E9" />
                    <Setter Property="BorderBrush" Value="#81C784" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Setter Property="BorderBrush" Value="#E57373" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="CheckCircleOutline" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1B5E20" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#B71C1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 3. TabControl for Rig State Configuration -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,16">

            <!-- TAB 1: Rig States -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FormatListNumbered" Style="{StaticResource TabHeaderIcon}" />
                        <TextBlock Text="Rig States" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <!-- Unknown State Definition Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Rig States Grid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Unknown State Configuration -->
                    <materialDesign:Card Grid.Row="0" Style="{StaticResource ParamCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Default Unknown Rig State (Fallback)" Style="{StaticResource SectionTitle}" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Number -->
                                <TextBox Grid.Column="0" 
                                         materialDesign:HintAssist.Hint="State Number" 
                                         Text="{Binding UnknownNumber, Mode=OneWay}" 
                                         IsReadOnly="True" 
                                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                         Margin="0,0,16,0" />

                                <!-- Name -->
                                <TextBox Grid.Column="1" 
                                         materialDesign:HintAssist.Hint="Unknown State Name" 
                                         Text="{Binding UnknownName, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                         Margin="0,0,16,0" />

                                <!-- Color Preview Swatch -->
                                <Border Grid.Column="2" 
                                        Background="{Binding UnknownColorHex, Converter={StaticResource HexToBrushConverter}}" 
                                        BorderBrush="#888888" BorderThickness="1" 
                                        CornerRadius="4" Height="32" Width="60" 
                                        VerticalAlignment="Center" HorizontalAlignment="Left" 
                                        ToolTip="Current Unknown Color" />

                                <!-- Hex Code -->
                                <TextBox Grid.Column="3" 
                                         materialDesign:HintAssist.Hint="Hex (#RRGGBB)" 
                                         Text="{Binding UnknownColorHex, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                         Margin="0,0,16,0" />

                                <!-- Quick Palettes for Unknown -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Preset:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                    <Button Background="#D50000" Width="22" Height="22" Padding="0" Margin="2,0" ToolTip="Red (#D50000)" 
                                            Command="{Binding SetUnknownColorHexCommand}" CommandParameter="#D50000" 
                                            Click="PresetUnknownColor_Click" Tag="#D50000" />
                                    <Button Background="#FF6D00" Width="22" Height="22" Padding="0" Margin="2,0" ToolTip="Orange (#FF6D00)" 
                                            Command="{Binding SetUnknownColorHexCommand}" CommandParameter="#FF6D00" 
                                            Click="PresetUnknownColor_Click" Tag="#FF6D00" />
                                    <Button Background="#FFD600" Width="22" Height="22" Padding="0" Margin="2,0" ToolTip="Amber (#FFD600)" 
                                            Command="{Binding SetUnknownColorHexCommand}" CommandParameter="#FFD600" 
                                            Click="PresetUnknownColor_Click" Tag="#FFD600" />
                                    <Button Background="#757575" Width="22" Height="22" Padding="0" Margin="2,0" ToolTip="Gray (#757575)" 
                                            Command="{Binding SetUnknownColorHexCommand}" CommandParameter="#757575" 
                                            Click="PresetUnknownColor_Click" Tag="#757575" />
                                    <Button Background="#000000" Width="22" Height="22" Padding="0" Margin="2,0" ToolTip="Black (#000000)" 
                                            Command="{Binding SetUnknownColorHexCommand}" CommandParameter="#000000" 
                                            Click="PresetUnknownColor_Click" Tag="#000000" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Rig State Items DataGrid -->
                    <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,8">
                                <TextBlock Text="Standard Rig States (28 States)" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                <TextBlock Text=" • Edit Name or Hex Color directly to update classification" Foreground="Gray" FontSize="12" Margin="10,2,0,0" />
                            </StackPanel>

                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding RigStateItems}" 
                                      SelectedItem="{Binding SelectedRigStateItem}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      HeadersVisibility="Column" 
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <!-- Number -->
                                    <DataGridTextColumn Header="No." Binding="{Binding Number}" IsReadOnly="True" Width="70" />

                                    <!-- Name -->
                                    <DataGridTemplateColumn Header="Rig State Name" Width="300">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Color Swatch -->
                                    <DataGridTemplateColumn Header="Color" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" 
                                                        Width="48" Height="22" CornerRadius="3" 
                                                        BorderBrush="#777777" BorderThickness="1" 
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Color Hex -->
                                    <DataGridTemplateColumn Header="Color Hex Code" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ColorHex}" VerticalAlignment="Center" FontFamily="Consolas" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Quick Color Selection Buttons -->
                                    <DataGridTemplateColumn Header="Color Presets" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Background="#00FF00" Width="18" Height="18" Padding="0" Margin="2,0" ToolTip="Green (#00FF00)" Command="{Binding SetColorHexCommand}" CommandParameter="#00FF00" Click="ItemColorPreset_Click" Tag="#00FF00" />
                                                    <Button Background="#00C853" Width="18" Height="18" Padding="0" Margin="2,0" ToolTip="Emerald (#00C853)" Command="{Binding SetColorHexCommand}" CommandParameter="#00C853" Click="ItemColorPreset_Click" Tag="#00C853" />
                                                    <Button Background="#808080" Width="18" Height="18" Padding="0" Margin="2,0" ToolTip="Gray (#808080)" Command="{Binding SetColorHexCommand}" CommandParameter="#808080" Click="ItemColorPreset_Click" Tag="#808080" />
                                                    <Button Background="#0000FF" Width="18" Height="18" Padding="0" Margin="2,0" ToolTip="Blue (#0000FF)" Command="{Binding SetColorHexCommand}" CommandParameter="#0000FF" Click="ItemColorPreset_Click" Tag="#0000FF" />
                                                    <Button Background="#8000FF" Width="18" Height="18" Padding="0" Margin="2,0" ToolTip="Purple (#8000FF)" Command="{Binding SetColorHexCommand}" CommandParameter="#8000FF" Click="ItemColorPreset_Click" Tag="#8000FF" />
                                                    <Button Background="#FFFF00" Width="18" Height="18" Padding="0" Margin="2,0" ToolTip="Yellow (#FFFF00)" Command="{Binding SetColorHexCommand}" CommandParameter="#FFFF00" Click="ItemColorPreset_Click" Tag="#FFFF00" />
                                                    <Button Background="#FF8000" Width="18" Height="18" Padding="0" Margin="2,0" ToolTip="Orange (#FF8000)" Command="{Binding SetColorHexCommand}" CommandParameter="#FF8000" Click="ItemColorPreset_Click" Tag="#FF8000" />
                                                    <Button Background="#FF0000" Width="18" Height="18" Padding="0" Margin="2,0" ToolTip="Red (#FF0000)" Command="{Binding SetColorHexCommand}" CommandParameter="#FF0000" Click="ItemColorPreset_Click" Tag="#FF0000" />
                                                    <Button Background="#00FFFF" Width="18" Height="18" Padding="0" Margin="2,0" ToolTip="Cyan (#00FFFF)" Command="{Binding SetColorHexCommand}" CommandParameter="#00FFFF" Click="ItemColorPreset_Click" Tag="#00FFFF" />
                                                    <Button Background="#FFFFFF" Width="18" Height="18" Padding="0" Margin="2,0" BorderBrush="#888" BorderThickness="1" ToolTip="White (#FFFFFF)" Command="{Binding SetColorHexCommand}" CommandParameter="#FFFFFF" Click="ItemColorPreset_Click" Tag="#FFFFFF" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- TAB 2: Threshold Values -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Speedometer" Style="{StaticResource TabHeaderIcon}" />
                        <TextBlock Text="Threshold Values" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">

                        <!-- Card 1: Drilling Cutoff Values -->
                        <materialDesign:Card Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="Primary Drilling CutOffs &amp; Sensitivities" Style="{StaticResource SectionTitle}" />

                                <UniformGrid Columns="3" Margin="0,4,0,0">
                                    <!-- Hookload CutOff -->
                                    <TextBox materialDesign:HintAssist.Hint="Hookload CutOff (HKLD)" 
                                             materialDesign:HintAssist.HelperText="{Binding HookloadUnit, StringFormat='Unit: {0}'}" 
                                             Text="{Binding HookloadCutOff, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                             Margin="8,4,8,12" />

                                    <!-- RPM CutOff -->
                                    <TextBox materialDesign:HintAssist.Hint="RPM CutOff" 
                                             materialDesign:HintAssist.HelperText="Unit: rpm" 
                                             Text="{Binding RPMCutOff, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                             Margin="8,4,8,12" />

                                    <!-- CIRC CutOff -->
                                    <TextBox materialDesign:HintAssist.Hint="Circulation CutOff (CIRC)" 
                                             materialDesign:HintAssist.HelperText="{Binding CircUnit, StringFormat='Unit: {0}'}" 
                                             Text="{Binding CIRCCutOff, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                             Margin="8,4,8,12" />

                                    <!-- Sensitivity / Block Movement -->
                                    <TextBox materialDesign:HintAssist.Hint="Sensitivity (Block Movement)" 
                                             materialDesign:HintAssist.HelperText="{Binding MovementUnit, StringFormat='Unit: {0}'}" 
                                             Text="{Binding Sensitivity, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                             Margin="8,4,8,12" />

                                    <!-- Pump Pressure CutOff -->
                                    <TextBox materialDesign:HintAssist.Hint="Pump Pressure CutOff (SPPA)" 
                                             materialDesign:HintAssist.HelperText="{Binding PumpUnit, StringFormat='Unit: {0}'}" 
                                             Text="{Binding PumpPressureCutOff, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                             Margin="8,4,8,12" />

                                    <!-- Depth Comparison Sensitivity -->
                                    <TextBox materialDesign:HintAssist.Hint="Depth Comparison Sensitivity" 
                                             materialDesign:HintAssist.HelperText="{Binding MovementUnit, StringFormat='Unit: {0}'}" 
                                             Text="{Binding DepthComparisonSens, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                             Margin="8,4,8,12" />
                                </UniformGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Card 2: Air Drilling & Pipe Movement -->
                        <materialDesign:Card Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="Air Drilling &amp; Pipe Movement Detection" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Air Drilling Group -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                        <CheckBox Content="Detect Air Drilling" 
                                                  IsChecked="{Binding DetectAirDrilling}" 
                                                  FontWeight="SemiBold" Margin="8,0,0,8" />

                                        <UniformGrid Columns="3">
                                            <TextBox materialDesign:HintAssist.Hint="Air Pressure CutOff" 
                                                     materialDesign:HintAssist.HelperText="{Binding AirPressureUnit, StringFormat='Unit: {0}'}" 
                                                     Text="{Binding AirPressure, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                                     IsEnabled="{Binding DetectAirDrilling}" 
                                                     Margin="8,4,8,8" />

                                            <TextBox materialDesign:HintAssist.Hint="Mist Flow CutOff" 
                                                     materialDesign:HintAssist.HelperText="{Binding MistFlowUnit, StringFormat='Unit: {0}'}" 
                                                     Text="{Binding MistFlowCutOff, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                                     IsEnabled="{Binding DetectAirDrilling}" 
                                                     Margin="8,4,8,8" />

                                            <TextBox materialDesign:HintAssist.Hint="Torque CutOff" 
                                                     materialDesign:HintAssist.HelperText="{Binding StorUnit, StringFormat='Unit: {0}'}" 
                                                     Text="{Binding TorqueCutOff, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                                     IsEnabled="{Binding DetectAirDrilling}" 
                                                     Margin="8,4,8,8" />
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- Pipe Movement Group -->
                                    <StackPanel Grid.Row="1">
                                        <CheckBox Content="Detect Pipe Movement" 
                                                  IsChecked="{Binding DetectPipeMovement}" 
                                                  FontWeight="SemiBold" Margin="8,0,0,8" />

                                        <Grid Width="300" HorizontalAlignment="Left">
                                            <TextBox materialDesign:HintAssist.Hint="Pipe Movement Threshold" 
                                                     materialDesign:HintAssist.HelperText="{Binding MovementUnit, StringFormat='Unit: {0}'}" 
                                                     Text="{Binding PipeMovementThreshold, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                                     IsEnabled="{Binding DetectPipeMovement}" 
                                                     Margin="8,4,8,8" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Card 3: Calibration Sets (Set 1 / Set 2 / Set 3) -->
                        <materialDesign:Card Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Torque &amp; RPM Calibration Parameter Sets" Style="{StaticResource SectionTitle}" Margin="0" />
                                    <!-- Set Selector RadioButtons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton Content="Default Set (Set 1)" IsChecked="{Binding IsDefaultSetSelected}" GroupName="CalibrationSets" Margin="0,0,16,0" FontWeight="Medium" />
                                        <RadioButton Content="Set 2" IsChecked="{Binding IsSet2Selected}" GroupName="CalibrationSets" Margin="0,0,16,0" FontWeight="Medium" />
                                        <RadioButton Content="Set 3" IsChecked="{Binding IsSet3Selected}" GroupName="CalibrationSets" FontWeight="Medium" />
                                    </StackPanel>
                                </Grid>

                                <!-- Set 1 Fields -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,4,0,12"
                                        Visibility="{Binding IsDefaultSetSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Default Set Parameters" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8" />
                                        <UniformGrid Columns="3">
                                            <TextBox materialDesign:HintAssist.Hint="Min Torque" Text="{Binding TorqueMin, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Max Torque" Text="{Binding TorqueMax, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Calibration Rows" Text="{Binding CalibrationRows, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Min Torque Diff" Text="{Binding MinTorqueDifference, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Min RPM" Text="{Binding MinRPM, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Max RPM" Text="{Binding MaxRPM, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Set 2 Fields -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,4,0,12"
                                        Visibility="{Binding IsSet2Selected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Set 2 Parameters" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8" />
                                        <UniformGrid Columns="3">
                                            <TextBox materialDesign:HintAssist.Hint="Min Torque 2" Text="{Binding TorqueMin2, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Max Torque 2" Text="{Binding TorqueMax2, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Calibration Rows 2" Text="{Binding CalibrationRows2, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Min Torque Diff 2" Text="{Binding MinTorqueDifference2, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Min RPM 2" Text="{Binding MinRPM2, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Max RPM 2" Text="{Binding MaxRPM2, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Set 3 Fields -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,4,0,12"
                                        Visibility="{Binding IsSet3Selected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Set 3 Parameters" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8" />
                                        <UniformGrid Columns="3">
                                            <TextBox materialDesign:HintAssist.Hint="Min Torque 3" Text="{Binding TorqueMin3, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Max Torque 3" Text="{Binding TorqueMax3, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Calibration Rows 3" Text="{Binding CalibrationRows3, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Min Torque Diff 3" Text="{Binding MinTorqueDifference3, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Min RPM 3" Text="{Binding MinRPM3, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                            <TextBox materialDesign:HintAssist.Hint="Max RPM 3" Text="{Binding MaxRPM3, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="8,4" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Detect Auto Slide Drilling -->
                                <CheckBox Content="Detect Auto Slide Drilling" 
                                          IsChecked="{Binding DetectAutoSlideDrilling}" 
                                          FontWeight="SemiBold" Margin="8,8,0,0" />
                            </StackPanel>
                        </materialDesign:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Auto Slide Parameters -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tune" Style="{StaticResource TabHeaderIcon}" />
                        <TextBlock Text="Auto Slide Parameters" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <materialDesign:Card Style="{StaticResource ParamCard}" Margin="12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Auto Slide Drilling Parameters" Style="{StaticResource SectionTitle}" />

                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <!-- Max RPM -->
                            <TextBox materialDesign:HintAssist.Hint="Max RPM" 
                                     materialDesign:HintAssist.HelperText="Unit: rpm" 
                                     Text="{Binding AutoSlideMaxRPM, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                     Margin="8,8,24,16" />

                            <!-- Torque Cycles -->
                            <TextBox materialDesign:HintAssist.Hint="Number of Torque Cycles" 
                                     materialDesign:HintAssist.HelperText="Integer cycles count" 
                                     Text="{Binding TorqueCycles, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                     Margin="8,8,24,16" />

                            <!-- Percent Window -->
                            <TextBox materialDesign:HintAssist.Hint="Percent Window" 
                                     materialDesign:HintAssist.HelperText="Threshold window %" 
                                     Text="{Binding PercentWindow, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                     Margin="8,8,24,16" />

                            <!-- Calibration Time -->
                            <TextBox materialDesign:HintAssist.Hint="Calibration Time" 
                                     materialDesign:HintAssist.HelperText="Duration time units" 
                                     Text="{Binding CalibrationTime, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" 
                                     Margin="8,8,24,16" />
                        </UniformGrid>
                    </StackPanel>
                </materialDesign:Card>
            </TabItem>

            <!-- TAB 4: Auto Slide Calibration Table -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Table" Style="{StaticResource TabHeaderIcon}" />
                        <TextBlock Text="Auto Slide Parameters (2)" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{DynamicResource MaterialDesignRaisedButton}" 
                                Command="{Binding AddAutoSlideRowCommand}" 
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Add Calibration Row" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{DynamicResource MaterialDesignOutlinedButton}" 
                                Command="{Binding RemoveAutoSlideRowCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Remove Selected Row" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" Padding="8">
                        <DataGrid ItemsSource="{Binding AutoSlideRows}" 
                                  SelectedItem="{Binding SelectedAutoSlideRow}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  GridLinesVisibility="All" 
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="From Depth" Binding="{Binding FromDepth, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <DataGridTextColumn Header="To Depth" Binding="{Binding ToDepth, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <DataGridTextColumn Header="Min Torque" Binding="{Binding MinTorque, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <DataGridTextColumn Header="Max Torque" Binding="{Binding MaxTorque, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <DataGridTextColumn Header="Calib Rows" Binding="{Binding CalibrationRows, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                <DataGridTextColumn Header="Min Torque Diff" Binding="{Binding MinTorqueDiff, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                <DataGridTextColumn Header="Min RPM" Binding="{Binding MinRPM, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                <DataGridTextColumn Header="Max RPM" Binding="{Binding MaxRPM, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- 4. Bottom Actions Toolbar -->
        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="14,12" Margin="-20,0,-20,-20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Reset Button -->
                <Button Grid.Column="0" 
                        Style="{DynamicResource MaterialDesignOutlinedButton}" 
                        Command="{Binding ResetCommand}" 
                        ToolTip="Reload saved setup and default states from database">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="RESET TO SAVED" VerticalAlignment="Center" FontWeight="Medium" />
                    </StackPanel>
                </Button>

                <!-- Right: Cancel & Save Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{DynamicResource MaterialDesignOutlinedButton}" 
                            Command="{Binding CancelCommand}" 
                            Width="110" Margin="0,0,12,0" 
                            Content="CANCEL" />

                    <Button Style="{DynamicResource MaterialDesignRaisedButton}" 
                            Command="{Binding SaveCommand}" 
                            Width="180" FontWeight="Bold"
                            ToolTip="Save all rig state detection thresholds, colors, and auto-slide settings to SQLite">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="SAVE SETUP" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

