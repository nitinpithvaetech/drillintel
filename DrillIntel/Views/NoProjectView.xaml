<UserControl x:Class="DrillIntel.Views.NoProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             xmlns:models="clr-namespace:DrillIntel.Models"
             d:DataContext="{d:DesignInstance Type=viewmodels:NoProjectViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <!-- Style for Action Card buttons -->
        <Style x:Key="ActionCardBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="Padding" Value="20" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#BDBDBD" />
                    <Setter Property="Background" Value="#F5F5F5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Recent Project item container -->
        <Style x:Key="RecentProjectItemBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#EAEAEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#90CAF9" />
                    <Setter Property="Background" Value="#F4F9FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,20" MaxWidth="1050">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Branding -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,22">
                <Border Width="84" Height="84" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Direction="270" RenderingBias="Quality" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
                    </Border.Effect>
                    <Image Source="pack://application:,,,/DrillIntel;component/Assets/app_icon.png" 
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"/>
                </Border>

                <TextBlock Text="Welcome to DrillIntel" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8" />

                <!-- Industrial Tagline Badge -->
                <Border Background="#0D1976D2" CornerRadius="16" Padding="16,6" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Brain" Foreground="#1976D2" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="The rig's second brain — drill smarter, not harder" FontSize="13" FontWeight="SemiBold" Foreground="#1976D2" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Drilling Data Intelligence, Real-Time QC &amp; Rig State Analytics" FontSize="13" Foreground="#757575" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Main Content: Recent Projects & Get Started same height, Capabilities spanning both -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="480" />
                </Grid.ColumnDefinitions>

                <!-- Row 0, Column 0: Recent Projects Card (Same Height as Get Started Card) -->
                <materialDesign:Card Grid.Row="0" Grid.Column="0" VerticalAlignment="Stretch" Padding="20" UniformCornerRadius="14" materialDesign:ElevationAssist.Elevation="Dp2">
                    <DockPanel LastChildFill="True">
                        <!-- Card Header -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="History" Width="22" Height="22" Foreground="#1976D2" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Recent Projects" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Clear all button -->
                            <Button Grid.Column="2" 
                                    Style="{StaticResource MaterialDesignToolButton}" 
                                    Command="{Binding ClearRecentProjectsCommand}"
                                    ToolTip="Clear Recent Projects"
                                    Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Padding="6,2" Height="28">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Clear List" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Search Filter Box (only shown if there are recent projects) -->
                        <Border DockPanel.Dock="Top" 
                                Background="#F5F7FA" 
                                CornerRadius="8" 
                                Padding="10,4" 
                                Margin="0,0,0,12"
                                Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Filter recent projects..." 
                                         BorderThickness="0" 
                                         Background="Transparent" 
                                         FontSize="12" 
                                         VerticalAlignment="Center" />
                                <Button Grid.Column="2" 
                                        Style="{StaticResource MaterialDesignToolButton}" 
                                        Command="{Binding ClearSearchCommand}"
                                        Width="18" Height="18" Padding="0"
                                        Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="CloseCircle" Width="14" Height="14" Foreground="#9E9E9E" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content Area (fills remaining vertical space) -->
                        <Grid VerticalAlignment="Stretch">
                            <!-- Empty State: No Recent Projects (Only visible when ShowEmptyState is true) -->
                            <Border Background="#F9FAFB" CornerRadius="10" Padding="20,32" Margin="0,2,0,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FolderClockOutline" Width="44" Height="44" Foreground="#B0BEC5" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="No Recent Projects" FontSize="15" FontWeight="SemiBold" Foreground="#607D8B" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="Projects you create or open will appear here for quick access." 
                                               FontSize="12" Foreground="#90A4AE" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" LineHeight="17" />
                                </StackPanel>
                            </Border>

                            <!-- No Results for Search Filter (Only visible when ShowNoSearchResults is true) -->
                            <Border Background="#F9FAFB" CornerRadius="10" Padding="20,28" Margin="0,2,0,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowNoSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FileSearchOutline" Width="36" Height="36" Foreground="#B0BEC5" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="No matching projects found" FontSize="13" FontWeight="SemiBold" Foreground="#607D8B" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="Try searching for a different keyword or clear filter." FontSize="11" Foreground="#90A4AE" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Items List (Only visible when ShowProjectsList is true) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Stretch"
                                          Visibility="{Binding ShowProjectsList, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding RecentProjects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RecentProject}">
                                            <Border Style="{StaticResource RecentProjectItemBorder}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open Project" 
                                                                  Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="FolderOpen" Foreground="#FF9800" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Toggle Pin" 
                                                                  Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Pin" Foreground="#1976D2" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Open Containing Folder" 
                                                                  Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="FolderOutline" Foreground="#607D8B" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="Remove from List" 
                                                                  Command="{Binding DataContext.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Close" Foreground="#E91E63" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#EDE7F6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Database" Width="18" Height="18" Foreground="#673AB7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Clickable Info Section -->
                                                    <Button Grid.Column="1" 
                                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                                            Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}"
                                                            HorizontalContentAlignment="Left" 
                                                            VerticalContentAlignment="Center" 
                                                            Padding="0" 
                                                            Height="Auto">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <!-- Row 1: Project Name + Well Chip -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProjectName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                                                
                                                                <Border Background="#E8F5E9" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding WellName, Converter={StaticResource StringToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding WellAndFieldDisplay}" FontSize="10.5" Foreground="#2E7D32" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Row 2: File Path -->
                                                            <TextBlock Text="{Binding FilePath}" 
                                                                       ToolTip="{Binding FilePath}" 
                                                                       FontSize="10.5" 
                                                                       Foreground="#757575" 
                                                                       TextTrimming="CharacterEllipsis" 
                                                                       Margin="0,2,0,2" />

                                                            <!-- Row 3: Timestamp & File Size & Missing indicator -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="ClockOutline" Width="11" Height="11" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <TextBlock Text="{Binding LastOpenedDisplay}" FontSize="10.5" Foreground="#9E9E9E" VerticalAlignment="Center" />
                                                                <TextBlock Text="•" FontSize="10.5" Foreground="#BDBDBD" Margin="5,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding FileSizeDisplay}" FontSize="10.5" Foreground="#9E9E9E" VerticalAlignment="Center" />

                                                                <!-- Warning if file missing -->
                                                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                                                                            Visibility="{Binding FileExists, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#E53935" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                                    <TextBlock Text="File Missing" FontSize="10" Foreground="#E53935" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Right Actions: Pin, Folder, Remove -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                        <!-- Pin Button -->
                                                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Pin / Unpin project"
                                                                Width="26" Height="26" Padding="0">
                                                            <Grid>
                                                                <materialDesign:PackIcon Kind="Pin" Foreground="#1976D2" Width="15" Height="15" 
                                                                                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <materialDesign:PackIcon Kind="PinOutline" Foreground="#BDBDBD" Width="15" Height="15" 
                                                                                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                            </Grid>
                                                        </Button>

                                                        <!-- Open Folder Button -->
                                                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                                                Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Open containing folder"
                                                                Width="26" Height="26" Padding="0">
                                                            <materialDesign:PackIcon Kind="FolderOpenOutline" Foreground="#757575" Width="15" Height="15" />
                                                        </Button>

                                                        <!-- Remove Button -->
                                                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                                                Command="{Binding DataContext.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Remove from recent projects"
                                                                Width="26" Height="26" Padding="0">
                                                            <materialDesign:PackIcon Kind="Close" Foreground="#9E9E9E" Width="15" Height="15" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Row 0, Column 2: Get Started Card (Same Height as Recent Projects Card) -->
                <materialDesign:Card Grid.Row="0" Grid.Column="2" VerticalAlignment="Stretch" Padding="22" UniformCornerRadius="14" materialDesign:ElevationAssist.Elevation="Dp2">
                    <DockPanel LastChildFill="True">
                        <!-- Section Title -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="24" Height="24" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Get Started" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <!-- New Project Action Card -->
                            <Border Style="{StaticResource ActionCardBorder}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <materialDesign:PackIcon Kind="FolderPlus" Width="28" Height="28" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="New Project" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Create a fresh project database (.dintel) with VMX SQLite schema and well details." 
                                               FontSize="12.5" Foreground="#616161" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18" />
                                    <Button Grid.Row="2" Content="CREATE PROJECT" Command="{Binding NewProjectCommand}" 
                                            Style="{StaticResource MaterialDesignRaisedButton}" 
                                            Background="#4CAF50" BorderBrush="#4CAF50" Height="42" FontSize="13" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <!-- Open Project Action Card -->
                            <Border Style="{StaticResource ActionCardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="28" Height="28" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Open Existing Project" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Browse your computer for an existing .dintel project database." 
                                               FontSize="12.5" Foreground="#616161" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18" />
                                    <Button Grid.Row="2" Content="BROWSE FILES" Command="{Binding LoadProjectCommand}" 
                                            Style="{StaticResource MaterialDesignRaisedButton}" 
                                            Background="#FF9800" BorderBrush="#FF9800" Height="42" FontSize="13" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Row 1, Column 0, ColumnSpan 3: Platform Capabilities Card Spanning Both Columns -->
                <materialDesign:Card Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0" Padding="20,16" UniformCornerRadius="14" materialDesign:ElevationAssist.Elevation="Dp1" Background="#FAFAFA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Foreground="#1976D2" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Platform Capabilities" FontSize="14" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Capabilities Row (3 columns spanning full width) -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#4CAF50" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="WITSML &amp; CSV Timelog &amp; Depthlog Import" FontSize="12" Foreground="#424242" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#4CAF50" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Automated Rig State Detection &amp; Analysis" FontSize="12" Foreground="#424242" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#4CAF50" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Drilling KPIs &amp; Broomstick Performance" FontSize="12" Foreground="#424242" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

