<Window x:Class="DrillIntel.Views.RigStateDocumentManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:conv="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:RigStateDocumentManagerViewModel}"
        Title="Rig State Document Manager"
        Width="880" Height="560"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <!-- Converters -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <!-- DataGrid Row Style -->
        <Style x:Key="DocGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                    <Setter Property="Foreground" Value="#312E81" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Search Box Style -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="32,2,8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <Grid>
                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="32,0,8,0" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header & Search Strip -->
            <RowDefinition Height="Auto" />
            <!-- 1: Master-Detail Content Area -->
            <RowDefinition Height="*" />
            <!-- 2: Action Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Search Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- Title & Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="8" Background="#EEF2FF" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="22" Height="22" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Rig State Documents" FontSize="16" FontWeight="Bold" Foreground="#1E1B4B" />
                        <Border Background="#E0E7FF" CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Documents.Count, StringFormat='{}{0} templates'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#4338CA" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Manage, customize, and switch between saved track layouts in this project." FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Search Filter -->
            <TextBox Grid.Column="1" 
                     Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource SearchTextBox}"
                     VerticalAlignment="Center"
                     materialDesign:HintAssist.Hint="Search documents..." />
        </Grid>

        <!-- Master-Detail Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Master List -->
                <ColumnDefinition Width="3*" MinWidth="340" />
                <!-- Splitter -->
                <ColumnDefinition Width="14" />
                <!-- Detail Inspector -->
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Master List Card -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                <DataGrid ItemsSource="{Binding Documents}" 
                          SelectedItem="{Binding SelectedDocument}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          RowStyle="{StaticResource DocGridRowStyle}"
                          BorderThickness="0"
                          Background="Transparent"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="34">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#475569" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Default Indicator -->
                        <DataGridTemplateColumn Width="36" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon Kind="Star" Width="16" Height="16" 
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="#D97706"
                                                             Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             ToolTip="Default project document" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Document Name -->
                        <DataGridTemplateColumn Width="2*" Header="Document Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" />
                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Layout Structure -->
                        <DataGridTemplateColumn Width="110" Header="Layout">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracks'}" FontSize="10.5" FontWeight="Medium" Foreground="#334155" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Orientation -->
                        <DataGridTemplateColumn Width="90" Header="Orientation">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OrientationDisplay}" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Modified Date -->
                        <DataGridTextColumn Width="110" Header="Modified" Binding="{Binding ModifiedDateDisplay}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detail Inspector Card -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <!-- Empty Selection Placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="CursorDefaultClickOutline" Width="36" Height="36" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a document to inspect" FontSize="12" Foreground="#94A3B8" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Details Content -->
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <!-- Title & Badges -->
                            <RowDefinition Height="Auto" />
                            <!-- Description -->
                            <RowDefinition Height="Auto" />
                            <!-- Metrics Grid -->
                            <RowDefinition Height="*" />
                            <!-- Item Action Buttons -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Document Title & Badge -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDocument.DocumentName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedDocument.IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="12" Height="12" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="Default" FontSize="10" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Description Box -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DESCRIPTION" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedDocument.Description, FallbackValue='(No description)'}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Properties Grid -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="CONFIGURATION DETAILS" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tracks:" FontSize="11.5" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocument.TrackCount}" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F172A" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total Curves:" FontSize="11.5" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocument.ChannelCount}" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F172A" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Orientation:" FontSize="11.5" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocument.OrientationDisplay}" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F172A" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Created By:" FontSize="11.5" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocument.CreatedBy}" FontSize="11.5" Foreground="#0F172A" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Last Modified:" FontSize="11.5" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDocument.ModifiedDateDisplay}" FontSize="11.5" Foreground="#0F172A" />
                            </Grid>
                        </StackPanel>

                        <!-- Item Actions -->
                        <Border Grid.Row="3" Padding="0,12,0,0" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding SetAsDefaultCommand}" 
                                        ToolTip="Set this template as the default document to open from the Ribbon"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="30" Padding="8,0" Margin="0,0,6,0" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="StarOutline" Width="14" Height="14" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Set Default" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding DuplicateCommand}" 
                                        ToolTip="Create a duplicate copy of this document layout"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="30" Padding="8,0" Margin="0,0,6,0" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Duplicate" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding DeleteCommand}" 
                                        IsEnabled="{Binding CanDeleteSelection}"
                                        ToolTip="Delete this document template"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        BorderBrush="#FCA5A5" Foreground="#DC2626"
                                        Height="30" Padding="8,0" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,2,0" />
                                        <TextBlock Text="Delete" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Actions Bar -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CloseCommand}" 
                            Content="Close" 
                            Width="84" Height="34" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            BorderBrush="#CBD5E1" Foreground="#475569" 
                            FontSize="11.5" Margin="0,0,10,0" />

                    <Button Command="{Binding OpenSelectedCommand}" 
                            IsEnabled="{Binding HasSelection}"
                            Height="34" Padding="16,0"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#4F46E5" Foreground="White" 
                            FontSize="12" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Open / Run Document" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18" Color="#4F46E5" />
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

