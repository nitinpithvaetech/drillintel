<UserControl x:Class="DrillIntel.Views.TagVisualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:graph="clr-namespace:DrillIntel.Controls.TagVisualizer"
             xmlns:controls="clr-namespace:DrillIntel.Controls"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:TagVisualizerViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F1F5F9">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Command Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Main Graph & Adjustment Panel Area -->
            <RowDefinition Height="*" />
            <!-- 2: Collapsible Tag Data Table -->
            <RowDefinition Height="Auto" />
            <!-- 3: Status & Navigation Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: Header & Action Toolbar                                    -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Meta -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartTimelineVariantShimmer" Width="28" Height="28" Foreground="#3949AB" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Phase Tag Visualizer" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                            <Border Background="#EEF2FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Depth vs DateTime" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding WellName, StringFormat='Well: {0}'}" FontSize="12" Foreground="#64748B" />
                            <TextBlock Text=" • " FontSize="12" Foreground="#94A3B8" Margin="4,0" />
                            <TextBlock Text="{Binding LogName, StringFormat='Log: {0}'}" FontSize="12" Foreground="#64748B" />
                            <TextBlock Text=" • " FontSize="12" Foreground="#94A3B8" Margin="4,0" />
                            <TextBlock Text="{Binding Tags.Count, StringFormat='{}{0} Phase Tags'}" FontSize="12" FontWeight="SemiBold" Foreground="#00897B" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Center / Right Toolbar Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom Controls -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom In Time Axis" Width="32" Height="30" Padding="0">
                                <materialDesign:PackIcon Kind="MagnifyPlusOutline" Width="18" Height="18" Foreground="#334155" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out Time Axis" Width="32" Height="30" Padding="0">
                                <materialDesign:PackIcon Kind="MagnifyMinusOutline" Width="18" Height="18" Foreground="#334155" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding ResetZoomCommand}" ToolTip="Reset Zoom / Fit All" Width="32" Height="30" Padding="0">
                                <materialDesign:PackIcon Kind="FitToPageOutline" Width="18" Height="18" Foreground="#334155" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- View Options -->
                    <CheckBox Content="Depth 0 at Top ↓" IsChecked="{Binding InvertDepth}" FontWeight="SemiBold" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox Content="Gridlines" IsChecked="{Binding ShowGridLines}" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <!-- Add Tag Button -->
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding AddTagCommand}" ToolTip="Insert new tag interval" Height="32" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TagPlusOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Add Tag" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Save to Database Button -->
                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Command="{Binding SaveToDatabaseCommand}"
                            Background="#00897B" BorderBrush="#00897B" Foreground="White" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Save to Database" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: Interactive Graph Canvas + Right Adjustment Panel           -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <!-- 0: Graph Canvas (Takes remaining space) -->
                <ColumnDefinition Width="*" />
                <!-- 1: Splitter -->
                <ColumnDefinition Width="6" />
                <!-- 2: Tag Adjustment & Property Inspector Panel -->
                <ColumnDefinition Width="360" MinWidth="300" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Interactive Graph Canvas + Data Selector Below Chart -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- 0: Graph Canvas Card -->
                    <RowDefinition Height="*" />
                    <!-- 1: Navigation & Range Preset Command Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: Data Selector Range TrackBar Scroller -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 0: Interactive Graph Canvas Card -->
                <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6,6,0,0" ClipToBounds="True">
                    <Grid>
                        <graph:DepthTimeTagGraphControl DataContext="{Binding}" />

                        <!-- Floating Legend Overlay in Top-Right Corner -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Background="#EEFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <!-- Drilling -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Rectangle Width="10" Height="10" Fill="#2E7D32" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Drilling" FontSize="10" Foreground="#334155" />
                                </StackPanel>
                                <!-- Rig Up -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Rectangle Width="10" Height="10" Fill="#EF6C00" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Rig Up" FontSize="10" Foreground="#334155" />
                                </StackPanel>
                                <!-- CUC -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Rectangle Width="10" Height="10" Fill="#7B1FA2" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="CUC" FontSize="10" Foreground="#334155" />
                                </StackPanel>
                                <!-- Trip Out -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Rectangle Width="10" Height="10" Fill="#C62828" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Trip Out" FontSize="10" Foreground="#334155" />
                                </StackPanel>
                                <!-- Trip In -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Rectangle Width="10" Height="10" Fill="#1565C0" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Trip In" FontSize="10" Foreground="#334155" />
                                </StackPanel>
                                <!-- Casing -->
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="10" Height="10" Fill="#00897B" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Casing" FontSize="10" Foreground="#334155" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 1: Navigation & Date Range Control Bar (Above dataSelector TrackBar) -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Preset Dropdown & Zoom to Tag Button -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Preset Range:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding RangePresets}" 
                                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                      Width="120" Height="28" VerticalContentAlignment="Center" FontSize="11" Margin="0,0,8,0" />

                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding ZoomToSelectedTagCommand}"
                                    ToolTip="Zoom chart timeline directly to the active selected phase tag" Height="28" Padding="8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#3949AB" />
                                    <TextBlock Text="Zoom to Tag" FontSize="11" Foreground="#3949AB" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right: From - To Text Boxes & Apply Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="From:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBox Text="{Binding FromDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                         BorderThickness="0" Background="Transparent"
                                         Width="125" Height="22" FontSize="11" FontWeight="SemiBold"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         ToolTip="Enter Start Date &amp; Time (dd-MM-yyyy HH:mm)" />
                            </Border>

                            <TextBlock Text="To:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBox Text="{Binding ToDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                         BorderThickness="0" Background="Transparent"
                                         Width="125" Height="22" FontSize="11" FontWeight="SemiBold"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         ToolTip="Enter End Date &amp; Time (dd-MM-yyyy HH:mm)" />
                            </Border>

                            <Button Command="{Binding ApplyDateTimeRangeCommand}" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Background="#1976D2" Foreground="White"
                                    Height="28" Padding="12,0" Margin="8,0,0,0"
                                    ToolTip="Apply custom date/time range to chart">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Check" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Apply" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2: Data Selector Range TrackBar Scroller (Plug & Play UserControl) -->
                <controls:RangeTrackBarControl Grid.Row="2" Margin="0,4,0,0"
                                               Minimum="{Binding TrackBarMin}"
                                               Maximum="{Binding TrackBarMax}"
                                               SelectionStart="{Binding TrackBarSelectionStart, Mode=TwoWay}"
                                               SelectionEnd="{Binding TrackBarSelectionEnd, Mode=TwoWay}"
                                               IsTimeLog="True"
                                               OverviewPoints="{Binding TrackBarOverviewPoints}"
                                               OverviewChannelName="{Binding TrackBarOverviewChannelName}"
                                               OverviewStroke="{Binding TrackBarOverviewBrush}"
                                               RangeChanged="OnRangeTrackBarChanged" />
            </Grid>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ============================================================= -->
            <!-- RIGHT PANEL: Tag Property Inspector & Live Nudge Adjuster     -->
            <!-- ============================================================= -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Panel Header -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TuneVertical" Width="20" Height="20" Foreground="#3949AB" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Tag Adjustment" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Modified Indicator -->
                            <Border HorizontalAlignment="Right" Background="#FEF3C7" CornerRadius="4" Padding="6,2"
                                    Visibility="{Binding SelectedTag.IsModified, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="MODIFIED" FontSize="10" FontWeight="Bold" Foreground="#D97706" />
                            </Border>
                        </Grid>

                        <Separator Background="#E2E8F0" Margin="0,0,0,14" />

                        <!-- Selected Tag Badge Banner -->
                        <Border Background="{Binding SelectedTag.FillBrush}" BorderBrush="{Binding SelectedTag.BorderBrush}" BorderThickness="1.5" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ACTIVE SELECTED TAG" FontSize="10" FontWeight="Bold" Foreground="{Binding SelectedTag.BorderBrush}" />
                                <TextBlock Text="{Binding SelectedTag.TagDisplayName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="White" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedTag.DurationFormatted, StringFormat='Duration: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                    </Border>
                                    <Border Background="White" CornerRadius="3" Padding="6,2">
                                        <TextBlock Text="{Binding SelectedTag.PhaseIndex, StringFormat='ID: {0}'}" FontSize="11" Foreground="#64748B" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Phase / Step / Emph Classification Editors -->
                        <TextBlock Text="TAG CLASSIFICATION" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8" />

                        <!-- Phase ID -->
                        <ComboBox materialDesign:HintAssist.Hint="Phase ID"
                                  ItemsSource="{Binding AvailablePhases}"
                                  SelectedItem="{Binding SelectedTag.PhaseId, Mode=TwoWay}"
                                  IsEditable="True"
                                  Text="{Binding SelectedTag.PhaseId, Mode=TwoWay}"
                                  Margin="0,0,0,10" />

                        <!-- Step ID -->
                        <ComboBox materialDesign:HintAssist.Hint="Step ID"
                                  ItemsSource="{Binding AvailableSteps}"
                                  SelectedItem="{Binding SelectedTag.StepId, Mode=TwoWay}"
                                  IsEditable="True"
                                  Text="{Binding SelectedTag.StepId, Mode=TwoWay}"
                                  Margin="0,0,0,10" />

                        <!-- Emph ID -->
                        <ComboBox materialDesign:HintAssist.Hint="Emphasis ID"
                                  ItemsSource="{Binding AvailableEmphs}"
                                  SelectedItem="{Binding SelectedTag.EmphId, Mode=TwoWay}"
                                  IsEditable="True"
                                  Text="{Binding SelectedTag.EmphId, Mode=TwoWay}"
                                  Margin="0,0,0,16" />

                        <!-- ================================================= -->
                        <!-- TIME INTERVAL NUDGE ADJUSTERS                     -->
                        <!-- ================================================= -->
                        <TextBlock Text="INTERVAL ADJUSTMENTS" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8" />

                        <!-- Start Date / Time Adjuster -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="START DATE &amp; TIME" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedTag.StartDepth, StringFormat='Depth: {0:F1} ft'}" FontSize="10" Foreground="#0D47A1" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBox Text="{Binding SelectedTagStartDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                                 BorderThickness="0" Background="Transparent"
                                                 FontSize="12" FontWeight="Bold" Foreground="#1E293B"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Edit Start Date &amp; Time (dd-MMM-yyyy HH:mm:ss)">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ApplySelectedTagStartTimeCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Border>
                                    <Button Grid.Column="1" Command="{Binding ApplySelectedTagStartTimeCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="26" Padding="6,0" Margin="4,0,0,0" ToolTip="Apply Start Time (or press Enter)">
                                        <materialDesign:PackIcon Kind="Check" Width="14" Height="14" Foreground="#10B981" />
                                    </Button>
                                </Grid>

                                <!-- Nudge Buttons for Start Time -->
                                <UniformGrid Columns="6">
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeStartTimeCommand}" CommandParameter="-60" Padding="0" Height="26" Margin="1" ToolTip="-1 hour">
                                        <TextBlock Text="-1h" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeStartTimeCommand}" CommandParameter="-15" Padding="0" Height="26" Margin="1" ToolTip="-15 minutes">
                                        <TextBlock Text="-15m" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeStartTimeCommand}" CommandParameter="-1" Padding="0" Height="26" Margin="1" ToolTip="-1 minute">
                                        <TextBlock Text="-1m" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeStartTimeCommand}" CommandParameter="1" Padding="0" Height="26" Margin="1" ToolTip="+1 minute">
                                        <TextBlock Text="+1m" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeStartTimeCommand}" CommandParameter="15" Padding="0" Height="26" Margin="1" ToolTip="+15 minutes">
                                        <TextBlock Text="+15m" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeStartTimeCommand}" CommandParameter="60" Padding="0" Height="26" Margin="1" ToolTip="+1 hour">
                                        <TextBlock Text="+1h" FontSize="10" />
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- End Date / Time Adjuster -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="END DATE &amp; TIME" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedTag.EndDepth, StringFormat='Depth: {0:F1} ft'}" FontSize="10" Foreground="#0D47A1" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBox Text="{Binding SelectedTagEndDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                                 BorderThickness="0" Background="Transparent"
                                                 FontSize="12" FontWeight="Bold" Foreground="#1E293B"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Edit End Date &amp; Time (dd-MMM-yyyy HH:mm:ss)">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ApplySelectedTagEndTimeCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Border>
                                    <Button Grid.Column="1" Command="{Binding ApplySelectedTagEndTimeCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="26" Padding="6,0" Margin="4,0,0,0" ToolTip="Apply End Time (or press Enter)">
                                        <materialDesign:PackIcon Kind="Check" Width="14" Height="14" Foreground="#10B981" />
                                    </Button>
                                </Grid>

                                <!-- Nudge Buttons for End Time -->
                                <UniformGrid Columns="6">
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeEndTimeCommand}" CommandParameter="-60" Padding="0" Height="26" Margin="1" ToolTip="-1 hour">
                                        <TextBlock Text="-1h" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeEndTimeCommand}" CommandParameter="-15" Padding="0" Height="26" Margin="1" ToolTip="-15 minutes">
                                        <TextBlock Text="-15m" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeEndTimeCommand}" CommandParameter="-1" Padding="0" Height="26" Margin="1" ToolTip="-1 minute">
                                        <TextBlock Text="-1m" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeEndTimeCommand}" CommandParameter="1" Padding="0" Height="26" Margin="1" ToolTip="+1 minute">
                                        <TextBlock Text="+1m" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeEndTimeCommand}" CommandParameter="15" Padding="0" Height="26" Margin="1" ToolTip="+15 minutes">
                                        <TextBlock Text="+15m" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding NudgeEndTimeCommand}" CommandParameter="60" Padding="0" Height="26" Margin="1" ToolTip="+1 hour">
                                        <TextBlock Text="+1h" FontSize="10" />
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Notes Field -->
                        <TextBox materialDesign:HintAssist.Hint="Tag Operational Notes"
                                 Text="{Binding SelectedTag.Notes, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 Height="54"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,16" />

                        <!-- Tag Operations Toolbar -->
                        <TextBlock Text="OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8" />
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding SplitSelectedTagCommand}" Height="30" Margin="0,0,4,0" ToolTip="Split tag in two at midpoint">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CallSplit" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Split Tag" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding MergeWithNextTagCommand}" Height="30" Margin="4,0,0,0" ToolTip="Merge into next adjacent tag">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CallMerge" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Merge Next" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding DeleteSelectedTagCommand}"
                                Foreground="#DC2626" BorderBrush="#FCA5A5" Height="30" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Delete Tag" FontSize="11" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 2: Collapsible Tag DataGrid / Interval Drawer                 -->
        <!-- ================================================================= -->
        <Expander Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="12,0,12,0">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TableLarge" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569" />
                    <TextBlock Text="All Phase Tags Table" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Tags.Count, StringFormat='({0} total)'}" FontSize="11" Foreground="#94A3B8" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>

            <DataGrid ItemsSource="{Binding Tags}"
                      SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      MaxHeight="170"
                      Margin="8,4">
                <DataGrid.Columns>
                    <!-- Phase Index -->
                    <DataGridTextColumn Header="Index" Binding="{Binding PhaseIndex}" Width="65" IsReadOnly="True" />

                    <!-- Phase Badge -->
                    <DataGridTemplateColumn Header="Phase" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle Width="8" Height="8" Fill="{Binding BorderBrush}" RadiusX="2" RadiusY="2" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding PhaseId}" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Combined Name -->
                    <DataGridTextColumn Header="Tag Name (Phase+Step+Emph)" Binding="{Binding TagDisplayName}" Width="220" IsReadOnly="True" />

                    <!-- Start Date -->
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat='{}{0:dd-MMM-yyyy HH:mm:ss}'}" Width="150" />

                    <!-- End Date -->
                    <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat='{}{0:dd-MMM-yyyy HH:mm:ss}'}" Width="150" />

                    <!-- Duration -->
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationFormatted}" Width="100" IsReadOnly="True" />

                    <!-- Depth Span -->
                    <DataGridTemplateColumn Header="Depth Span" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='{}{0:F0} ft → {1:F0} ft', Path=StartDepth, FallbackValue=''}" FontSize="11" Foreground="#0D47A1" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Notes -->
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <!-- ================================================================= -->
        <!-- ROW 3: Status & Navigation Bar                                    -->
        <!-- ================================================================= -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#334155" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tip: Right-click drag to Box Zoom. Double-click tag to frame. Drag DataSelector below chart or mouse wheel to zoom." FontSize="11" Foreground="#64748B" FontWeight="Medium" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
