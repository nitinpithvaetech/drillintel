<Window x:Class="DrillIntel.Views.ChannelPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ChannelPropertiesViewModel}"
        Title="{Binding Title, FallbackValue='Channel Properties'}"
        Width="640" Height="650"
        MinWidth="580" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif, Arial"
        FontSize="12">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- Card Section Header Title -->
        <Style x:Key="CardHeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#E65100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- Card Outer Border -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Boxed Input TextBox Style matching TimelogEditor -->
        <Style x:Key="BoxedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9800" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Multi-line Boxed TextBox Style -->
        <Style x:Key="BoxedMultilineTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9800" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boxed ComboBox Style matching TimelogEditor -->
        <Style x:Key="BoxedComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Error Message Banner -->
            <RowDefinition Height="Auto" />
            <!-- 2: Scrollable Form Content Cards -->
            <RowDefinition Height="*" />
            <!-- 3: Footer Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header Banner matching Timelog Editor theme -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="TuneVertical" Width="28" Height="28" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Value Type Badge -->
                <Border Grid.Column="2" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CodeBrackets" Width="14" Height="14" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ValueType, FallbackValue='Expression'}" FontSize="11" FontWeight="SemiBold" Foreground="#E65100" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 1. Error Alert Banner -->
        <Border Grid.Row="1" Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#C62828" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#B71C1C" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 2. Scrollable Form Content Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Card 1: Channel Identification & Unit -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="FormatListBulletedType" Width="18" Height="18" Foreground="#E65100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="CHANNEL IDENTIFICATION" Style="{StaticResource CardHeaderTitle}" />
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Mnemonic (PK: Locked if Editing) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Mnemonic *" Style="{StaticResource FieldLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Text="(PK - Locked)" FontSize="10.5" Foreground="#94A3B8" FontWeight="SemiBold"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </DockPanel>
                                <TextBox Style="{StaticResource BoxedTextBox}"
                                         Text="{Binding Mnemonic, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditMnemonic}"
                                         IsReadOnly="{Binding IsEditMode}"
                                         ToolTip="{Binding MnemonicToolTip}" />
                            </StackPanel>

                            <!-- Unit (Populated from Project Unit Master: VMX_UNIT_MASTER) -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="Unit (from Project Unit Master)" Style="{StaticResource FieldLabel}" />
                                <ComboBox Style="{StaticResource BoxedComboBox}"
                                          ItemsSource="{Binding AvailableUnits}"
                                          SelectedItem="{Binding SelectedUnit, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding SelectedUnit, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          ToolTip="Select unit of measure (loaded from VMX_UNIT_MASTER)" />
                            </StackPanel>

                            <!-- Description -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                                <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Human-readable channel description or curve name" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Value Type & Ordering -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="SortNumericAscending" Width="18" Height="18" Foreground="#E65100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="VALUE TYPE &amp; COLUMN ORDER" Style="{StaticResource CardHeaderTitle}" />
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Value Type -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Value Type" Style="{StaticResource FieldLabel}" />
                                <ComboBox Style="{StaticResource BoxedComboBox}"
                                          ItemsSource="{Binding ValueTypes}"
                                          SelectedItem="{Binding ValueType, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Calculation value type (defaults to Expression)" />
                            </StackPanel>

                            <!-- Column Order -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Column Order" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}"
                                         Text="{Binding ColumnOrder, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Display column index order in data grids" />
                            </StackPanel>

                            <!-- Sensor Offset -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Sensor Offset" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource BoxedTextBox}"
                                         Text="{Binding SensorOffset, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Depth or distance offset for downhole sensor" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Expression & Stored Procedure -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="CodeBrackets" Width="18" Height="18" Foreground="#E65100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="CALCULATION EXPRESSION" Style="{StaticResource CardHeaderTitle}" />

                            <!-- Open Editor Button -->
                            <Button Grid.Column="2"
                                    Command="{Binding OpenEditorCommand}"
                                    Height="26" Padding="10,0"
                                    Background="#FFF3E0" BorderBrush="#FFE0B2" Foreground="#E65100" FontWeight="SemiBold" FontSize="11"
                                    ToolTip="Open visual Expression Editor with channel list and mathematical functions">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalculatorVariantOutline" Width="14" Height="14" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Open Editor" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Expression Multi-line Box -->
                        <TextBlock Text="Expression" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource BoxedMultilineTextBox}"
                                 Height="85"
                                 Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                 FontSize="12.5"
                                 Margin="0,0,0,10"
                                 ToolTip="SQL / Mathematical expression calculation" />

                        <!-- Is Stored Procedure -->
                        <CheckBox IsChecked="{Binding IsStoredProcedure}"
                                  Content="Is Stored Procedure"
                                  FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"
                                  ToolTip="Execute stored procedure for channel calculation" />

                        <!-- Parameters Multi-line Box -->
                        <TextBlock Text="Parameters" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource BoxedMultilineTextBox}"
                                 Height="55"
                                 Text="{Binding Parameters, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                 FontSize="12"
                                 ToolTip="Parameters for stored procedure execution" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Footer Action Buttons -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <!-- Help Button on Left -->
                <Button DockPanel.Dock="Left"
                        Content="Help"
                        Command="{Binding HelpCommand}"
                        Height="30" Padding="14,0"
                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#475569" FontWeight="SemiBold" FontSize="11.5" />

                <!-- Action Buttons on Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Height="30" Padding="14,0" Margin="0,0,8,0"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#374151" FontWeight="SemiBold" FontSize="11.5"
                            IsCancel="True" />
                    <Button Content="Save Channel"
                            Command="{Binding OkCommand}"
                            Height="30" Padding="18,0"
                            Background="#E65100" BorderBrush="#E65100" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5"
                            IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

