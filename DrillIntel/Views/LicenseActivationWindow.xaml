<Window x:Class="DrillIntel.Views.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC License Activation" Width="760" Height="670" MinWidth="650" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F1F5F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,14">
            <TextBlock Text="PC License Activation" FontSize="24" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="Create a device key, export a request, or import a license activation package." Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="License ID" FontWeight="SemiBold" Foreground="#334155" />
                <TextBox x:Name="LicenseIdTextBox" Margin="0,7,0,0" Padding="9" MinHeight="38" FontSize="14" />
                <TextBlock Text="Enter the License ID provided by your office. This PC request contains no well data." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Device Key" FontSize="16" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock x:Name="KeyStatusText" Text="Not checked on this PC" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,10,0" />
                </StackPanel>
                <Button x:Name="CheckDeviceKeyButton" Grid.Column="1" Content="Check / Create Key" Click="CheckDeviceKey_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Device public-key fingerprint (SHA-256)" FontWeight="SemiBold" Foreground="#334155" />
                <TextBox x:Name="KeyHashTextBox" Grid.Row="1" Margin="0,7,0,12" Padding="9" IsReadOnly="True" TextWrapping="Wrap" Background="#F8FAFC" />
                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="12">
                    <TextBlock Text="After exporting, send the .jws request file to your office administrator. When they return a signed license package, import it here."
                               TextWrapping="Wrap" Foreground="#475569" VerticalAlignment="Top" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="FooterStatusText" Text="Ready" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8" />
            <DockPanel Grid.Row="1" LastChildFill="True">
                <Button DockPanel.Dock="Left" Content="Close" IsCancel="True" Click="Close_Click"
                        MinWidth="84" Height="40" Margin="0,0,12,0" Padding="14,0" />
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ExportRequestButton" Content="1. Export Request…" IsEnabled="False"
                            MinWidth="190" Height="40" Margin="4,0,0,0" Padding="14,0"
                            Background="#1976D2" Foreground="White" FontWeight="SemiBold" Click="ExportRequest_Click" />
                    <TextBlock Text="→" FontSize="20" FontWeight="SemiBold" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="8,0" />
                    <Button x:Name="ImportProductionPackageButton" Content="2. Import License Package…"
                            Click="ImportProductionPackage_Click" MinWidth="220" Height="40" Margin="4,0,0,0" Padding="14,0" />
                    <Button x:Name="ImportTestBundleButton" Content="Import Dev Test Bundle…"
                            Click="ImportTestBundle_Click" MinWidth="190" Height="40" Margin="4,0,0,0" Padding="14,0" />
                </WrapPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
