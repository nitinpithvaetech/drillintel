<Window x:Class="DrillIntel.Views.DrillingStandChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:teechart="clr-namespace:Steema.TeeChart.WPF;assembly=TeeChart.Business.WPF"
        xmlns:controls="clr-namespace:DrillIntel.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        Title="Drilling Stands" Width="1400" Height="850" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <DockPanel Grid.Row="0" Margin="8,4,8,8">
            <TextBlock Text="Drilling Stands" Foreground="#1E293B" FontWeight="Bold" FontSize="16" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="View" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton Content="Normal view" IsChecked="{Binding RigStateView, Converter={StaticResource InverseBooleanConverter}}" Foreground="#334155" GroupName="standView" Margin="0,0,12,0"/>
                <RadioButton Content="RigState View" IsChecked="{Binding RigStateView}" Foreground="#334155" GroupName="standView"/>
            </StackPanel>
        </DockPanel>
        
        <Grid x:Name="ChartContainer" Grid.Row="1">
            <teechart:TChart x:Name="ChartControl" MouseMove="OnChartMouseMove" MouseLeave="OnChartMouseLeave"/>
            <Border x:Name="BarTooltip" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4"
                    Padding="10,7" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="2">
                <TextBlock x:Name="BarTooltipText" Foreground="#1E293B" FontSize="12"/>
            </Border>
        </Grid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
            <TextBlock Text="Avg. Time (minutes)" Foreground="#0284C7" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding AverageTime, StringFormat={}{0:F2}}" Foreground="#1E293B" Margin="8,0,18,0" VerticalAlignment="Center"/>
            <TextBlock Text="Avg. Day Time" Foreground="#D97706" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding AverageDayTime, StringFormat={}{0:F2}}" Foreground="#1E293B" Margin="8,0,18,0" VerticalAlignment="Center"/>
            <TextBlock Text="Avg. Night Time" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding AverageNightTime, StringFormat={}{0:F2}}" Foreground="#1E293B" Margin="8,0,18,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Status}" Foreground="#64748B" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- 3: Navigation & Date Range Control Bar (Above dataSelector TrackBar) -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" Padding="10,6" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Preset Dropdown -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Preset Range:" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding RangePresets}" 
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              SelectionChanged="OnPresetPeriodChanged"
                              Width="140" Height="28" VerticalContentAlignment="Center" FontSize="11" Margin="0,0,14,0"/>
                </StackPanel>

                <!-- Center/Right: From - To Single Text DateTime Boxes & Apply Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="From:" Foreground="#475569" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBox Text="{Binding FromDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="#1E293B"
                                 Width="140" Height="24" FontSize="11" FontWeight="SemiBold"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 ToolTip="Enter Start Date &amp; Time (dd-MM-yyyy HH:mm)" />
                    </Border>

                    <TextBlock Text="To:" Foreground="#475569" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBox Text="{Binding ToDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="#1E293B"
                                 Width="140" Height="24" FontSize="11" FontWeight="SemiBold"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 ToolTip="Enter End Date &amp; Time (dd-MM-yyyy HH:mm)" />
                    </Border>

                    <Button Command="{Binding ApplyCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#1976D2" Foreground="White"
                            Height="28" Padding="14,0" Margin="10,0,8,0"
                            ToolTip="Query and filter Drilling Stand plot for this window">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Apply" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Content="DataSelector Settings" Click="OnDataSelectorSettingsClick" 
                            Height="28" Padding="12,0" FontSize="11"
                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#CBD5E1" Foreground="#475569" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4: Data Selector Range TrackBar Scroller -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" Margin="0,0,0,4">
            <controls:RangeTrackBarControl x:Name="StandDataSelector" 
                                           Minimum="{Binding TrackBarMin}" 
                                           Maximum="{Binding TrackBarMax}"
                                           SelectionStart="{Binding TrackBarSelectionStart, Mode=TwoWay}" 
                                           SelectionEnd="{Binding TrackBarSelectionEnd, Mode=TwoWay}"
                                           IsTimeLog="{Binding IsTimeLog}" 
                                           OverviewPoints="{Binding TrackBarOverviewPoints}"
                                           OverviewChannelName="{Binding TrackBarOverviewChannelName}" 
                                           OverviewStroke="{Binding TrackBarOverviewBrush}"
                                           OverviewYMin="{Binding TrackBarOverviewMin}" 
                                           OverviewYMax="{Binding TrackBarOverviewMax}"
                                           SelectedPeriod="{Binding SelectedPreset, Mode=TwoWay}" 
                                           RangeChanged="OnSelectorRangeChanged"/>
        </Border>
    </Grid>
</Window>
