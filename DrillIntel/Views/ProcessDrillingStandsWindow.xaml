<Window x:Class="DrillIntel.Views.ProcessDrillingStandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        Title="Process and Save Drilling Stands" 
        Height="400" Width="760"
        MinHeight="360" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0E121A"
        TextElement.Foreground="#E6EDF3"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Green Outlined Button Style -->
        <Style x:Key="GreenOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#15803D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#22C55E" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0A2E1A" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#22C55E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#14532D" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#16A34A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F3327" />
                                <Setter TargetName="border" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#3B694D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gray Outlined Button Style (Cancel) -->
        <Style x:Key="GrayOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2937" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563" />
                                <Setter Property="Foreground" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#6B7280" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F242C" />
                                <Setter TargetName="border" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#4B5563" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <!-- 0: Header Title -->
            <RowDefinition Height="Auto" />
            <!-- 1: Divider Line -->
            <RowDefinition Height="Auto" />
            <!-- 2: Info Alert Box -->
            <RowDefinition Height="Auto" />
            <!-- 3: Input Parameters -->
            <RowDefinition Height="Auto" />
            <!-- 4: Action Buttons (Start, Cancel, Clear DB Entries, Close) -->
            <RowDefinition Height="Auto" />
            <!-- 5: Progress & Status -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0: Header Title -->
        <TextBlock Grid.Row="0" Text="Process and Save Drilling Stands" 
                   FontSize="16" FontWeight="SemiBold" Foreground="#F0F6FC" 
                   Margin="0,0,0,10" />

        <!-- 1: Divider Line -->
        <Border Grid.Row="1" Height="1" Background="#262D3D" Margin="0,0,0,16" />

        <!-- 2: Info Alert Box -->
        <Border Grid.Row="2" Background="#0C233C" BorderBrush="#1D3E66" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" 
                           Text="This function allows processing drilling stand of entire well and save it to the database." 
                           Foreground="#93C5FD" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 3: Input Parameters -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <!-- Day Time Hours From -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                <TextBlock Text="Day Time Hours From" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0" />
                
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="From"
                         materialDesign:HintAssist.IsFloating="True"
                         materialDesign:TextFieldAssist.UnderlineBrush="#22C55E"
                         Text="{Binding DayTimeHoursFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding CanStart}"
                         Width="120" Height="42"
                         FontSize="13" FontWeight="SemiBold"
                         Foreground="#F1F5F9"
                         BorderBrush="#374151"
                         Background="#161D2B"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center" />
            </StackPanel>

            <!-- Overwrite Checkbox -->
            <CheckBox IsChecked="{Binding OverwriteExisting}" 
                      IsEnabled="{Binding CanStart}"
                      VerticalAlignment="Center">
                <TextBlock Text="Overwrite existing connection information" 
                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" />
            </CheckBox>
        </StackPanel>

        <!-- 4: Action Buttons Bar -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Buttons: Start, Cancel, Clear DB Entries -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Start Button -->
                <Button Command="{Binding StartCommand}" 
                        IsEnabled="{Binding CanStart}"
                        Style="{StaticResource GreenOutlinedButtonStyle}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Start" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button Command="{Binding CancelCommand}" 
                        IsEnabled="{Binding CanCancel}"
                        Style="{StaticResource GrayOutlinedButtonStyle}" 
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Clear DB Entries Button -->
                <Button Command="{Binding ClearDbEntriesCommand}" 
                        IsEnabled="{Binding CanStart}"
                        Style="{StaticResource GreenOutlinedButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Autorenew" Width="16" Height="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Clear DB Entries" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right Button: Close -->
            <Button Grid.Column="1" Command="{Binding CloseCommand}" 
                    Style="{StaticResource GreenOutlinedButtonStyle}"
                    MinWidth="85">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Close" Width="15" Height="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Close" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 5: Progress & Status Area -->
        <Border Grid.Row="5" VerticalAlignment="Bottom" Margin="0,4,0,0">
            <StackPanel VerticalAlignment="Bottom">
                <!-- Status Message & Percentage -->
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressStatus}" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="#22C55E" 
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                </DockPanel>

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" 
                             Foreground="#22C55E" Background="#1E293B" BorderThickness="0"
                             materialDesign:TransitionAssist.DisableTransitions="True"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Error message if any -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" 
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
