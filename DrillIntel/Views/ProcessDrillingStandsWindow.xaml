<Window x:Class="DrillIntel.Views.ProcessDrillingStandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        Title="Process and Save Drilling Stands" 
        Height="480" Width="760"
        MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Primary Action Raised Button Style (Solid Deep Purple with Crisp White Text) -->
        <Style x:Key="PrimaryActionRaisedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#673AB7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#512DA8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="1" Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5E35B1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4527A0"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#5E35B1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4527A0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#311B92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="border" Property="Background" Value="#9E9E9E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#9E9E9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outlined Button Style -->
        <Style x:Key="SecondaryOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Outlined Button Style (Clear DB Entries) -->
        <Style x:Key="DangerOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEF2F2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Info Box -->
            <RowDefinition Height="Auto" />
            <!-- 2: Parameters GroupBox -->
            <RowDefinition Height="Auto" />
            <!-- 3: Progress & Status -->
            <RowDefinition Height="*" />
            <!-- 4: Bottom Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header Banner -->
        <Border Grid.Row="0" Background="#F4F3F8" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <materialDesign:PackIcon Grid.Column="0" Kind="FormatListNumbered" Width="36" Height="36" 
                                        Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Process and Save Drilling Stands" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Well: " FontWeight="SemiBold" Foreground="#616161" FontSize="12" />
                        <TextBlock Text="{Binding WellName}" FontWeight="Bold" Foreground="#212121" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Text="Log: " FontWeight="SemiBold" Foreground="#616161" FontSize="12" />
                        <TextBlock Text="{Binding LogName}" Foreground="#212121" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Text="Existing Stands: " FontWeight="SemiBold" Foreground="#616161" FontSize="12" />
                        <TextBlock Text="{Binding ExistingStandsCount}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: Info Box -->
        <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" 
                           Text="This function allows processing drilling stand of entire well and save it to the database." 
                           Foreground="#0369A1" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 2: Parameters GroupBox -->
        <GroupBox Grid.Row="2" Header="Drilling Stand Parameters" materialDesign:ElevationAssist.Elevation="Dp1" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <!-- Day Time Hours From -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Day Time Hours From" Foreground="#616161" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0" />
                    
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="From " Foreground="#757575" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding DayTimeHoursFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding CanStart}"
                                     Foreground="{DynamicResource MaterialDesignBody}" Background="Transparent" BorderThickness="0" 
                                     Width="55" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Overwrite Checkbox -->
                <CheckBox IsChecked="{Binding OverwriteExisting}" 
                          IsEnabled="{Binding CanStart}"
                          VerticalAlignment="Center">
                    <TextBlock Text="Overwrite existing connection information" 
                               Foreground="{DynamicResource MaterialDesignBody}" FontSize="13" VerticalAlignment="Center" />
                </CheckBox>
            </StackPanel>
        </GroupBox>

        <!-- 3: Progress & Status Area -->
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <!-- Status Message & Percentage -->
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressStatus}" FontSize="12" FontWeight="Medium" Foreground="#424242" TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" 
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                </DockPanel>

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" 
                             Foreground="{DynamicResource PrimaryHueMidBrush}" Background="#E0E0E0" BorderThickness="0"
                             materialDesign:TransitionAssist.DisableTransitions="True"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Error message if any -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" 
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- 4: Action Buttons Bar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Buttons: Start, Cancel, Clear DB Entries -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Start Button -->
                <Button Command="{Binding StartCommand}" 
                        IsEnabled="{Binding CanStart}"
                        Style="{StaticResource PrimaryActionRaisedButtonStyle}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Start" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button Command="{Binding CancelCommand}" 
                        IsEnabled="{Binding CanCancel}"
                        Style="{StaticResource SecondaryOutlinedButtonStyle}" 
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Cancel" Foreground="#475569" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Clear DB Entries Button -->
                <Button Command="{Binding ClearDbEntriesCommand}" 
                        IsEnabled="{Binding CanStart}"
                        Style="{StaticResource DangerOutlinedButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Autorenew" Width="16" Height="16" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Clear DB Entries" Foreground="#DC2626" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right Button: Close -->
            <Button Grid.Column="1" Command="{Binding CloseCommand}" 
                    Style="{StaticResource SecondaryOutlinedButtonStyle}"
                    MinWidth="85">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Close" Width="15" Height="15" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Close" Foreground="#475569" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
