<Window x:Class="DrillIntel.Views.TrackPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:TrackPropertiesViewModel}"
        Title="{Binding Title, FallbackValue='Track &amp; Axis Properties'}"
        Width="780" Height="740"
        MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#F4F3F8" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0" Kind="TuneVariant" Width="36" Height="36" Foreground="#512DA8" VerticalAlignment="Center" Margin="0,0,14,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#311B92" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#616161" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Two-column Master-Detail Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Tracks List -->
            <GroupBox Grid.Column="0" Header="Tracks" materialDesign:ElevationAssist.Elevation="Dp1" Padding="6">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Command="{Binding DeleteTrackCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="32" Margin="4,8,4,0" Content="Delete Track" Foreground="#D32F2F" />

                    <ListBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}" DisplayMemberPath="Title" />
                </DockPanel>
            </GroupBox>

            <!-- Right: Track & Channel Details -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Track Details -->
                    <GroupBox Header="Track Column Layout" Margin="0,0,0,12" materialDesign:ElevationAssist.Elevation="Dp1" Padding="10"
                              DataContext="{Binding SelectedTrack}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Track Title:" Style="{StaticResource InputLabel}" />
                                    <TextBox Text="{Binding Title, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Width Weight:" Style="{StaticResource InputLabel}" />
                                    <TextBox Text="{Binding Width, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                </StackPanel>

                                <CheckBox Grid.Column="4" Content="Visible" IsChecked="{Binding Visible, Mode=TwoWay}" VerticalAlignment="Bottom" Margin="0,0,0,6" FontWeight="SemiBold" />
                            </Grid>

                            <!-- Track Header Font -->
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Header Font:" Style="{StaticResource InputLabel}" />
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableFonts, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              SelectedItem="{Binding FontName, Mode=TwoWay}" Height="32" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Font Size:" Style="{StaticResource InputLabel}" />
                                    <TextBox Text="{Binding FontSize, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Font Color:" Style="{StaticResource InputLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FontColor, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                        <Button Grid.Column="2" Command="{Binding DataContext.PickTrackFontColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Height="30" Width="34" Padding="0">
                                            <Border Width="20" Height="18" Background="{Binding FontColor}" CornerRadius="2" BorderBrush="#757575" BorderThickness="1" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <!-- Channels in Track -->
                    <GroupBox Header="Channels in Track" Margin="0,0,0,12" materialDesign:ElevationAssist.Elevation="Dp1" Padding="10">
                        <StackPanel>
                            <DataGrid ItemsSource="{Binding CurrentTrackChannels}" 
                                      SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      EnableRowVirtualization="False"
                                      SelectionMode="Single"
                                      Height="130"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderBrush="#CBD5E1"
                                      BorderThickness="1"
                                      Background="#F8FAFC">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mnemonic" Binding="{Binding Mnemonic}" FontWeight="Bold" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="120" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding SeriesType}" Width="70" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Header="Rig State Color" Binding="{Binding ColorCodeAsRigState, Mode=TwoWay}" Width="110" />
                                    <DataGridCheckBoxColumn Header="Visible" Binding="{Binding Visible, Mode=TwoWay}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Command="{Binding DeleteChannelCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Height="30" HorizontalAlignment="Right" Margin="0,8,0,0" Content="Remove Curve" Foreground="#D32F2F" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Selected Curve & Axis Configuration -->
                    <GroupBox Header="Selected Curve &amp; Axis Configuration" 
                              materialDesign:ElevationAssist.Elevation="Dp1" 
                              Padding="10"
                              Visibility="{Binding SelectedChannel, Converter={StaticResource NullToVisibilityConverter}}"
                              DataContext="{Binding SelectedChannel}">
                        <StackPanel>
                            <!-- Curve Styling Row -->
                            <TextBlock Text="Curve Display &amp; Visual Style" FontSize="11" FontWeight="Bold" Foreground="#311B92" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Series Type:" Style="{StaticResource InputLabel}" />
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableSeriesTypes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              SelectedItem="{Binding SeriesType, Mode=TwoWay}" Height="32" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Line Width:" Style="{StaticResource InputLabel}" />
                                    <TextBox Text="{Binding LineWidth, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Line Style:" Style="{StaticResource InputLabel}" />
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableLineStyles, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              SelectedItem="{Binding LineStyle, Mode=TwoWay}" Height="32" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Line Color:" Style="{StaticResource InputLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding LineColor, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                        <Button Grid.Column="2" Command="{Binding DataContext.PickChannelLineColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Height="30" Width="34" Padding="0">
                                            <Border Width="20" Height="18" Background="{Binding LineColor}" CornerRadius="2" BorderBrush="#757575" BorderThickness="1" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Point Marker Row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Point Style:" Style="{StaticResource InputLabel}" />
                                    <ComboBox ItemsSource="{Binding DataContext.AvailablePointStyles, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              SelectedItem="{Binding PointStyle, Mode=TwoWay}" Height="32" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Point Width:" Style="{StaticResource InputLabel}" />
                                    <TextBox Text="{Binding PointWidth, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Point Height:" Style="{StaticResource InputLabel}" />
                                    <TextBox Text="{Binding PointHeight, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                                    <CheckBox Content="Color-Code as Rig State" IsChecked="{Binding ColorCodeAsRigState, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,4,0,8" />

                            <!-- Axis Scaling Properties (objXAxis) -->
                            <TextBlock Text="Horizontal Track Axis Scaling (RTAxis)" FontSize="11" FontWeight="Bold" Foreground="#311B92" Margin="0,0,0,8" />
                            <Grid DataContext="{Binding objXAxis}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Content="Auto-Scale" IsChecked="{Binding AutoScale, Mode=TwoWay}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,6" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Min Scale:" Style="{StaticResource InputLabel}" />
                                        <TextBox Text="{Binding Min, Mode=TwoWay}" 
                                                 IsEnabled="{Binding AutoScale, Converter={StaticResource InverseBooleanConverter}}"
                                                 Style="{StaticResource FormTextBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Max Scale:" Style="{StaticResource InputLabel}" />
                                        <TextBox Text="{Binding Max, Mode=TwoWay}" 
                                                 IsEnabled="{Binding AutoScale, Converter={StaticResource InverseBooleanConverter}}"
                                                 Style="{StaticResource FormTextBox}" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="6" Content="Invert Axis" IsChecked="{Binding Inverted, Mode=TwoWay}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Content="Show Major Grids" IsChecked="{Binding ShowMajorGrids, Mode=TwoWay}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,6" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Major Ticks:" Style="{StaticResource InputLabel}" />
                                        <TextBox Text="{Binding MajorTickCount, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Axis Font:" Style="{StaticResource InputLabel}" />
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableFonts, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                  SelectedItem="{Binding LabelFontName, Mode=TwoWay}" Height="32" VerticalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Font Size:" Style="{StaticResource InputLabel}" />
                                        <TextBox Text="{Binding LabelFontSize, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="Font Color:" Style="{StaticResource InputLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding LabelFontColor, Mode=TwoWay}" Style="{StaticResource FormTextBox}" />
                                            <Button Grid.Column="2" Command="{Binding DataContext.PickAxisFontColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Height="30" Width="34" Padding="0">
                                                <Border Width="20" Height="18" Background="{Binding LabelFontColor}" CornerRadius="2" BorderBrush="#757575" BorderThickness="1" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Action Buttons -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Width="100" Margin="0,0,10,0" />
                <Button Content="Apply" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#512DA8" Foreground="White" Width="120" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

