<Window x:Class="DrillIntel.Views.SyncDataWithParentTimelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        xmlns:controls="clr-namespace:DrillIntel.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:SyncDataWithParentTimelogViewModel}"
        Title="Sync Data with Parent Timelog" 
        Width="680" 
        SizeToContent="Height"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Operation Banner -->
        <Border Grid.Row="0" Background="#F0F7FF" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="#BAE6FD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <materialDesign:PackIcon Grid.Column="0" Kind="Sync" Width="36" Height="36" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,14,0" />
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Sync Data with Parent Timelog" FontSize="18" FontWeight="Bold" Foreground="#0369A1" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Source Timelog: " FontWeight="SemiBold" Foreground="#64748B" FontSize="12" />
                        <TextBlock Text="{Binding SourceTimeLogName}" FontWeight="Bold" Foreground="#0F172A" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Text="Well Name: " FontWeight="SemiBold" Foreground="#64748B" FontSize="12" />
                        <TextBlock Text="{Binding SourceWellName}" Foreground="#334155" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Text="Wellbore Name: " FontWeight="SemiBold" Foreground="#64748B" FontSize="12" />
                        <TextBlock Text="{Binding SourceWellboreName}" Foreground="#334155" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- (1) Target Information GroupBox -->
        <GroupBox Grid.Row="1" Header="Target Information" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Well -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="Factory" Width="16" Height="16" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Well Name" FontWeight="SemiBold" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <TextBlock Text="{Binding TargetWellName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="Target Well Name" />
                    </Border>
                </StackPanel>

                <!-- Wellbore -->
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="SourceBranch" Width="16" Height="16" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Wellbore Name" FontWeight="SemiBold" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <TextBlock Text="{Binding TargetWellboreName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="Target Wellbore Name" />
                    </Border>
                </StackPanel>

                <!-- Time Log -->
                <StackPanel Grid.Column="4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="FileClockOutline" Width="16" Height="16" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Time Log" FontWeight="SemiBold" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <TextBlock Text="{Binding TargetTimeLogName}" FontWeight="Bold" FontSize="13" Foreground="#0369A1" TextTrimming="CharacterEllipsis" ToolTip="Target Parent Timelog Name" />
                    </Border>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- (2) Date Range GroupBox -->
        <GroupBox Grid.Row="2" Header="Date Range" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1" Padding="14">
            <StackPanel>
                <!-- Help text & Preset Dropdown -->
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Specify the date &amp; time window of data to synchronize to the parent timelog:" 
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Preset: " FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding DateRangePresets}" 
                                  SelectedItem="{Binding SelectedDateRangePreset, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelectDates}"
                                  Width="150" 
                                  FontSize="12"
                                  ToolTip="Choose a preset date range or adjust the date/time pickers below" />
                    </StackPanel>
                </DockPanel>

                <!-- Single Combined Date & Time Input Fields -->
                <Grid IsEnabled="{Binding CanSelectDates}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- From Date & Time (Single Field) -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="15" Height="15" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="From Date &amp; Time:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                            <TextBlock Text=" (DD/MM/YYYY HH:MM)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <controls:DateTimePicker 
                            SelectedDateTime="{Binding FromDateTime, Mode=TwoWay}" 
                            DisplayDateStart="{Binding MinAvailableDate}"
                            DisplayDateEnd="{Binding MaxAvailableDate}"
                            ToolTip="Select start date and time for synchronization (DD/MM/YYYY HH:MM)" />
                    </StackPanel>

                    <!-- To Date & Time (Single Field) -->
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="15" Height="15" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="To Date &amp; Time:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                            <TextBlock Text=" (DD/MM/YYYY HH:MM)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <controls:DateTimePicker 
                            SelectedDateTime="{Binding ToDateTime, Mode=TwoWay}" 
                            DisplayDateStart="{Binding MinAvailableDate}"
                            DisplayDateEnd="{Binding MaxAvailableDate}"
                            ToolTip="Select end date and time for synchronization (DD/MM/YYYY HH:MM)" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- (4) Progress, Feedback & Status Section -->
        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Background="#FAFAFA">
            <StackPanel VerticalAlignment="Center">
                <!-- Status Message and Percentage -->
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressStatus}" FontSize="13" FontWeight="Medium" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="#0284C7" />
                </DockPanel>

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ProgressPercent}" 
                             Maximum="100" 
                             Height="10" 
                             materialDesign:TransitionAssist.DisableTransitions="True"
                             Foreground="#0284C7"
                             Margin="0,0,0,8" />

                <!-- Success Message Banner -->
                <Border Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SuccessMessage}" FontWeight="SemiBold" Foreground="#065F46" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Error Message Banner with Retry Button -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12" TextWrapping="Wrap" MaxWidth="440" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" 
                                Content="Retry" 
                                Command="{Binding StartSyncCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#DC2626" 
                                BorderBrush="#DC2626" 
                                Height="28" 
                                Padding="12,0" 
                                FontSize="12" 
                                ToolTip="Retry synchronization" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- (3) Action Buttons -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button DockPanel.Dock="Right" 
                    Content="{Binding CloseButtonText}" 
                    Command="{Binding CloseCommand}" 
                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                    MinWidth="100" 
                    ToolTip="Close dialog without syncing"
                    Margin="8,0,0,0" />

            <Button DockPanel.Dock="Right" 
                    Command="{Binding StartSyncCommand}" 
                    IsEnabled="{Binding CanStart}"
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Background="#0284C7"
                    BorderBrush="#0284C7"
                    MinWidth="130"
                    ToolTip="Initiate synchronization process">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Start" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>

