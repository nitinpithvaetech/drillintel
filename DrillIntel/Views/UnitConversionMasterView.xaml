<UserControl x:Class="DrillIntel.Views.UnitConversionMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:UnitConversionMasterViewModel}"
             d:DesignHeight="700" d:DesignWidth="1150"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style x:Key="CenterTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="BoldTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <!-- Clean Search Box Style with integrated search icon, proper height, and vertical alignment -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" Margin="0" Padding="{TemplateBinding Padding}" />
                                <TextBlock x:Name="placeholder" Grid.Column="1" Text="Search conversions..." Foreground="#94A3B8" FontSize="12.5" IsHitTestVisible="False" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00897B" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Toolbar ComboBox Style with proper height and padding -->
        <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Visually Appealing, Modern Grid Edit Button Style -->
        <Style x:Key="GridEditButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="29" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon x:Name="icon" Kind="PencilOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="text" Text="Edit" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8" />
                                <Setter TargetName="icon" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="text" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.28" Color="#2563EB" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E40AF" />
                                <Setter TargetName="icon" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="text" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Visually Appealing, Modern Grid Delete Button Style -->
        <Style x:Key="GridDeleteButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="29" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon x:Name="icon" Kind="TrashCanOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="text" Text="Delete" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#B91C1C" />
                                <Setter TargetName="icon" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="text" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.28" Color="#DC2626" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#991B1B" />
                                <Setter TargetName="icon" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="text" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Status Alert Banner -->
            <RowDefinition Height="Auto" />
            <!-- 2: Filter Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 3: DataGrid -->
            <RowDefinition Height="*" />
            <!-- 4: Footer Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header Banner -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="SwapHorizontalCircleOutline" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="36" Height="36" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="12" Opacity="0.9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Status Alert Banner -->
        <Border Grid.Row="1" Margin="0,0,0,12" CornerRadius="6" Padding="12,8"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F5E9" />
                    <Setter Property="BorderBrush" Value="#81C784" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Setter Property="BorderBrush" Value="#E57373" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="CheckCircleOutline" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium" FontSize="12.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1B5E20" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#B71C1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}" Width="24" Height="24"
                        Command="{Binding DismissStatusCommand}" ToolTip="Dismiss">
                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#757575" />
                </Button>
            </Grid>
        </Border>

        <!-- 2. Filter & Actions Toolbar -->
        <materialDesign:Card Grid.Row="2" Padding="12,8" UniformCornerRadius="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search Input -->
                    <ColumnDefinition Width="280" />
                    <!-- Category Dropdown -->
                    <ColumnDefinition Width="220" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Action Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input with Proper Height and Icon -->
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Margin="0,0,12,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Esc" Command="{Binding RefreshCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Category Filter ComboBox with Proper Height -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Style="{StaticResource ToolbarComboBoxStyle}"
                          Margin="0,0,12,0" />

                <!-- Action Buttons: Refresh & Add Conversion with Matching 36px Height -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Refresh conversion list from database"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="36" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button ToolTip="Register a new unit conversion rule"
                            Command="{Binding AddConversionCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="36" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Add Conversion" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- 3. Units DataGrid -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding FilteredConversions}"
                      SelectedItem="{Binding SelectedConversion}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      SelectionUnit="FullRow"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      AlternatingRowBackground="#F9FAFB"
                      RowBackground="#FFFFFF"
                      RowHeight="42"
                      FontSize="12.5"
                      BorderThickness="0"
                      Background="Transparent"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Height" Value="38" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="#374151" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <!-- Column 1: ID -->
                    <DataGridTextColumn Header="ID"
                                         Binding="{Binding Id}"
                                         Width="70"
                                         ElementStyle="{StaticResource CenterTextStyle}" />

                    <!-- Column 2: From Unit -->
                    <DataGridTextColumn Header="From Unit"
                                         Binding="{Binding FromUnit}"
                                         Width="105"
                                         ElementStyle="{StaticResource BoldTextStyle}" />

                    <!-- Column 3: To Unit -->
                    <DataGridTextColumn Header="To Unit"
                                         Binding="{Binding ToUnit}"
                                         Width="105"
                                         ElementStyle="{StaticResource BoldTextStyle}" />

                    <!-- Column 4: Category -->
                    <DataGridTemplateColumn Header="Category" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E0F2F1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" Foreground="#00695C" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column 5: Multiplier -->
                    <DataGridTextColumn Header="Multiplier"
                                         Binding="{Binding MultiplierDisplay}"
                                         Width="110"
                                         ElementStyle="{StaticResource CenterTextStyle}" />

                    <!-- Column 6: Offset -->
                    <DataGridTextColumn Header="Offset"
                                         Binding="{Binding OffsetDisplay}"
                                         Width="90"
                                         ElementStyle="{StaticResource CenterTextStyle}" />

                    <!-- Column 7: Formula -->
                    <DataGridTextColumn Header="Conversion Formula"
                                         Binding="{Binding ConversionFormula}"
                                         Width="180"
                                         ElementStyle="{StaticResource CenterTextStyle}" />

                    <!-- Column 8: CreatedBy -->
                    <DataGridTextColumn Header="CreatedBy"
                                         Binding="{Binding CreatedBy}"
                                         Width="110"
                                         ElementStyle="{StaticResource CenterTextStyle}" />

                    <!-- Column 9: CreatedDate -->
                    <DataGridTextColumn Header="CreatedDate"
                                         Binding="{Binding CreatedDate}"
                                         Width="140"
                                         ElementStyle="{StaticResource CenterTextStyle}" />

                    <!-- Column 10: ModifiedBy -->
                    <DataGridTextColumn Header="ModifiedBy"
                                         Binding="{Binding ModifiedBy}"
                                         Width="110"
                                         ElementStyle="{StaticResource CenterTextStyle}" />

                    <!-- Column 11: ModifiedDate -->
                    <DataGridTextColumn Header="ModifiedDate"
                                         Binding="{Binding ModifiedDate}"
                                         Width="140"
                                         ElementStyle="{StaticResource CenterTextStyle}" />

                    <!-- Column 12: Actions (Edit & Delete options directly in the grid) -->
                    <DataGridTemplateColumn Header="Actions" Width="175" CanUserSort="False" CanUserReorder="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Height" Value="38" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="#374151" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Edit Button -->
                                    <Button Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding DataContext.EditConversionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding FromUnit, StringFormat='Edit conversion {0} → ...'}"
                                            Margin="0,0,8,0" />

                                    <!-- Delete Button -->
                                    <Button Style="{StaticResource GridDeleteButtonStyle}"
                                            Command="{Binding DataContext.DeleteConversionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding FromUnit, StringFormat='Delete conversion rule {0}'}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Footer Bar -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Total Count -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FormatListNumbered" Width="16" Height="16" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding TotalCountText}" FontWeight="SemiBold" Foreground="#424242" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Database Path -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                <materialDesign:PackIcon Kind="DatabaseOutline" Width="14" Height="14" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding DatabasePath, StringFormat='Database: {0}'}" FontSize="11" Foreground="#757575" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="2" Content="Close"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    MinWidth="90" Height="34" />
        </Grid>
    </Grid>
</UserControl>

