<Window x:Class="DrillIntel.Views.ExpressionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ExpressionEditorViewModel}"
        Title="{Binding Title, FallbackValue='Expression Editor'}"
        Width="780" Height="620"
        MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Segoe UI Variable, Microsoft Sans Serif, Arial">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- Card Section Header Title -->
        <Style x:Key="CardHeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#E65100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- Card Outer Border -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Boxed Input TextBox Style -->
        <Style x:Key="BoxedTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9800" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selection ListBox Style -->
        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Status Banner -->
            <RowDefinition Height="Auto" />
            <!-- 2: Top Section: Expression & Channels -->
            <RowDefinition Height="*" />
            <!-- 3: Bottom Section: Functions, Operators & Info -->
            <RowDefinition Height="180" />
            <!-- 4: Footer Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header Banner matching Timelog Editor theme -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="FunctionVariant" Width="28" Height="28" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Channels Count Badge -->
                <Border Grid.Column="2" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TableLarge" Width="14" Height="14" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding AvailableChannels.Count, StringFormat='{}{0} Channels'}" FontSize="11" FontWeight="SemiBold" Foreground="#E65100" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 1. Status / Feedback Message -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,6" CornerRadius="4"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F5E9" />
                    <Setter Property="BorderBrush" Value="#C8E6C9" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Setter Property="BorderBrush" Value="#FFCDD2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="CheckCircle" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircle" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 2. Top Section: Expression Box & Channels List -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Expression Editor Card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="CodeBrackets" Width="16" Height="16" Foreground="#E65100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="EXPRESSION *" Style="{StaticResource CardHeaderTitle}" />
                    </Grid>

                    <TextBox x:Name="ExpressionTextBox" Grid.Row="1"
                             Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BoxedTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                             FontSize="13" />
                </Grid>
            </Border>

            <!-- Columns (Timelog Channels) Card -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="ViewColumnOutline" Width="16" Height="16" Foreground="#E65100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="COLUMNS (CHANNELS)" Style="{StaticResource CardHeaderTitle}" />
                    </Grid>

                    <ListBox x:Name="ChannelsListBox" Grid.Row="1"
                             ItemsSource="{Binding AvailableChannels}"
                             SelectedItem="{Binding SelectedChannel}"
                             Style="{StaticResource CleanListBox}"
                             MouseDoubleClick="OnChannelsListBoxMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,1">
                                    <TextBlock Text="{Binding Mnemonic}" FontWeight="Bold" FontSize="12" Foreground="#1E293B" />
                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Section: Functions, Operators & Help Tips -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="4.5*" />
            </Grid.ColumnDefinitions>

            <!-- Functions Card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="MathSin" Width="16" Height="16" Foreground="#E65100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="FUNCTIONS" Style="{StaticResource CardHeaderTitle}" />
                    </Grid>

                    <ListBox x:Name="FunctionsListBox" Grid.Row="1"
                             ItemsSource="{Binding AvailableFunctions}"
                             SelectedItem="{Binding SelectedFunction}"
                             Style="{StaticResource CleanListBox}"
                             MouseDoubleClick="OnFunctionsListBoxMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="11.5" Foreground="#1E293B" Padding="2,1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Operators Card -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="PlusMinusVariant" Width="16" Height="16" Foreground="#E65100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="OPERATORS" Style="{StaticResource CardHeaderTitle}" />
                    </Grid>

                    <ListBox x:Name="OperatorsListBox" Grid.Row="1"
                             ItemsSource="{Binding AvailableOperators}"
                             SelectedItem="{Binding SelectedOperator}"
                             Style="{StaticResource CleanListBox}"
                             MouseDoubleClick="OnOperatorsListBoxMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" FontFamily="Consolas, monospace" FontSize="12" Foreground="#1E293B" Padding="4,1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Help / Usage Instructions Card -->
            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Margin="0">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#1976D2" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="QUICK TIPS" FontSize="11.5" FontWeight="Bold" Foreground="#1976D2" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>

                    <TextBlock Text="Double click on any channel, function, or operator in the lists to insert it directly into the expression."
                               FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <Border Background="#F1F5F9" CornerRadius="4" Padding="8,6">
                        <StackPanel>
                            <TextBlock Text="Common Patterns:" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBlock Text="• [DEPTH] / 1000.0" FontSize="10.5" FontFamily="Consolas, monospace" Foreground="#0F172A" />
                            <TextBlock Text="• abs([HKLD] - [WOB])" FontSize="10.5" FontFamily="Consolas, monospace" Foreground="#0F172A" />
                            <TextBlock Text="• round([ROP] * 3.28084, 2)" FontSize="10.5" FontFamily="Consolas, monospace" Foreground="#0F172A" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Footer Action Buttons -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <DockPanel LastChildFill="False">
                <!-- Left Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Help"
                            Command="{Binding HelpCommand}"
                            Height="30" Padding="12,0" Margin="0,0,8,0"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#475569" FontWeight="SemiBold" FontSize="11.5" />
                    <Button Command="{Binding VerifyCommand}"
                            Height="30" Padding="14,0"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1565C0" FontWeight="SemiBold" FontSize="11.5"
                            ToolTip="Check expression syntax and parenthesis balancing">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckOutline" Width="14" Height="14" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Verify Syntax" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Height="30" Padding="14,0" Margin="0,0,8,0"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#374151" FontWeight="SemiBold" FontSize="11.5"
                            IsCancel="True" />
                    <Button Content="OK"
                            Command="{Binding OkCommand}"
                            Height="30" Padding="18,0"
                            Background="#E65100" BorderBrush="#E65100" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5"
                            IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

