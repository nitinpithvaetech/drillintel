<UserControl x:Class="DrillIntel.Views.RigStateWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             xmlns:views="clr-namespace:DrillIntel.Views"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:RigStateWorkspaceViewModel}"
             d:DesignHeight="800" d:DesignWidth="1280"
             Background="#F8FAFC">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!-- Tab Header Template with Icon, Title, Dirty Star, and Close Button -->
        <DataTemplate x:Key="WorkspaceTabHeaderTemplate">
            <Border Background="Transparent" Padding="4,2" Margin="0" x:Name="TabHeaderBorder">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <materialDesign:PackIcon Grid.Column="0" Kind="ChartTimelineVariant" Width="14" Height="14" 
                                             Foreground="#1976D2" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <!-- Document Title -->
                    <TextBlock Grid.Column="1" Text="{Binding DocumentName}" FontSize="11.5" FontWeight="SemiBold" 
                               VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />

                    <!-- Dirty Asterisk Indicator -->
                    <TextBlock Grid.Column="2" Text="*" FontSize="13" FontWeight="Bold" Foreground="#D32F2F" 
                               VerticalAlignment="Center" Margin="2,0,4,0"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="Unsaved changes" />

                    <!-- Close Tab Button -->
                    <Button Grid.Column="3" Style="{StaticResource MaterialDesignToolButton}" 
                            Command="{Binding DataContext.CloseDocumentTabCommand, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}"
                            CommandParameter="{Binding}"
                            ToolTip="Close Document"
                            Width="18" Height="18" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="#94A3B8" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: Left TreeView Navigation Pane -->
            <ColumnDefinition Width="300" MinWidth="220" MaxWidth="500" />
            <!-- Column 1: Draggable GridSplitter -->
            <ColumnDefinition Width="5" />
            <!-- Column 2: Right Multi-Document Workspace -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- LEFT NAVIGATION PANE: TOOLBAR, SEARCH, AND TREEVIEW              -->
        <!-- ================================================================= -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0: Top Action Toolbar -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: Search / Filter Input -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: TreeView Container -->
                    <RowDefinition Height="*" />
                    <!-- 3: Bottom Status Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 0: Top Action Toolbar -->
                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Toolbar Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- New Document -->
                            <Button Command="{Binding NewDocumentCommand}" 
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Height="28" Padding="6,2" Margin="0,0,2,0"
                                    ToolTip="Create New Document (+)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlusCircleOutline" Width="15" Height="15" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="New" FontSize="11" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Edit Properties / Rename -->
                            <Button Command="{Binding EditDocumentCommand}" 
                                    CommandParameter="{Binding SelectedTreeNode}"
                                    IsEnabled="{Binding HasSelectedNode}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Height="28" Padding="6,2" Margin="0,0,2,0"
                                    ToolTip="Edit / Rename Selected Document">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Edit" FontSize="11" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Make Default -->
                            <Button Command="{Binding MakeDefaultCommand}" 
                                    CommandParameter="{Binding SelectedTreeNode}"
                                    IsEnabled="{Binding CanMakeDefaultSelection}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Height="28" Padding="6,2" Margin="0,0,2,0"
                                    ToolTip="Set Selected Document as Default Template">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StarOutline" Width="15" Height="15" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Default" FontSize="11" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Delete Document -->
                            <Button Command="{Binding DeleteDocumentCommand}" 
                                    CommandParameter="{Binding SelectedTreeNode}"
                                    IsEnabled="{Binding CanDeleteSelection}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Height="28" Padding="6,2" Margin="0,0,2,0"
                                    ToolTip="Delete Selected Document">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" Foreground="#DC2626" VerticalAlignment="Center" />
                            </Button>

                            <!-- Duplicate Document -->
                            <Button Command="{Binding DuplicateDocumentCommand}" 
                                    CommandParameter="{Binding SelectedTreeNode}"
                                    IsEnabled="{Binding HasSelectedNode}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Height="28" Padding="6,2" Margin="0,0,2,0"
                                    ToolTip="Duplicate Selected Document">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Foreground="#7C3AED" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <!-- Right Toolbar: Refresh -->
                        <Button Grid.Column="1" Command="{Binding RefreshTreeCommand}" 
                                Style="{StaticResource MaterialDesignToolButton}"
                                Width="26" Height="26" Padding="0"
                                ToolTip="Refresh Document List">
                            <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" Foreground="#64748B" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 1: Search / Filter Input -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,5">
                    <Grid>
                        <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Filter documents..."
                                 FontSize="11.5" BorderThickness="0" Padding="24,0,20,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                Click="ClearSearchFilter_Click"
                                Visibility="{Binding SearchFilter, Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Right" Width="18" Height="18" Padding="0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloseCircle" Width="12" Height="12" Foreground="#94A3B8" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 2: TreeView Container -->
                <TreeView Grid.Row="2" 
                          x:Name="DocumentsTreeView"
                          ItemsSource="{Binding TreeRoots}" 
                          BorderThickness="0" 
                          Padding="4"
                          SelectedItemChanged="OnTreeViewSelectedItemChanged"
                          MouseDoubleClick="OnTreeViewMouseDoubleClick">
                    <TreeView.Resources>
                        <!-- Context Menu for Document Tree Nodes -->
                        <ContextMenu x:Key="DocumentNodeContextMenu">
                            <MenuItem Header="Open in Tab" 
                                      Command="{Binding DataContext.OpenDocumentNodeCommand, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="TabPlus" Width="16" Height="16" Foreground="#1976D2" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Open in Detached Window" 
                                      Command="{Binding DataContext.OpenDetachedWindowCommand, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}"
                                      CommandParameter="{Binding DataContext.ActiveDocument, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" Foreground="#0284C7" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Set as Default" 
                                      Command="{Binding DataContext.MakeDefaultCommand, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="StarOutline" Width="16" Height="16" Foreground="#F59E0B" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Edit / Rename..." 
                                      Command="{Binding DataContext.EditDocumentCommand, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="#D97706" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Duplicate" 
                                      Command="{Binding DataContext.DuplicateDocumentCommand, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Foreground="#7C3AED" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Delete" 
                                      Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#DC2626" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>

                        <!-- Template for Root Category Node ("Rig State Documents") -->
                        <HierarchicalDataTemplate DataType="{x:Type viewmodels:RigStateDocumentTreeRootNode}" 
                                                  ItemsSource="{Binding Children}">
                            <Border Padding="4,3" Margin="0,1" CornerRadius="4" Background="#F8FAFC">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Root Icon -->
                                    <materialDesign:PackIcon Grid.Column="0" Kind="ChartTimelineVariant" Width="16" Height="16" 
                                                             Foreground="#512DA8" VerticalAlignment="Center" Margin="0,0,6,0" />

                                    <!-- Root Text -->
                                    <TextBlock Grid.Column="1" Text="{Binding Header}" FontSize="12" FontWeight="Bold" 
                                               Foreground="#1E293B" VerticalAlignment="Center" />

                                    <!-- Document Count Badge -->
                                    <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DocumentCount}" FontSize="10" FontWeight="Bold" Foreground="#475569" />
                                    </Border>
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>

                        <!-- Template for Child Document Nodes -->
                        <DataTemplate DataType="{x:Type viewmodels:RigStateDocumentTreeNode}">
                            <Border Padding="4,3" Margin="0,1" CornerRadius="4" 
                                    ContextMenu="{StaticResource DocumentNodeContextMenu}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon (Star for default, Chart for regular) -->
                                    <materialDesign:PackIcon Grid.Column="0" 
                                                             Kind="{Binding IsDefault, Converter={x:Null}}"
                                                             Width="14" Height="14" 
                                                             VerticalAlignment="Center" Margin="0,0,6,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="FileChartOutline" />
                                                <Setter Property="Foreground" Value="#0284C7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="Kind" Value="Star" />
                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>

                                    <!-- Document Name & Info -->
                                    <TextBlock Grid.Column="1" Text="{Binding DocumentName}" FontSize="11" 
                                               FontWeight="{Binding IsDefault, Converter={x:Null}}" 
                                               Foreground="#1E293B" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Default Tag / Track Count Badge -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <!-- Default Tag -->
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="3" Padding="3,0" Margin="0,0,4,0"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="DEFAULT" FontSize="8.5" FontWeight="Bold" Foreground="#B45309" />
                                        </Border>
                                        <!-- Track Count -->
                                        <TextBlock Text="{Binding TrackCount, StringFormat='({0} trk)'}" FontSize="9.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!-- 3: Bottom Status Footer -->
                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TotalDocumentCount, StringFormat='{}{0} total documents'}" 
                                   FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="DIntel Database" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- COLUMN 1: DRAGGABLE GRIDSPLITTER                                 -->
        <!-- ================================================================= -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                      Background="#E2E8F0" ShowsPreview="True" Cursor="SizeWE" />

        <!-- ================================================================= -->
        <!-- COLUMN 2: RIGHT MULTI-DOCUMENT TABBED CHART WORKSPACE             -->
        <!-- ================================================================= -->
        <Grid Grid.Column="2" Background="#FFFFFF">
            <!-- Active Document Tabs Workspace -->
            <TabControl ItemsSource="{Binding OpenDocuments}" 
                        SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                        ItemTemplate="{StaticResource WorkspaceTabHeaderTemplate}"
                        BorderThickness="0"
                        Background="#FFFFFF"
                        Padding="0"
                        Visibility="{Binding HasOpenDocuments, Converter={StaticResource BoolToVisibilityConverter}}">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Open in Detached Window" 
                                              Command="{Binding DataContext.OpenDetachedWindowCommand, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" Foreground="#0284C7" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Close Tab" 
                                              Command="{Binding DataContext.CloseDocumentTabCommand, RelativeSource={RelativeSource AncestorType=views:RigStateWorkspaceView}}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#DC2626" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Tab Content: Active RigStateDocumentView -->
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <views:RigStateDocumentView DataContext="{Binding}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- Empty State Display (When all tabs are closed) -->
            <Border Visibility="{Binding HasOpenDocuments, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Background="#F8FAFC" Padding="32" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileChartOutline" Width="56" Height="56" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="No Rig State Documents Open" FontSize="18" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Double-click any document in the tree on the left to open it here, or create a new document." 
                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" Margin="0,0,0,20" />
                    <Button Command="{Binding NewDocumentCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#1976D2" Foreground="White"
                            HorizontalAlignment="Center" Height="36" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Create New Document" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
