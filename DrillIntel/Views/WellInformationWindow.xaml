<Window x:Class="DrillIntel.Views.WellInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        d:DataContext="{d:DesignInstance Type=viewmodels:WellInformationViewModel}"
        mc:Ignorable="d"
        Title="Well Information" 
        Width="480" 
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Window.Resources>

    <Border Padding="28">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <materialDesign:PackIcon Kind="Factory" Foreground="#2196F3" Width="30" Height="30" VerticalAlignment="Center" />
                <TextBlock Text="Well Information" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Specify the primary well details for this project." FontSize="13" Foreground="Gray" Margin="0,0,0,24" />

            <!-- Well Name -->
            <TextBox materialDesign:HintAssist.Hint="Well Name *" 
                     Text="{Binding WellName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                     FontSize="15" 
                     Margin="0,0,0,20" 
                     ToolTip="Enter the unique well identifier/name." />

            <!-- Field Name -->
            <TextBox materialDesign:HintAssist.Hint="Field Name" 
                     Text="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                     FontSize="15" 
                     Margin="0,0,0,20" 
                     ToolTip="Enter the field or block name." />

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44336" FontWeight="SemiBold" Margin="0,0,0,16" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" />

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="CANCEL" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Width="100" Margin="0,0,12,0" IsCancel="True" />
                <Button Content="SAVE WELL" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Width="120" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

