<Window x:Class="DrillIntel.Views.WellInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:converters="clr-namespace:DrillIntel.Converters"
        d:DataContext="{d:DesignInstance Type=viewmodels:WellInformationViewModel}"
        mc:Ignorable="d"
        Title="Well Information" 
        Width="920" 
        Height="760"
        MinWidth="750"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,12" Background="#F4F6F9" CornerRadius="8" BorderBrush="#E0E6ED" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="Factory" Foreground="#2196F3" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Well Information" FontSize="20" FontWeight="Bold" Foreground="#1976D2" />
                    <TextBlock Text="Edit well-level attributes and parameters." FontSize="12.5" Foreground="#616161" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
                <!-- Group 1: General Identification -->
                <TextBlock Text="General Identification" FontSize="14.5" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,12" />

                <!-- Row 1: Well Name & Legal Name -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Well Name *" 
                             Text="{Binding WellName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Enter the unique well identifier/name (Mandatory)." />
                    <TextBox Grid.Column="2" 
                             materialDesign:HintAssist.Hint="Legal Name" 
                             Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Full registered legal name." />
                </Grid>

                <!-- Row 2: Field & Operator -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Field Name" 
                             Text="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Field or project designation." />
                    <TextBox Grid.Column="2" 
                             materialDesign:HintAssist.Hint="Operator Name" 
                             Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Operating company name." />
                </Grid>

                <!-- Row 3: Status, Purpose & UWI -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Status" 
                             Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Well operational status (e.g. Active, Drilling)." />
                    <TextBox Grid.Column="2" 
                             materialDesign:HintAssist.Hint="Purpose" 
                             Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Well purpose (e.g. Development, Exploration)." />
                    <TextBox Grid.Column="4" 
                             materialDesign:HintAssist.Hint="UWI / API No." 
                             Text="{Binding Uwi, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Unique Well Identifier or API license number." />
                </Grid>

                <!-- Row 4: Rig Name, Spud Date & License No -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Rig Name" 
                             Text="{Binding RigName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Name or number of drilling rig." />
                    <TextBox Grid.Column="2" 
                             materialDesign:HintAssist.Hint="Spud Date" 
                             Text="{Binding SpudDate, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Spud date (e.g. DD-MMM-YYYY)." />
                    <TextBox Grid.Column="4" 
                             materialDesign:HintAssist.Hint="License No." 
                             Text="{Binding LicenseNo, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" 
                             ToolTip="Government or regulatory license number." />
                </Grid>

                <!-- Group 2: Geographic & Regional -->
                <Separator Margin="0,0,0,16" />
                <TextBlock Text="Geographic &amp; Regional Info" FontSize="14.5" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,12" />

                <!-- Row 1: Country, State & County -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Country" 
                             Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                    <TextBox Grid.Column="2" 
                             materialDesign:HintAssist.Hint="State / Province" 
                             Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                    <TextBox Grid.Column="4" 
                             materialDesign:HintAssist.Hint="County / Parish" 
                             Text="{Binding County, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                </Grid>

                <!-- Row 2: Block, District, Region, Time Zone -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Block" 
                             Text="{Binding Block, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                    <TextBox Grid.Column="2" 
                             materialDesign:HintAssist.Hint="District" 
                             Text="{Binding District, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                    <TextBox Grid.Column="4" 
                             materialDesign:HintAssist.Hint="Region" 
                             Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                    <TextBox Grid.Column="6" 
                             materialDesign:HintAssist.Hint="Time Zone" 
                             Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                </Grid>

                <!-- Group 3: Elevations & Water Depth -->
                <Separator Margin="0,0,0,16" />
                <TextBlock Text="Elevations &amp; Water Depth" FontSize="14.5" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Wellhead Elevation" 
                             Text="{Binding WellheadElevation, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                    <TextBox Grid.Column="2" 
                             materialDesign:HintAssist.Hint="Ground Elevation" 
                             Text="{Binding GroundElevation, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                    <TextBox Grid.Column="4" 
                             materialDesign:HintAssist.Hint="Water Depth" 
                             Text="{Binding WaterDepth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="14" />
                </Grid>

                <!-- Group 4: Comments -->
                <Separator Margin="0,0,0,16" />
                <TextBlock Text="Comments &amp; Remarks" FontSize="14.5" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,12" />

                <TextBox materialDesign:HintAssist.Hint="Comments" 
                         Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         FontSize="14" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto"
                         Height="95" 
                         Margin="0,0,0,16" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44336" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Width="110" Height="36" Margin="0,0,12,0" IsCancel="True" />
                    <Button Content="SAVE WELL" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Width="140" Height="36" IsDefault="True" IsEnabled="{Binding CanSave}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

