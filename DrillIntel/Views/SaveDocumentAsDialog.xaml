<Window x:Class="DrillIntel.Views.SaveDocumentAsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:conv="clr-namespace:DrillIntel.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:SaveDocumentAsViewModel}"
        Title="{Binding Title, FallbackValue='Save Rig State Document'}"
        Width="480" Height="360"
        MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <!-- Converters -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Field Label Style -->
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Form Input Style -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: Form Body -->
            <RowDefinition Height="*" />
            <!-- 2: Action Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="8" Background="#EEF2FF" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#1E1B4B" />
                    <TextBlock Text="Save this layout configuration to the project database." FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <!-- Document Name -->
            <TextBlock Text="Document Name *" Style="{StaticResource InputLabel}" />
            <TextBox Text="{Binding DocumentName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource FormTextBox}"
                     materialDesign:HintAssist.Hint="e.g. Drilling Overview, Tripping Analysis" />

            <!-- Description -->
            <TextBlock Text="Description (Optional)" Style="{StaticResource InputLabel}" Margin="0,12,0,5" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource FormTextBox}"
                     Height="56"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     materialDesign:HintAssist.Hint="Brief notes or description..." />

            <!-- Default Checkbox -->
            <CheckBox IsChecked="{Binding IsDefault}" 
                      Margin="0,14,0,0" 
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Set as default document for this project" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                    <materialDesign:PackIcon Kind="StarOutline" Width="14" Height="14" Foreground="#F59E0B" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </CheckBox>

            <!-- Error Banner -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,10,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#DC2626" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelCommand}" 
                        Content="Cancel" 
                        Width="84" Height="32" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        BorderBrush="#CBD5E1" Foreground="#475569" 
                        FontSize="11.5" Margin="0,0,8,0" />

                <Button Command="{Binding SaveCommand}" 
                        Content="Save Document" 
                        Height="32" Padding="14,0"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#4F46E5" Foreground="White" 
                        FontSize="11.5" FontWeight="SemiBold">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#4F46E5" />
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

