<Window x:Class="DrillIntel.Views.RigStateDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrillIntel.Views"
        mc:Ignorable="d"
        Title="{Binding DocumentTitle, FallbackValue='Rig State Document'}" 
        Height="850" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <local:RigStateDocumentView />
    </Grid>
</Window>

