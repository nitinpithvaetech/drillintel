<UserControl x:Class="DrillIntel.Views.RigStateDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:teechart="clr-namespace:Steema.TeeChart.WPF;assembly=TeeChart.Business.WPF"
             xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
             xmlns:controls="clr-namespace:DrillIntel.Controls"
             xmlns:converters="clr-namespace:DrillIntel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:RigStateDocumentViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesignPaper}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <Style x:Key="BarLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1: TeeChart Canvas -->
            <RowDefinition Height="*" />
            <!-- 2: Navigation & Range Filter Command Bar (Above dataSelector TrackBar) -->
            <RowDefinition Height="Auto" />
            <!-- 3: Data Selector Range TrackBar Scroller -->
            <RowDefinition Height="Auto" />
            <!-- 4: Status & Telemetry Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner: Matching RecalculateRigStateWindow & Other Views -->
        <Border Grid.Row="0" Background="#F4F3F8" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0" Kind="ChartTimelineVariant" Width="32" Height="32" Foreground="#512DA8" VerticalAlignment="Center" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="#512DA8" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding DocumentName}" 
                                   FontSize="14" FontWeight="Bold" Foreground="#311B92"
                                   VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                        
                        <TextBlock Text="*" Foreground="#D32F2F" FontWeight="Bold" FontSize="14" Margin="2,0,8,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   ToolTip="Unsaved changes in document layout" />

                        <!-- Document Management Actions -->
                        <Button Command="{Binding SaveDocumentCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="26" Padding="6,0" Margin="0,0,4,0"
                                ToolTip="Save Document Layout (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBlock Text="Save" FontSize="10.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveAsDocumentCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="26" Padding="6,0" Margin="0,0,4,0"
                                ToolTip="Save As New Document Template...">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSavePlusOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBlock Text="Save As" FontSize="10.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Well: " FontWeight="SemiBold" Foreground="#616161" FontSize="11" />
                        <TextBlock Text="{Binding WellName, FallbackValue='(None)'}" FontWeight="Bold" Foreground="#212121" FontSize="11" Margin="0,0,14,0" />
                        <TextBlock Text="Log: " FontWeight="SemiBold" Foreground="#616161" FontSize="11" />
                        <TextBlock Text="{Binding LogName, FallbackValue='(None)'}" FontWeight="Bold" Foreground="#212121" FontSize="11" Margin="0,0,14,0" />
                        <TextBlock Text="Samples: " FontWeight="SemiBold" Foreground="#616161" FontSize="11" />
                        <TextBlock Text="{Binding LoadedPointsCount, StringFormat='{}{0:N0}'}" Foreground="#388E3C" FontWeight="Bold" FontSize="11" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#757575" FontSize="11" FontStyle="Italic" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddChannelCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#512DA8" Foreground="White"
                            Height="32" Padding="10,0" Margin="0,0,8,0"
                            ToolTip="Add Curve to Chart">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Add Channel" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                                        <Button Command="{Binding OpenDataSelectorCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="32" Padding="10,0" Margin="0,0,8,0"
                            ToolTip="Open Data Selector &amp; Field Mapping Window">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TableCog" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Data Selector" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenTrackPropertiesCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="32" Padding="10,0" Margin="0,0,8,0"
                            ToolTip="Configure Track Columns and Axis Properties">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TuneVariant" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Tracks &amp; Axes" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleOrientationCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="32" Padding="10,0" Margin="0,0,8,0"
                            ToolTip="Toggle Track Orientation (Vertical / Horizontal)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding OrientationIcon}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding OrientationText}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>


                    <Button Command="{Binding ResetZoomCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="32" Padding="8,0"
                            ToolTip="Reset Zoom to Full Extents">
                        <materialDesign:PackIcon Kind="FitToScreenOutline" Width="16" Height="16" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: TeeChart WPF Canvas with Interactive Hover Tooltip Overlay -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" ClipToBounds="True">
            <Grid x:Name="ChartContainer">
                <teechart:TChart x:Name="ChartControl" />

                <!-- Floating Mouse-Pointer Tooltip Overlay -->
                <Canvas x:Name="TooltipCanvas" IsHitTestVisible="False">
                    <Border x:Name="SeriesTooltipCard" 
                            Visibility="Collapsed"
                            Background="#1E293B" 
                            BorderBrush="#475569" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="10,8" 
                            MinWidth="160" MaxWidth="280">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.4" Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <!-- Series Header & Channel Color Dot -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="TooltipSeriesBullet" Grid.Column="0" Width="10" Height="10" Fill="#1976D2" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="TooltipSeriesTitle" Grid.Column="1" Text="Channel" FontWeight="Bold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock x:Name="TooltipTrackTitle" Grid.Column="2" Text="Track" FontSize="10" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Curve Value & Unit -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <TextBlock x:Name="TooltipValueText" Text="0.00" FontSize="16" FontWeight="ExtraBold" Foreground="#38BDF8" />
                                <TextBlock x:Name="TooltipUnitText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="3,0,0,2" />
                            </StackPanel>

                            <!-- Index: Date/Time or Depth -->
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,3">
                                <materialDesign:PackIcon x:Name="TooltipIndexIcon" Kind="ClockOutline" Width="12" Height="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock x:Name="TooltipIndexText" Text="--" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Rig State Badge (shown when rig state is active) -->
                            <Border x:Name="TooltipRigStateBadge" Background="#4CAF50" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Rig State: " FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock x:Name="TooltipRigStateText" Text="Rotary Drill" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- 2: Navigation & Date Range Control Bar (Above dataSelector TrackBar) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" Padding="10,6" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Preset Dropdown -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Preset Range:" Style="{StaticResource BarLabel}" />
                    <ComboBox ItemsSource="{Binding RangePresets}" 
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              Width="130" Height="28" VerticalContentAlignment="Center" FontSize="11" />
                </StackPanel>

                <!-- Center/Right: From - To Single Text DateTime Boxes & Apply Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- TimeLog Controls: Single Text DateTime Boxes -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTimeLog, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="From:" Style="{StaticResource BarLabel}" Margin="12,0,4,0" />
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBox Text="{Binding FromDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     BorderThickness="0" Background="Transparent"
                                     Width="135" Height="24" FontSize="11" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     ToolTip="Enter Start Date &amp; Time (dd-MM-yyyy HH:mm)" />
                        </Border>

                        <TextBlock Text="To:" Style="{StaticResource BarLabel}" Margin="12,0,4,0" />
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBox Text="{Binding ToDateTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     BorderThickness="0" Background="Transparent"
                                     Width="135" Height="24" FontSize="11" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     ToolTip="Enter End Date &amp; Time (dd-MM-yyyy HH:mm)" />
                        </Border>
                    </StackPanel>

                    <!-- DepthLog Controls -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTimeLog, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="From Depth:" Style="{StaticResource BarLabel}" Margin="12,0,4,0" />
                        <TextBox Text="{Binding FromDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="28" FontSize="11" VerticalContentAlignment="Center" />
                        <TextBlock Text="To Depth:" Style="{StaticResource BarLabel}" Margin="12,0,4,0" />
                        <TextBox Text="{Binding ToDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="28" FontSize="11" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <Button Command="{Binding RefreshDataCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#1976D2" Foreground="White"
                            Height="28" Padding="14,0" Margin="10,0,0,0"
                            ToolTip="Query and refresh chart for this window">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Apply" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3: Data Selector Range TrackBar Scroller (Plug & Play UserControl) -->
        <controls:RangeTrackBarControl Grid.Row="3" Margin="0,4,0,4"
                                      Minimum="{Binding TrackBarMin}"
                                      Maximum="{Binding TrackBarMax}"
                                      SelectionStart="{Binding TrackBarSelectionStart, Mode=TwoWay}"
                                      SelectionEnd="{Binding TrackBarSelectionEnd, Mode=TwoWay}"
                                      IsTimeLog="{Binding IsTimeLog}"
                                      OverviewPoints="{Binding TrackBarOverviewPoints}"
                                      OverviewChannelName="{Binding TrackBarOverviewChannelName}"
                                      OverviewStroke="{Binding TrackBarOverviewBrush}"
                                      RangeChanged="OnRangeTrackBarChanged" />

        <!-- Bottom Industrial Status & Rig State Bar -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Cursor Index -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CrosshairsGps" Width="16" Height="16" Foreground="#512DA8" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Cursor: " FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock Text="{Binding CursorIndexText}" FontSize="11" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,16,0" />
                </StackPanel>

                <!-- Center: Active Rig State Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Current Rig State: " FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                    <Border Background="{Binding CursorRigStateColorHex}" CornerRadius="3" Padding="8,2" Margin="4,0,0,0">
                        <TextBlock Text="{Binding CursorRigStateText}" FontSize="11" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Right: Renderer Engine info -->
                <TextBlock Grid.Column="2" Text="TeeChart WPF • VHTrackConsole Engine" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

