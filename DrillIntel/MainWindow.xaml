<Fluent:RibbonWindow x:Class="DrillIntel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrillIntel"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:Fluent="urn:fluent-ribbon"
        xmlns:viewmodels="clr-namespace:DrillIntel.ViewModels"
        xmlns:models="clr-namespace:DrillIntel.Models"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="{Binding WindowTitle, FallbackValue='DrillIntel — The rig\'s second brain — drill smarter, not harder'}"
        WindowState="Maximized"
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/DrillIntel;component/Assets/app_icon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ribbon Menu -->
        <Fluent:Ribbon Grid.Row="0">

            <!-- Project Tab -->
            <Fluent:RibbonTabItem Header="Project">
                <Fluent:RibbonGroupBox Header="Project Actions">
                    
                    <Fluent:Button Header="New Project" Command="{Binding NewProjectCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="FolderPlus" Foreground="#4CAF50" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Load Project" Command="{Binding LoadProjectCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="FolderOpen" Foreground="#FF9800" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>

                    <Fluent:Button Header="Edit Well" 
                                   Command="{Binding OpenWellEditorCommand}" 
                                   IsEnabled="{Binding IsProjectOpen}"
                                   ToolTip="Edit Well Information">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="Edit" Foreground="#4CAF50" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon> 
                    </Fluent:Button>


                    <Fluent:DropDownButton Header="Recent" ToolTip="Open a recently used project" ItemsSource="{Binding RecentProjects}">
                        <Fluent:DropDownButton.LargeIcon>
                            <materialDesign:PackIcon Kind="History" Foreground="#2196F3" Width="32" Height="32" />
                        </Fluent:DropDownButton.LargeIcon>
                        <Fluent:DropDownButton.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RecentProject}">
                                <Fluent:MenuItem Header="{Binding ProjectName}"
                                                 ToolTip="{Binding FilePath}"
                                                 Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Fluent:RibbonWindow}}"
                                                 CommandParameter="{Binding}">
                                    <Fluent:MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Database" Width="16" Height="16" Foreground="#673AB7" />
                                    </Fluent:MenuItem.Icon>
                                </Fluent:MenuItem>
                            </DataTemplate>
                        </Fluent:DropDownButton.ItemTemplate>
                    </Fluent:DropDownButton>
                    <Fluent:Button Header="Close Project" 
                                   Command="{Binding CloseProjectCommand}"
                                   IsEnabled="{Binding IsProjectOpen}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="FolderRemove" Foreground="#E91E63" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Navigation" IsEnabled="{Binding IsProjectOpen}">
                    <Fluent:Button Header="Dashboard" Command="{Binding NavigateToDashboardCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="ViewDashboard" Foreground="#2196F3" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Recent Wells">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="History" Foreground="#607D8B" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Status" IsEnabled="{Binding IsProjectOpen}">
                    <Fluent:Button Header="QC Status">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="CheckAll" Foreground="#4CAF50" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- Data Import Tab -->
            <Fluent:RibbonTabItem Header="Data Import" IsEnabled="{Binding IsProjectOpen}">
                <Fluent:RibbonGroupBox Header="Import">
                    <Fluent:Button Header="Import Timelog" Command="{Binding NavigateToImportTimelogCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="FileClockOutline" Foreground="#FF9800" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Import Depthlog" Command="{Binding NavigateToImportDepthlogCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="FormatVerticalAlignBottom" Foreground="#FF9800" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- Data QC Tab -->
            <Fluent:RibbonTabItem Header="QC" IsEnabled="{Binding IsProjectOpen}">
                <Fluent:RibbonGroupBox Header="Operations">
                    <Fluent:Button Header="Run QC">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Foreground="#F44336" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Reports">
                    <Fluent:Button Header="QC Reports">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Foreground="#9C27B0" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- Data Processing Tab -->
            <Fluent:RibbonTabItem Header="Processing" IsEnabled="{Binding IsProjectOpen}">
                <Fluent:RibbonGroupBox Header="Algorithms">
                    <Fluent:Button Header="Identify Rig States" Command="{Binding IdentifyRigStatesCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="RobotOutline" Foreground="#00BCD4" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Generate KPIs">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="ChartLine" Foreground="#3F51B5" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Rig State">
                    <Fluent:SplitButton Header="Rig State Workspace" 
                                        Command="{Binding OpenRigStateDocumentCommand}" 
                                        ToolTip="Open the Rig State Document Workspace (TreeView + Multi-Tab Chart view).">
                        <Fluent:SplitButton.LargeIcon>
                            <materialDesign:PackIcon Kind="ChartTimelineVariant" Foreground="#673AB7" Width="32" Height="32" />
                        </Fluent:SplitButton.LargeIcon>
                        <Fluent:MenuItem Header="Open Workspace" Command="{Binding OpenRigStateDocumentCommand}">
                            <Fluent:MenuItem.Icon>
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Foreground="#673AB7" Width="16" Height="16" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="New Document..." Command="{Binding NewRigStateDocumentCommand}">
                            <Fluent:MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FilePlusOutline" Foreground="#00796B" Width="16" Height="16" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Manage Documents (Tree)..." Command="{Binding ManageRigStateDocumentsCommand}">
                            <Fluent:MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FileTree" Foreground="#512DA8" Width="16" Height="16" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                    </Fluent:SplitButton>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Functions">
                    <Fluent:DropDownButton Header="Functions" 
                                           ToolTip="Processing Functions">
                        <Fluent:DropDownButton.LargeIcon>
                            <materialDesign:PackIcon Kind="Function" Foreground="#FF9800" Width="32" Height="32" />
                        </Fluent:DropDownButton.LargeIcon>
                        <Fluent:DropDownButton.Icon>
                            <materialDesign:PackIcon Kind="Function" Foreground="#FF9800" Width="16" Height="16" />
                        </Fluent:DropDownButton.Icon>
                        <Fluent:MenuItem Header="Sync data to Parent Timelog" 
                                         Command="{Binding SyncDataToParentTimelogCommand}"
                                         IsEnabled="{Binding CanSyncDataToParentTimelog}"
                                         ToolTip="Synchronize data to Parent Timelog (Requires a Timelog properly linked with another Timelog in Tab-3)">
                            <Fluent:MenuItem.Icon>
                                <materialDesign:PackIcon Kind="Sync" Foreground="#0284C7" Width="16" Height="16" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                    </Fluent:DropDownButton>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- Reports Tab -->
            <Fluent:RibbonTabItem Header="Reports" IsEnabled="{Binding IsProjectOpen}">
                <Fluent:RibbonGroupBox Header="Drilling">
                    <Fluent:Button Header="Drilling Summary">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Foreground="#9C27B0" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Trip-In Summary">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="ArrowDownBoldBoxOutline" Foreground="#9C27B0" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Connection Summary">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="LinkVariant" Foreground="#9C27B0" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Plots">
                    <Fluent:Button Header="Broomstick Plot">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="Broom" Foreground="#795548" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Manage Plans" Command="{Binding OpenBroomstickManagePlanCommand}" ToolTip="Manage and import Broomstick Hookload &amp; Torque plans (CSV/Excel)">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="Hook" Foreground="#10B981" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            
            <!-- Masters Tab -->
            <Fluent:RibbonTabItem Header="Setup">
                <Fluent:RibbonGroupBox Header="Global Configuration">
                    <Fluent:Button Header="Unit Dictionary" Command="{Binding OpenUnitMasterCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="RulerSquareCompass" Foreground="#3F51B5" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Unit Conversion" Command="{Binding OpenUnitConversionCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="SwapHorizontalCircleOutline" Foreground="#00897B" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Rig State Setup" Command="{Binding OpenGlobalRigStateMasterCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="CogSyncOutline" Foreground="#673AB7" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Broomstick Settings" Command="{Binding OpenGlobalBroomstickSettingsCommand}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="TuneVariant" Foreground="#607D8B" Width="32" Height="32" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Project Configuration">
                    <Fluent:Button Header="Rig State Setup" Command="{Binding OpenProjectRigStateMasterCommand}" IsEnabled="{Binding IsProjectOpen}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="CogSyncOutline" Width="32" Height="32">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="#9E9E9E" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsProjectOpen, RelativeSource={RelativeSource AncestorType=Fluent:RibbonWindow}}" Value="True">
                                                <Setter Property="Foreground" Value="#00BCD4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Broomstick Settings" Command="{Binding OpenProjectBroomstickSettingsCommand}" IsEnabled="{Binding IsProjectOpen}">
                        <Fluent:Button.LargeIcon>
                            <materialDesign:PackIcon Kind="TuneVariant" Width="32" Height="32">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="#9E9E9E" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsProjectOpen, RelativeSource={RelativeSource AncestorType=Fluent:RibbonWindow}}" Value="True">
                                                <Setter Property="Foreground" Value="#607D8B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>


            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <!-- Main Content Area bounded to CurrentViewModel -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />

        <!-- Bottom Industrial Status & Branding Bar -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Left: Status & Active Project -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#4CAF50" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="System Ready" FontSize="11" Foreground="#616161" VerticalAlignment="Center" />
                    <TextBlock Text="|" Foreground="#BDBDBD" Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Session.ProjectName, StringFormat='Project: {0}', FallbackValue='No Project Open'}" FontSize="11" FontWeight="Medium" Foreground="#424242" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Marketing & Industrial Tagline -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Brain" Foreground="#1976D2" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="The rig's second brain — drill smarter, not harder" FontSize="12" FontWeight="SemiBold" Foreground="#1976D2" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Platform Info -->
                <TextBlock Grid.Column="2" Text="DrillIntel v1.0 • VuMax Architecture" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Fluent:RibbonWindow>
